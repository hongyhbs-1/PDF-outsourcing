{# ---------------------------------------------------------------------------
  Page 2: Tutoring Execution and Tracking Blueprint
  Required context key: execution_blueprint
--------------------------------------------------------------------------- #}
{% set bp = execution_blueprint %}
<section class="m0-module-page learning-blueprint-page execution-blueprint-page">
  <div class="edge-tabs-mask"></div>
  <header class="lb-header compact">
    <div class="lb-page-label">{{ bp.meta.page2_label }}</div>
    <div class="lb-meta-line">{{ bp.meta.student_name }} ｜ {{ bp.meta.grade }} ｜ {{ bp.meta.subject_name }} ｜ {{ bp.meta.report_title }} ｜ 目标 {{ bp.meta.target_score_text }}</div>
    <h1>{{ bp.headline.title }}</h1>
    <div class="lb-subtitle"><span></span>{{ bp.headline.subtitle }}<span></span></div>
    <div class="lb-banner">{{ bp.headline.slogan }}</div>
  </header>

  <main class="execution-grid">
    <section class="lb-panel exec-panel drill-structure-panel">
      <h2><b>05</b> 知识点钻取结构 <small>能力树</small></h2>
      <p class="panel-lead">从领域到考点逐层定位，精准找到需要补强的知识点。</p>
      <div class="drill-head wide"><span>L1 六大领域</span><i></i><span>L2 知识模块</span><i></i><span>L3 知识点</span><i></i><span>L4 考点细节</span></div>
      <div class="focus-paths">
        {% for row in bp.focus_paths %}
        <div class="focus-row state-{{ row.state }}">
          <span>{{ row.domain }}</span><i></i>
          <span>{{ row.l2 }}</span><i></i>
          <span>{{ row.l3 }}</span><i></i>
          <span class="last">{{ row.l4 }}</span>
        </div>
        {% endfor %}
      </div>
      <div class="state-legend compact-legend">
        <span class="dot nodata">未测：数据不足</span><span class="dot need_test">待补测：有待验证</span><span class="dot improve">需加强：存在薄弱</span>
      </div>
    </section>

    <section class="lb-panel exec-panel improvement-path-panel">
      <h2><b>06</b> 提分路径图 <small>{{ bp.stage_plan.current_text }} → {{ bp.stage_plan.target_text }}</small></h2>
      <p class="panel-lead">分阶段提升，稳步达成目标。</p>
      <div class="stage-flow">
        {% for stage in bp.stage_plan.stages %}
        <div class="exec-stage stage-{{ stage.state }}">
          <div class="stage-icon">{{ loop.index }}</div>
          <strong>{{ stage.range }}</strong>
          <em>{{ stage.title }}</em>
          <span>{{ stage.target_text }}</span>
        </div>
        {% if not loop.last %}<div class="stage-flow-arrow"></div>{% endif %}
        {% endfor %}
      </div>
      <div class="stage-details">
        {% for stage in bp.stage_plan.stages %}
        <div class="stage-detail stage-{{ stage.state }}">
          <h3>{{ stage.no }}</h3>
          <ul>{% for text in stage["items"] %}<li>{{ text }}</li>{% endfor %}</ul>
        </div>
        {% endfor %}
      </div>
      <div class="path-note">根据学习进度与检测结果动态调整路径，确保每一步都有明确目标。</div>
    </section>

    <section class="lb-panel exec-panel data-engine-panel">
      <h2><b>07</b> 数据分析引擎 <small>AI数据驾驶舱</small></h2>
      <p class="panel-lead">多维数据融合分析，驱动科学决策。</p>
      <div class="data-engine-cards">
        <div><strong>{{ bp.data_engine.paper_count }}</strong><span>分析试卷</span></div>
        <div><strong>{{ bp.data_engine.valid_questions }}</strong><span>有效大题</span></div>
        <div><strong>{{ bp.data_engine.domain_modules }}</strong><span>领域模块</span></div>
        <div><strong>{{ bp.data_engine.reliability_level }}</strong><span>数据可信度</span><em>{% for i in range(bp.data_engine.stars) %}★{% endfor %}</em></div>
      </div>
      <div class="pipeline-flow">
        {% for step in bp.data_engine.pipeline %}
        <span>{{ step }}</span>{% if not loop.last %}<i></i>{% endif %}
        {% endfor %}
      </div>
      <div class="engine-source">{{ bp.data_engine.source_text }}</div>
    </section>

    <section class="lb-panel exec-panel support-system-panel">
      <h2><b>08</b> 学习支持系统 <small>协同成长</small></h2>
      <p class="panel-lead">家长、老师、学生三方协同，全程陪伴孩子进步。</p>
      <div class="support-triangle">
        <svg viewBox="0 0 440 300" role="img" aria-label="老师家长学生三方协同">
          <defs>
            <marker id="arrowHead" markerWidth="8" markerHeight="8" refX="5" refY="3" orient="auto">
              <path d="M0,0 L0,6 L6,3 z" />
            </marker>
          </defs>
          <line x1="220" y1="68" x2="92" y2="230" />
          <line x1="220" y1="68" x2="348" y2="230" />
          <line x1="92" y1="230" x2="348" y2="230" />
          <g class="role-node teacher" transform="translate(220,62)"><circle r="43"/><text y="6">老师</text></g>
          <g class="role-node parent" transform="translate(92,230)"><circle r="43"/><text y="6">家长</text></g>
          <g class="role-node student" transform="translate(348,230)"><circle r="43"/><text y="6">学生</text></g>
          <g class="center-node" transform="translate(220,178)"><circle r="34"/><text y="5">共同成长</text></g>
        </svg>
        <div class="support-notes teacher-notes"><ul>{% for item in bp.support_system.teacher_items %}<li>{{ item }}</li>{% endfor %}</ul></div>
        <div class="support-notes parent-notes"><ul>{% for item in bp.support_system.parent_items %}<li>{{ item }}</li>{% endfor %}</ul></div>
        <div class="support-notes student-notes"><ul>{% for item in bp.support_system.student_items %}<li>{{ item }}</li>{% endfor %}</ul></div>
      </div>
      <div class="support-summary">{{ bp.support_system.summary }}</div>
    </section>

    <section class="lb-panel execution-axis-panel">
      <h2>执行中轴线：从数据到成长的闭环</h2>
      <div class="axis-flow">
        {% for stage in bp.axis.stages %}
        <div class="axis-stage {% if stage.name == bp.axis.active_stage %}active{% endif %}">
          <div class="axis-icon icon-{{ stage.icon }}"></div>
          <strong>{{ stage.name }}</strong>
          <span>{{ stage.desc }}</span>
        </div>
        {% if not loop.last %}<i class="axis-arrow"></i>{% endif %}
        {% endfor %}
      </div>
      <div class="axis-note">闭环驱动，持续优化，让每一次努力都看得见进步。</div>
    </section>
  </main>

  <footer class="lb-footer execution-footer">
    <span>{{ bp.footer.left }}</span><span>{{ bp.footer.right }}</span>
  </footer>
</section>
