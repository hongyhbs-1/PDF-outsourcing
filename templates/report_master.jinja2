<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
  {{ combined_css | safe }}
  </style>
</head>
{% set _report_subject = meta.subject | default('', true) | lower %}
{% set _report_subject_name = meta.subject_name | default('', true) %}
{% set _is_english_report = _report_subject == 'english' or '英语' in _report_subject_name %}
{% set _body_classes = [] %}
{% if _is_english_report %}{% set _body_classes = _body_classes + ['report-theme--english'] %}{% endif %}
{% if typography_theme == 'word_reference' %}{% set _body_classes = _body_classes + ['word-reference-typography'] %}{% endif %}
<body{% if _body_classes %} class="{{ _body_classes | join(' ') }}"{% endif %}>
{% set _report_variant = report_variant | default('parent', true) %}
{% set _is_admissions_blueprint = _report_variant == 'admissions_blueprint' %}
{% set _include_learning_blueprint = _is_admissions_blueprint or _report_variant == 'full' %}
{% set _include_parent_report = not _is_admissions_blueprint %}
{% set pv = page_visibility | default({}, true) %}

{% set _comp_page = composition_deep | default({}, true) %}
{% set _m10_page = m10 | default({}, true) %}
{% set _comp_facts_page = composition_facts | default({}, true) %}
{% set _comp_items_page = _comp_facts_page.get('items', []) if _comp_facts_page is mapping else [] %}
{% set _comp_rules_page = composition_rules | default({}, true) %}
{% set _selected_essay_info = _comp_rules_page.get('selected_essay', {}) | default({}, true) %}
{% set _essay_selected_flag = _selected_essay_info.get('selected', none) %}
{% set _essay_active = (_essay_selected_flag is none) or (_essay_selected_flag == true) %}
{% set _has_m10_data = _essay_active and (_m10_page.visible | default(false) or (_comp_page.score_overview | default({}, false) | length > 0) or (_comp_page.topic_analysis | default('', false) | length > 0) or _comp_page.data_ready | default(false) or (_comp_items_page | length > 0)) %}
{% set _show_m10_composition = pv.m10_composition | default(false) %}

{% set _rd_page = reading_deep | default({}, true) %}
{% set _m11_page = m11 | default({}, true) %}
{% set _reading_facts_page = reading_passage_facts | default({}, true) %}
{% set _reading_passages_page = _reading_facts_page.passages | default([], true) %}
{% set _has_m11_data = _m11_page.visible | default(false) or (_rd_page.status | default('', false) == 'success') or (_rd_page.content | default({}, false) | length > 0) or (_rd_page.result | default({}, false) | length > 0) or (_reading_passages_page | length > 0) %}
{% set _show_m11_reading_deep = pv.m11_reading_deep | default(false) %}
{% set _show_english_teacher_note = _is_english_report and (_has_m10_data or _has_m11_data) and not (_show_m10_composition or _show_m11_reading_deep) %}

{# ---- 英语进阶挑战建议 (facts.extensions.english_progression_fr2) ---- #}
{% set _fr2_ext = facts.extensions | default({}, true) if facts is defined else {} %}
{% set _english_progression_fr2 = english_progression_fr2 | default(_fr2_ext.english_progression_fr2 | default({}, true), true) %}
{% set _has_english_progression = _is_english_report and (_english_progression_fr2.rows | default([], true) | length > 0) %}

  {# ---- 页眉页脚已迁移至 Playwright headerTemplate/footerTemplate (T14 Phase 6) ---- #}

  {% if _include_parent_report %}
  {# ---- M0: cover ---- #}
  <div class="module-page module-page--cover">
    {% include 'pages/m0_cover.jinja2' %}
  </div>
  {# ---- 补短冲刺方案 (封面后, 正文前, 无序号) ---- #}
  {% if remediation_plan %}
  <div class="module-page" data-section-key="remediation_plan">
    {% include 'pages/m_remediation_plan.jinja2' %}
  </div>
  {% endif %}
  {% endif %}
  {% if _include_learning_blueprint %}
  {# ---- 学习蓝图第 1 页: 学生学情诊断全景 ---- #}
  {% include 'pages/m00_student_diagnostic_blueprint.jinja2' %}
  {# ---- 学习蓝图第 2 页: 补习执行与追踪 ---- #}
  {% include 'pages/m01_tutoring_execution_blueprint.jinja2' %}
  {% endif %}
  {% if _include_parent_report %}
  {# ---- 学生画像分析 (第 4 页: 三档分类 + 劣势 + 机构帮助) ---- #}
  <div class="module-page" id="toc-student-profile">
    {% include 'pages/student_profile.jinja2' %}
  </div>
  {# ---- 提升预期 (第 5 页: 提升路径 + 里程碑 + 关键提升点) ---- #}
  <div class="module-page" id="toc-improvement-preview">
    {% include 'pages/improvement_preview.jinja2' %}
  </div>
  {# ---- 数据分析概览 (封面后, 正文前, 无序号) ---- #}
  <div class="module-page">
    {% include 'pages/m_overview.jinja2' %}
  </div>
  {# ---- 目录 (框架页, 无序号) ---- #}
  <div class="module-page">
    {% include 'pages/m_toc.jinja2' %}
  </div>
  {# ---- M1: summary ---- #}
  <div class="module-page" id="toc-m1">
    {% include 'pages/m1_summary.jinja2' %}
  </div>
  {# ---- M4: domains ---- #}
  <div class="module-page" id="toc-m4">
    {% include 'pages/m4_domains.jinja2' %}
  </div>
  {# ---- M2: core_weakness ---- #}
  <div class="module-page" id="toc-m2">
    {% include 'pages/m2_core_weakness.jinja2' %}
  </div>
  {# ---- M3: kp_drill ---- #}
  <div class="module-page" id="toc-m3">
    {% include 'pages/m3_kp_drill.jinja2' %}
  </div>

  {# ---- M5: city_compare (page_visibility 控制) ---- #}
  {% if pv.m5_city_compare | default(true) %}
  <div class="module-page" id="toc-m5">
    {% include 'pages/m5_city_compare.jinja2' %}
  </div>
  {% endif %}
  {# ---- M6: tiered_learning ---- #}
  <div class="module-page" id="toc-m6">
    {% include 'pages/m6_tiered_learning.jinja2' %}
  </div>
  {# ---- M9: question_detail (only render when data exists) ---- #}
  {% set _qd = question_detail | default({}, true) %}
  {% set _qd_papers = _qd.papers | default([], true) %}
  {% set _qd_total = _qd.total_count | default(0) %}
  {% set _show_question_detail = _qd_papers | length > 0 and _qd_total > 0 %}
  {% set _m9_split = _m9_split_pages | default([], true) %}
  {% if _show_question_detail %}
  {% if _m9_split | length > 0 %}
  {# M9 split mode: 子模板自输出多个 module-page #}
  {% include 'pages/m9_question_detail.jinja2' %}
  {% else %}
  {# M9 non-split: report_master 统一包裹 module-page #}
  <div class="module-page" id="toc-m9">
    {% include 'pages/m9_question_detail.jinja2' %}
  </div>
  {% endif %}
  {% endif %}
  {# ---- 逐题错因分析 (M9后, 无序号) ---- #}
  {% if per_question_causes %}
  <div class="module-page" data-section-key="per_question_causes">
    {% include 'pages/m_per_question_causes.jinja2' %}
  </div>
  {% endif %}
  {# ---- 英语作文/阅读家长版占位提示: 深度讲解由老师精讲 ---- #}
  {% if _show_english_teacher_note %}
  <div class="module-page module-page--english-teacher-note">
    {% include 'pages/m_english_teacher_note.jinja2' %}
  </div>
  {% endif %}
  {# ---- M7: data_reliability ---- #}
  <div class="module-page" id="toc-m7">
    {% include 'pages/m7_data_reliability.jinja2' %}
  </div>
  {# ---- M8: appendix ---- #}
  {% set appendix_data = appendix | default({}, true) %}
  {% set _m8_data_reliability = data_reliability | default({}, true) %}
  {% set _m8_section_4_coverage = _m8_data_reliability.section_4_coverage if _m8_data_reliability.section_4_coverage else {} %}
  {% set _m8_data_insufficient = _m8_section_4_coverage.data_insufficient if _m8_section_4_coverage.data_insufficient else {} %}
  <div class="module-page" id="toc-m8">
    {% with
        meta=(meta | default({}, true)),
        analysis_scope=(appendix_data.analysis_scope | default({}, true)),
        difficulty=(appendix_data.difficulty | default({}, true)),
        papers=(appendix_data.papers | default({}, true)),
        metric_definitions=(appendix_data.metric_definitions | default([], true)),
        data_supplement=({
          'low_sample': (_m8_data_insufficient.low_sample | default({'items': []}, true)),
          'uncovered_core': (_m8_data_insufficient.uncovered_core | default({'items': []}, true))
        })
    %}
      {% include 'pages/m8_appendix.jinja2' %}
    {% endwith %}
  </div>

  {# ---- teacher_supplement: 只在教师版渲染 ---- #}
  {% if pv.show_teacher_supplement | default(false) %}
  <div class="module-page" id="toc-teacher-supplement">
    {% include 'pages/m_teacher_supplement.jinja2' %}
  </div>
  {% endif %}

  {# ---- M10: composition (英语专属；有作文数据时自动显示) ---- #}
  {% if _show_m10_composition %}
  <div class="module-page" id="toc-m10">
    {% include 'pages/m10_composition.jinja2' %}
  </div>
  {% endif %}

  {# ---- M11: reading_deep (英语专属；有阅读精讲数据时自动显示) ---- #}
  {% if _show_m11_reading_deep %}
  <div class="module-page" id="toc-m11">
    {% include 'pages/m11_reading_deep.jinja2' %}
  </div>
  {% endif %}

  {# ---- 英语进阶挑战建议 (英语专属；有 FR2 数据时自动显示) ---- #}
  {% if _has_english_progression %}
  <div class="module-page" id="toc-english-progression">
    {% include 'pages/m_english_progression.jinja2' %}
  </div>
  {% endif %}
  {% endif %}

</body>
</html>
