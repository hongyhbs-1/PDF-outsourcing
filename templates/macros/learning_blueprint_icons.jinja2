{# ==============================================================================
  learning_blueprint_icons.jinja2 — inline SVG icons for learning blueprint pages
  PDF-safe: no external assets, no icon fonts.
============================================================================== #}

{% macro lb_icon(name, class_name='') -%}
<span class="lb-icon lb-icon--{{ name }} {{ class_name }}" aria-hidden="true">
  <svg viewBox="0 0 24 24" focusable="false">
  {% if name in ['profile', 'student'] %}
    <circle cx="12" cy="8" r="3.2" />
    <path d="M5.5 19c1.2-4 3.6-6 6.5-6s5.3 2 6.5 6" />
  {% elif name == 'grade' %}
    <path d="M4 7.5 12 4l8 3.5-8 3.5L4 7.5Z" />
    <path d="M7 10v4.8c1.6 1.5 3.2 2.2 5 2.2s3.4-.7 5-2.2V10" />
  {% elif name == 'city' %}
    <path d="M6 20V8l4-2 4 2 4-2v14" />
    <path d="M10 6v14M14 8v12M4 20h16" />
  {% elif name == 'subject' %}
    <path d="M5 5.5h5.2c1 0 1.8.8 1.8 1.8V19c0-1.1-.9-2-2-2H5V5.5Z" />
    <path d="M19 5.5h-5.2c-1 0-1.8.8-1.8 1.8V19c0-1.1.9-2 2-2h5V5.5Z" />
  {% elif name in ['map', 'compass'] %}
    <circle cx="12" cy="12" r="8" />
    <path d="m15.5 8.5-2 5-5 2 2-5 5-2Z" />
  {% elif name in ['warning', 'shortlist'] %}
    <path d="M12 4 3.5 19h17L12 4Z" />
    <path d="M12 9v4M12 16.5h.01" />
  {% elif name in ['tree', 'knowledge'] %}
    <circle cx="6" cy="7" r="2" /><circle cx="18" cy="7" r="2" /><circle cx="12" cy="17" r="2" />
    <path d="M8 8.2 12 15M16 8.2 12 15" />
  {% elif name == 'domain-geometry' %}
    <path d="M12 4.5 21 19H3L12 4.5Z" />
    <path d="M12 9v4.2M12 16.5h.01" />
  {% elif name == 'domain-algebra' %}
    <path d="M5 6.5c2.5 5.7 4.4 8.9 8 11" />
    <path d="M5 17.5c3.8-2.9 6.2-6.1 8-11" />
    <path d="M15.5 7.5h2.8M16.9 6.1v2.8" />
  {% elif name == 'domain-function' %}
    <path d="M4.5 15.8c2.4-8.2 5.3-8.2 8.1 0s5.1 8.2 7.4 0" />
    <path d="M4.5 19h15" />
  {% elif name == 'domain-statistics' %}
    <path d="M12 4a8 8 0 1 0 8 8h-8V4Z" />
    <path d="M14 4.3A8 8 0 0 1 19.7 10H14V4.3Z" />
  {% elif name == 'domain-number' %}
    <rect x="4" y="4" width="6" height="6" rx="1" />
    <rect x="14" y="4" width="6" height="6" rx="1" />
    <rect x="4" y="14" width="6" height="6" rx="1" />
    <rect x="14" y="14" width="6" height="6" rx="1" />
  {% elif name == 'domain-application' %}
    <path d="M12 3.5 19 7.5v9L12 20.5 5 16.5v-9L12 3.5Z" />
    <path d="M5 7.5 12 11.5l7-4M12 11.5v9" />
  {% elif name in ['paper', 'doc'] %}
    <path d="M7 3.5h7l3 3V20H7V3.5Z" />
    <path d="M14 3.5V7h3M9.5 11h5M9.5 14h5M9.5 17h3" />
  {% elif name == 'calendar' %}
    <rect x="4" y="5.5" width="16" height="14" rx="2" />
    <path d="M8 3.5v4M16 3.5v4M4 9h16M8 13h.01M12 13h.01M16 13h.01M8 16h.01M12 16h.01" />
  {% elif name == 'shield' %}
    <path d="M12 3.5 19 6v5.5c0 4.1-2.6 7-7 8.5-4.4-1.5-7-4.4-7-8.5V6l7-2.5Z" />
    <path d="m8.5 12 2.3 2.3 4.8-5" />
  {% elif name == 'gauge' %}
    <path d="M4.5 16a7.5 7.5 0 1 1 15 0" />
    <path d="M12 16l4-5M6.5 16h11" />
  {% elif name == 'target' %}
    <circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="4" />
    <path d="M12 12 19 5M16 5h3v3" />
  {% elif name in ['growth', 'improve'] %}
    <path d="M5 19V9M10 19v-5M15 19V7M4 19h16" />
    <path d="m6 9 4 3.5 5-7 3 2.5" />
  {% elif name == 'gap' %}
    <path d="M5 7h14M5 17h14" />
    <path d="M8 10.5 5 7l3-3.5M16 13.5 19 17l-3 3.5" />
  {% elif name == 'flag' %}
    <path d="M6 20V4" />
    <path d="M7 5h10l-1.7 3L17 11H7" />
  {% elif name == 'trophy' %}
    <path d="M8 5h8v4.2A4 4 0 0 1 12 13a4 4 0 0 1-4-3.8V5Z" />
    <path d="M8 7H5.5a2.5 2.5 0 0 0 2.7 3M16 7h2.5a2.5 2.5 0 0 1-2.7 3M12 13v3M9 20h6M10 16h4" />
  {% elif name in ['bulb', 'idea'] %}
    <path d="M8.2 11.2a4 4 0 1 1 7.6 0c-.5 1.2-1.4 2-2 2.8-.4.5-.6 1-.6 1.7h-2.4c0-.7-.2-1.2-.6-1.7-.6-.8-1.5-1.6-2-2.8Z" />
    <path d="M10 18h4M10.5 20h3M12 3.5v1.2M5.5 6.5l.9.9M18.5 6.5l-.9.9M4 12h1.2M18.8 12H20" />
  {% elif name in ['data', 'collect'] %}
    <ellipse cx="12" cy="6" rx="6" ry="2.5" />
    <path d="M6 6v6c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5V6" />
    <path d="M6 12v4c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5v-4" />
  {% elif name == 'question' %}
    <path d="M8.5 8a3.5 3.5 0 1 1 5.7 2.7c-1.3 1-2.2 1.7-2.2 3.3" />
    <path d="M12 18h.01" /><circle cx="12" cy="12" r="9" />
  {% elif name == 'module' %}
    <rect x="4" y="4" width="6.5" height="6.5" rx="1.2" />
    <rect x="13.5" y="4" width="6.5" height="6.5" rx="1.2" />
    <rect x="4" y="13.5" width="6.5" height="6.5" rx="1.2" />
    <rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.2" />
  {% elif name == 'clean' %}
    <path d="M4 5h16l-6 7v5l-4 2v-7L4 5Z" />
  {% elif name == 'feature' %}
    <circle cx="7" cy="7" r="2" /><circle cx="17" cy="7" r="2" /><circle cx="12" cy="17" r="2" />
    <path d="M9 7h6M8.2 8.5 11 15M15.8 8.5 13 15" />
  {% elif name == 'ai' %}
    <rect x="6" y="6" width="12" height="12" rx="2" />
    <path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3" />
    <path d="M9 15l1.1-6h2.1l1.1 6M9.5 12.5h3.3M15.5 9v6" />
  {% elif name == 'output' %}
    <path d="M7 3.5h7l3 3V20H7V3.5Z" />
    <path d="M14 3.5V7h3M9.5 14.5l2 2 3.5-4M9.5 10h5" />
  {% elif name == 'teacher' %}
    <circle cx="12" cy="7" r="3" />
    <path d="M5.5 19c1-4 3.5-6 6.5-6s5.5 2 6.5 6" />
    <path d="M18 6h3v7h-3" />
  {% elif name == 'parent' %}
    <circle cx="9" cy="8" r="2.7" /><circle cx="15.5" cy="9" r="2.2" />
    <path d="M4.5 19c.8-3.5 2.6-5.2 5.5-5.2S14.7 15.5 15.5 19" />
    <path d="M13.5 14.5c2.5.2 4.2 1.7 5 4.5" />
  {% elif name == 'evidence' %}
    <path d="M7 4h10v16H7V4Z" />
    <path d="M9.5 8h5M9.5 11.5h5M9.5 15h2.5" />
    <path d="m13 16 1.5 1.5L18 14" />
  {% elif name == 'track' %}
    <path d="M5 12a7 7 0 0 1 12-5" />
    <path d="M17 4v4h-4" />
    <path d="M19 12a7 7 0 0 1-12 5" />
    <path d="M7 20v-4h4" />
  {% elif name == 'rocket' %}
    <path d="M13 4c3.5.5 5.5 2.5 6 6l-5 5-5-5 4-6Z" />
    <path d="M9 10 5.5 11.5 4 16l4.5-1.5M14 15l-1.5 4.5L8 21l1.5-3.5" />
    <circle cx="15" cy="8" r="1.2" />
  {% elif name == 'support' %}
    <circle cx="12" cy="7" r="2.5" />
    <path d="M6 19c.8-3.5 2.9-5.5 6-5.5s5.2 2 6 5.5" />
    <path d="M4 10a8 8 0 0 1 16 0" />
  {% elif name == 'axis' %}
    <path d="M4 12h16" />
    <path d="m16 8 4 4-4 4" />
    <circle cx="6" cy="12" r="2" /><circle cx="12" cy="12" r="2" />
  {% else %}
    <circle cx="12" cy="12" r="8" />
    <path d="M12 8v8M8 12h8" />
  {% endif %}
  </svg>
</span>
{%- endmacro %}
