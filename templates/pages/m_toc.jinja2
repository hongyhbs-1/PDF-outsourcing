{#
================================================================================
目录页 (Table of Contents)
文件: m_toc.jinja2
版本: v1.2 (B方案: 两次渲染动态页码 + dida985 新段)
描述: 列出报告各大部分标题和页码, 帮助用户快速定位内容
位置: M0(封面) + 冲刺方案 + 概览 → [本页] → M1(一、诊断摘要)
不编序号 — 与封面、概览、附录同级, 属报告"框架页"
关联CSS: m_toc.css

页码注入:
  pdf_service.py 两次渲染: 第一次生成临时PDF → fitz提取页码 →
  JS注入到 data-toc-key 对应的 span → 第二次生成最终PDF
================================================================================
#}

{# toc_pages: 由渲染器注入 (Jinja2层), 格式 {"m1": 4, "m4": 6, ...} #}
{% set _pages = toc_pages | default({}) %}
{% set _pv_toc = page_visibility | default({}, true) %}
{% set _show_m10_toc = _show_m10_composition | default(none) %}
{% set _show_m11_toc = _show_m11_reading_deep | default(none) %}
{% if _show_m10_toc is none or _show_m11_toc is none %}
  {% set _comp_toc = composition_deep | default({}, true) %}
  {% set _m10_toc = m10 | default({}, true) %}
  {% set _comp_facts_toc = composition_facts | default({}, true) %}
  {% set _comp_items_toc = _comp_facts_toc.get('items', []) if _comp_facts_toc is mapping else [] %}
  {% set _comp_rules_toc = composition_rules | default({}, true) %}
  {% set _sel_essay_toc = _comp_rules_toc.get('selected_essay', {}) | default({}, true) %}
  {% set _sel_flag_toc = _sel_essay_toc.get('selected', none) %}
  {% set _essay_active_toc = (_sel_flag_toc is none) or (_sel_flag_toc == true) %}
  {% set _rd_toc = reading_deep | default({}, true) %}
  {% set _m11_toc = m11 | default({}, true) %}
  {% set _reading_facts_toc = reading_passage_facts | default({}, true) %}
  {% set _reading_passages_toc = _reading_facts_toc.passages | default([], true) %}
  {% set _has_m10_toc_data = _essay_active_toc and (_m10_toc.visible | default(false) or (_comp_toc.score_overview | default({}, false) | length > 0) or (_comp_toc.topic_analysis | default('', false) | length > 0) or _comp_toc.data_ready | default(false) or (_comp_items_toc | length > 0)) %}
  {% set _has_m11_toc_data = _m11_toc.visible | default(false) or (_rd_toc.status | default('', false) == 'success') or (_rd_toc.content | default({}, false) | length > 0) or (_rd_toc.result | default({}, false) | length > 0) or (_reading_passages_toc | length > 0) %}
  {% if _show_m10_toc is none %}
    {% set _show_m10_toc = _pv_toc.m10_composition | default(false) %}
  {% endif %}
  {% if _show_m11_toc is none %}
    {% set _show_m11_toc = _pv_toc.m11_reading_deep | default(false) %}
  {% endif %}
{% endif %}
{% set _has_english_deep_toc = _show_m10_toc or _show_m11_toc %}

{# 英语进阶挑战建议 (FR2) 目录判断 #}
{% set _meta_subject_toc = meta.subject | default('', true) | lower %}
{% set _is_english_report_toc = _meta_subject_toc == 'english' or '英语' in (meta.subject_name | default('', true)) %}
{% set _fr2_ext_toc = facts.extensions | default({}, true) if facts is defined else {} %}
{% set _fr2_data_toc = english_progression_fr2 | default(_fr2_ext_toc.english_progression_fr2 | default({}, true), true) %}
{% set _has_english_progression_toc = _is_english_report_toc and (_fr2_data_toc.rows | default([], true) | length > 0) %}

{# dida985 新段存在性 #}
{% set _has_remediation_plan = remediation_plan | default({}, true) %}
{% set _has_pqc = per_question_causes | default([], true) | length > 0 %}

{# m9 存在性 #}
{% set _qd_toc = question_detail | default({}, true) %}
{% set _qd_papers_toc = _qd_toc.papers | default([], true) %}
{% set _show_question_detail_toc = _qd_papers_toc | length > 0 and _qd_toc.total_count | default(0) > 0 %}

{# 动态序号计算 #}
{% set _toc_no_m7 = 7 + (1 if _show_question_detail_toc else 0) + (1 if _has_pqc else 0) %}
{% set _toc_no_m9 = 7 %}

<div class="mtoc-page{% if _has_english_deep_toc %} mtoc-page--extended{% endif %}">

  {# --- 标题 --- #}
  <div class="mtoc-title-section">
    <h1 class="mtoc-title">目录</h1>
  </div>

  {# --- 目录列表 --- #}
  <ul class="mtoc-list">

    {% if false %}
    {# 冲刺方案不列入目录（封面后行动纲领，非正文章节） #}
    {% endif %}

    <li class="mtoc-item">
      <span class="mtoc-item__number">1</span>
      <span class="mtoc-item__title">诊断摘要</span>
      <span class="mtoc-item__dots"></span>
      <span class="mtoc-item__page" data-toc-key="m1">{{ _pages.get('m1', '') }}</span>
    </li>

    <li class="mtoc-item">
      <span class="mtoc-item__number">2</span>
      <span class="mtoc-item__title">六大领域达标分析</span>
      <span class="mtoc-item__dots"></span>
      <span class="mtoc-item__page" data-toc-key="m4">{{ _pages.get('m4', '') }}</span>
    </li>

    <li class="mtoc-item">
      <span class="mtoc-item__number">3</span>
      <span class="mtoc-item__title">核心短板清单</span>
      <span class="mtoc-item__dots"></span>
      <span class="mtoc-item__page" data-toc-key="m2">{{ _pages.get('m2', '') }}</span>
    </li>

    <li class="mtoc-item">
      <span class="mtoc-item__number">4</span>
      <span class="mtoc-item__title">知识点短板钻取</span>
      <span class="mtoc-item__dots"></span>
      <span class="mtoc-item__page" data-toc-key="m3">{{ _pages.get('m3', '') }}</span>
    </li>

    <li class="mtoc-item">
      <span class="mtoc-item__number">5</span>
      <span class="mtoc-item__title">城市考情对照</span>
      <span class="mtoc-item__dots"></span>
      <span class="mtoc-item__page" data-toc-key="m5">{{ _pages.get('m5', '') }}</span>
    </li>

    <li class="mtoc-item">
      <span class="mtoc-item__number">6</span>
      <span class="mtoc-item__title">分层与学习建议</span>
      <span class="mtoc-item__dots"></span>
      <span class="mtoc-item__page" data-toc-key="m6">{{ _pages.get('m6', '') }}</span>
    </li>

    {% if _show_question_detail_toc %}
    <li class="mtoc-item">
      <span class="mtoc-item__number">{{ _toc_no_m9 }}</span>
      <span class="mtoc-item__title">逐题分析明细</span>
      <span class="mtoc-item__dots"></span>
      <span class="mtoc-item__page" data-toc-key="m9">{{ _pages.get('m9', '') }}</span>
    </li>
    {% endif %}

    {% if _has_pqc %}
    <li class="mtoc-item">
      <span class="mtoc-item__number">{{ _toc_no_m9 + 1 }}</span>
      <span class="mtoc-item__title">逐题错因分析</span>
      <span class="mtoc-item__dots"></span>
      <span class="mtoc-item__page" data-toc-key="per_question_causes">{{ _pages.get('per_question_causes', '') }}</span>
    </li>
    {% endif %}

    <li class="mtoc-item">
      <span class="mtoc-item__number">{{ _toc_no_m7 }}</span>
      <span class="mtoc-item__title">数据覆盖与可信度说明</span>
      <span class="mtoc-item__dots"></span>
      <span class="mtoc-item__page" data-toc-key="m7">{{ _pages.get('m7', '') }}</span>
    </li>

    <li class="mtoc-item mtoc-item--framepage">
      <span class="mtoc-item__number"></span>
      <span class="mtoc-item__title">附录</span>
      <span class="mtoc-item__dots"></span>
      <span class="mtoc-item__page" data-toc-key="m8">{{ _pages.get('m8', '') }}</span>
    </li>

    {% if _show_m10_toc %}
    <li class="mtoc-item">
      <span class="mtoc-item__number">10</span>
      <span class="mtoc-item__title">作文精讲</span>
      <span class="mtoc-item__dots"></span>
      <span class="mtoc-item__page" data-toc-key="m10">{{ _pages.get('m10', '') }}</span>
    </li>
    {% endif %}

    {% if _show_m11_toc %}
    <li class="mtoc-item">
      <span class="mtoc-item__number">11</span>
      <span class="mtoc-item__title">阅读精讲</span>
      <span class="mtoc-item__dots"></span>
      <span class="mtoc-item__page" data-toc-key="m11">{{ _pages.get('m11', '') }}</span>
    </li>
    {% endif %}

    {% if _has_english_progression_toc %}
    <li class="mtoc-item mtoc-item--supplement">
      <span class="mtoc-item__number">·</span>
      <span class="mtoc-item__title">进阶挑战建议</span>
      <span class="mtoc-item__dots"></span>
      <span class="mtoc-item__page" data-toc-key="english_progression">{{ _pages.get('english_progression', '') }}</span>
    </li>
    {% endif %}

  </ul>

  {# --- 阅读建议 --- #}
  <div class="mtoc-reading-guide">
    <div class="mtoc-reading-guide__title">阅读建议</div>
    <div class="mtoc-reading-guide__items">
      <div class="mtoc-reading-guide__item">
        <span class="mtoc-reading-guide__num">1</span>
        <span>先看<strong>诊断摘要</strong>了解整体水平，再看<strong>领域达标分析</strong>定位薄弱方向。</span>
      </div>
      <div class="mtoc-reading-guide__item">
        <span class="mtoc-reading-guide__num">2</span>
        <span>重点关注<strong>核心短板清单</strong>中的高优先级项目，把它们转成下一阶段训练任务。</span>
      </div>
      {% if _show_question_detail_toc %}
      <div class="mtoc-reading-guide__item">
        <span class="mtoc-reading-guide__num">3</span>
        <span>对照<strong>逐题分析明细</strong>回看错题，确认薄弱环节的具体表现。</span>
      </div>
      {% endif %}
      {% if _has_english_deep_toc %}
      <div class="mtoc-reading-guide__item">
        <span class="mtoc-reading-guide__num">4</span>
        <span>英语专项页可直接查看<strong>作文精讲</strong>与<strong>阅读精讲</strong>。</span>
      </div>
      {% endif %}
      {% if _has_english_progression_toc %}
      <div class="mtoc-reading-guide__item">
        <span class="mtoc-reading-guide__num">{{ 5 if _has_english_deep_toc else 4 }}</span>
        <span>已扎实的知识点可参考<strong>进阶挑战建议</strong>提升训练难度。</span>
      </div>
      {% endif %}
    </div>
  </div>

</div>
