{# ---------------------------------------------------------------------------
  Page 1: Student Diagnostic Panorama Blueprint
  Required context key: diagnostic_blueprint
--------------------------------------------------------------------------- #}
{% from 'macros/learning_blueprint_icons.jinja2' import lb_icon %}
{% set bp = diagnostic_blueprint %}
<section class="m0-module-page learning-blueprint-page diagnostic-blueprint-page">
  <div class="edge-tabs-mask"></div>
  <header class="lb-header">
    <h1>{{ bp.headline.title }}</h1>
    <div class="lb-subtitle"><span></span>{{ bp.headline.subtitle }}<span></span></div>
    <div class="lb-slogan">{{ bp.headline.slogan | replace('真正影响提分的结构性问题', '<strong>真正影响提分的结构性问题</strong>') | safe }}</div>
  </header>

  <main class="diagnostic-grid">
    <section class="lb-panel profile-panel">
      <h2><b>01</b> {{ lb_icon('profile', 'lb-title-icon') }}学习画像总览</h2>
      <div class="student-card">
        <div class="student-avatar" aria-hidden="true">
          <svg viewBox="0 0 72 72" role="img">
            <circle cx="36" cy="36" r="34" />
            <circle class="avatar-head" cx="36" cy="28" r="13" />
            <path class="avatar-body" d="M18 61c3-15 13-22 18-22s15 7 18 22" />
          </svg>
        </div>
        <div class="student-meta">
          <p>{{ lb_icon('student', 'lb-meta-icon') }}<span>学生</span>{{ bp.profile.student_name }}</p>
          <p>{{ lb_icon('grade', 'lb-meta-icon') }}<span>年级</span>{{ bp.profile.grade }}</p>
          <p>{{ lb_icon('city', 'lb-meta-icon') }}<span>城市</span>{{ bp.profile.city_name }}</p>
          <p>{{ lb_icon('subject', 'lb-meta-icon') }}<span>科目</span>{{ bp.profile.subject_name }}</p>
        </div>
      </div>
      <div class="metric-row three">
        <div class="metric-card primary">{{ lb_icon('gauge', 'metric-icon') }}<span>当前水平</span><strong>{{ bp.profile.current_accuracy_text }}</strong><em>综合正确率</em></div>
        <div class="metric-card success">{{ lb_icon('target', 'metric-icon') }}<span>目标线</span><strong>{{ bp.profile.target_accuracy_text }}</strong><em>目标正确率</em></div>
        <div class="metric-card warning">{{ lb_icon('gap', 'metric-icon') }}<span>差距</span><strong>{{ bp.profile.delta_text }}</strong><em>距目标线</em></div>
      </div>
      <div class="small-card-row">
        <div class="small-signal">{{ lb_icon('gauge', 'signal-icon') }}<div><span>学习状态</span><strong>{{ bp.profile.stage_name }}</strong></div></div>
        <div class="small-signal">{{ lb_icon('growth', 'signal-icon') }}<div><span>当前阶段</span><strong>{{ bp.profile.stage_hint }}</strong></div></div>
        <div class="small-signal">{{ lb_icon('target', 'signal-icon') }}<div><span>重点关注领域</span><strong>{{ bp.profile.focus_domains_text }}</strong></div></div>
      </div>
    </section>

    <section class="lb-panel ability-axis-panel">
      <h2><b>02</b> {{ lb_icon('map', 'lb-title-icon') }}{{ bp.meta.ability_map_title }}</h2>
      <div class="ability-map-wrap">
        <svg class="ability-map-svg" viewBox="0 0 600 590" role="img" aria-label="{{ bp.meta.ability_map_aria }}">
          <defs>
            <radialGradient id="mapCenterGlow" cx="50%" cy="50%" r="55%">
              <stop offset="0%" stop-color="#EAF7FB" stop-opacity="1" />
              <stop offset="75%" stop-color="#EAF7FB" stop-opacity="0" />
            </radialGradient>
          </defs>
          <circle cx="300" cy="300" r="260" fill="url(#mapCenterGlow)" />
          <g class="map-rings">
            <circle cx="300" cy="300" r="82" />
            <circle cx="300" cy="300" r="130" />
            <circle cx="300" cy="300" r="178" />
            <circle cx="300" cy="300" r="226" />
          </g>
          <g class="center-person">
            <circle cx="300" cy="300" r="40" />
            <circle cx="300" cy="284" r="14" />
            <path d="M268 326c6-20 20-28 32-28s26 8 32 28" />
            <text x="300" y="348">{{ bp.meta.ability_axis_label }}</text>
          </g>
          {% for d in bp.domains %}
          <g class="domain-node state-{{ d.state }}" transform="translate({{ d.x }}, {{ d.y }})">
            <polygon points="0,-44 38,-22 38,22 0,44 -38,22 -38,-22" />
            <text class="domain-name" x="0" y="-18">{{ d.name }}</text>
            <text class="domain-acc" x="0" y="10">{{ d.accuracy_text }}</text>
            <text class="domain-state" x="0" y="32">{{ d.state_label }}</text>
          </g>
          {% endfor %}
          <g class="map-spokes">
            {% for d in bp.domains %}
            <line x1="300" y1="300" x2="{{ d.x }}" y2="{{ d.y }}" />
            {% endfor %}
          </g>
        </svg>
      </div>
      <div class="map-legend">
        <span class="legend achieved">已达标</span>
        <span class="legend attention">需关注</span>
        <span class="legend improve">待提升</span>
        <span class="legend nodata">题目太少</span>
      </div>
    </section>

    <section class="lb-panel shortlist-panel">
      <h2><b>03</b> {{ lb_icon('warning', 'lb-title-icon lb-title-icon--warning') }}核心短板清单 <small>优先突破</small></h2>
      <table class="shortlist-table">
        <thead>
          <tr>
            <th>优先级</th><th>知识点</th><th>领域</th><th>正确率</th><th>距目标线</th><th>城市参考</th>
          </tr>
        </thead>
        <tbody>
          {% for item in bp.shortlist %}
          <tr>
            <td><span class="priority-badge {{ item.priority_class }}">{{ item.priority }}</span></td>
            <td><strong class="shortlist-kp-name">{{ lb_icon('target', 'shortlist-row-icon') }}{{ item.name }}</strong><small>{{ item.tag_text }}</small></td>
            <td>{{ item.domain }}</td>
            <td>{{ item.accuracy_text }}</td>
            <td class="gap-cell">{{ item.gap_text }}</td>
            <td>{{ item.city_rank_text }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      <p class="table-note">推荐依据：正确率、距目标线、城市考频、题目数量综合排序。</p>
    </section>

    <section class="lb-panel knowledge-tree-panel">
      <h2><b>04</b> {{ lb_icon('tree', 'lb-title-icon') }}知识点钻取结构 <small>能力树</small></h2>
      <div class="drill-head"><span>{{ bp.meta.l1_label }}</span><i></i><span>L2（知识模块）</span><i></i><span>L3（知识点）</span><i></i><span>L4（考点细节）</span></div>
      <div class="drill-list">
        {% for item in bp.diagnostic_drill_rows %}
        {% set domain_icon = 'tree' %}
        {% if '几何' in item.domain %}{% set domain_icon = 'domain-geometry' %}
        {% elif '代数' in item.domain or '方程' in item.domain or '不等式' in item.domain %}{% set domain_icon = 'domain-algebra' %}
        {% elif '函数' in item.domain %}{% set domain_icon = 'domain-function' %}
        {% elif '统计' in item.domain or '概率' in item.domain %}{% set domain_icon = 'domain-statistics' %}
        {% elif '数论' in item.domain or '数与' in item.domain %}{% set domain_icon = 'domain-number' %}
        {% elif '应用' in item.domain or '综合' in item.domain %}{% set domain_icon = 'domain-application' %}{% endif %}
        <div class="drill-row state-{{ item.state }}">
          <span class="drill-domain">{{ lb_icon(domain_icon, 'drill-row-icon drill-domain-icon') }}{{ item.domain }}</span><i></i>
          <span class="drill-module">{{ item.l2 or item.domain }}</span><i></i>
          <span class="drill-kp">{{ item.l3 }}</span><i></i>
          <span class="drill-detail">{{ item.l4 or '专项突破' }}</span>
        </div>
        {% endfor %}
      </div>
    </section>

    <section class="lb-panel evidence-panel">
      <h2><b>05</b> {{ lb_icon('data', 'lb-title-icon') }}数据分析依据</h2>
      <div class="engine-grid">
        <div class="engine-card">{{ lb_icon('paper', 'engine-icon') }}<div><strong>{{ bp.evidence.paper_count }}</strong><span>分析试卷</span></div></div>
        <div class="engine-card engine-card--period">{{ lb_icon('calendar', 'engine-icon') }}<div><strong>{{ bp.evidence.test_period | replace('-', '<br>至 ') | safe }}</strong><span>数据周期</span></div></div>
        <div class="engine-card">{{ lb_icon('question', 'engine-icon') }}<div><strong>{{ bp.evidence.valid_questions }}</strong><span>有效大题</span></div></div>
        <div class="engine-card">{{ lb_icon('shield', 'engine-icon engine-icon--success') }}<div><strong>{{ bp.confidence.level }}</strong><span>数据可信度</span></div></div>
      </div>
      <div class="ai-core-strip">
        <div class="ai-core-badge"><strong>AI</strong><span>分析引擎</span></div>
        <div class="ai-core-meta"><strong>数据可信度 {{ bp.confidence.level }}</strong><span>{% for i in range(bp.confidence.stars) %}★{% endfor %}</span></div>
      </div>
      <div class="expanded-line">{{ lb_icon('question', 'expanded-line-icon') }}<div><strong>展开 {{ bp.evidence.expanded_questions }} 道子题</strong><span>深入分析每一道题的得分点与失分点</span></div></div>
      <p class="table-note">数据周期：{{ bp.evidence.test_period }} · 共分析 {{ bp.evidence.paper_count }} 套试卷，覆盖 {{ bp.evidence.valid_questions }} 道有效大题</p>
    </section>

    <section class="lb-panel path-panel">
      <h2><b>06</b> {{ lb_icon('target', 'lb-title-icon lb-title-icon--success') }}提分路径 <small>{{ bp.profile.current_accuracy_text }} → {{ bp.profile.target_accuracy_text }}</small></h2>
      <div class="path-stage-grid">
        {% for stage in bp.stage_plan.stages %}
        <div class="stage-card stage-{{ stage.state }}">
          {% if stage.state == 'foundation' %}{{ lb_icon('flag', 'path-stage-icon') }}{% elif stage.state == 'improve' %}{{ lb_icon('growth', 'path-stage-icon') }}{% else %}{{ lb_icon('trophy', 'path-stage-icon path-stage-icon--sprint') }}{% endif %}
          <div><strong>{{ stage.no }}</strong><em>{{ stage.range }}</em><span>{{ stage.title }}</span><ul>{% for text in stage["items"][:2] %}<li>{{ text }}</li>{% endfor %}</ul></div>
        </div>
        {% if not loop.last %}<div class="stage-arrow"></div>{% endif %}
        {% endfor %}
      </div>
      <div class="path-timeline path-timeline--reference">
        {% for node in bp.profile.path_milestones %}
        <div class="path-node path-node--{{ node.state }}"><strong>{{ node.value }}</strong><span>{{ node.label }}</span></div>
        {% endfor %}
      </div>
    </section>
  </main>

</section>
