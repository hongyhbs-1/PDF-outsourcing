{% from 'macros/learning_blueprint_icons.jinja2' import lb_icon %}

{# -----------------------------------------------------------------------------
 # 宏定义：安全输出 (Safe Output Macros)
 # ----------------------------------------------------------------------------- #}

{# 安全输出文本，空值返回默认值 #}
{% macro safe_text(value, default="--") %}
  {{- value if value is not none and value != "" else default -}}
{% endmacro %}

{# 将内部层级名转换成家长可读中文标签 #}
{% macro level_label(level) -%}
  {%- if level == "L1" -%}领域
  {%- elif level == "L2" -%}模块
  {%- elif level == "L3" -%}知识点
  {%- elif level == "L4" -%}技能点
  {%- else -%}{{ level | default("层级", true) }}
  {%- endif -%}
{%- endmacro %}

{# 友好百分比：整数不保留 .0，非整数保留 1 位 #}
{% macro format_percent_value(value, default="--") -%}
  {%- if value is not none -%}
    {%- set v = value | float -%}
    {%- if v == (v | round(0)) -%}{{ v | int }}%{%- else -%}{{ "%.1f" | format(v) }}%{%- endif -%}
  {%- else -%}
    {{ default }}
  {%- endif -%}
{%- endmacro %}

{# 距目标线改为正向说明：差/超，不再裸露负数 #}
{% macro render_gap_text(delta) -%}
  {%- if delta is none -%}
    --
  {%- elif delta < 0 -%}
    差{{ format_percent_value(0 - delta, "") }}
  {%- elif delta > 0 -%}
    超{{ format_percent_value(delta, "") }}
  {%- else -%}
    达标
  {%- endif -%}
{%- endmacro %}

{# 进度条宽度分桶，避免在 M3 中使用 inline style #}
{% macro progress_width_class(value) -%}
  {%- set v = value | default(0, true) | float -%}
  {%- if v >= 97.5 -%}m3-kp-progress-fill--w100
  {%- elif v >= 92.5 -%}m3-kp-progress-fill--w95
  {%- elif v >= 87.5 -%}m3-kp-progress-fill--w90
  {%- elif v >= 82.5 -%}m3-kp-progress-fill--w85
  {%- elif v >= 77.5 -%}m3-kp-progress-fill--w80
  {%- elif v >= 72.5 -%}m3-kp-progress-fill--w75
  {%- elif v >= 67.5 -%}m3-kp-progress-fill--w70
  {%- elif v >= 62.5 -%}m3-kp-progress-fill--w65
  {%- elif v >= 57.5 -%}m3-kp-progress-fill--w60
  {%- elif v >= 52.5 -%}m3-kp-progress-fill--w55
  {%- elif v >= 47.5 -%}m3-kp-progress-fill--w50
  {%- elif v >= 42.5 -%}m3-kp-progress-fill--w45
  {%- elif v >= 37.5 -%}m3-kp-progress-fill--w40
  {%- elif v >= 32.5 -%}m3-kp-progress-fill--w35
  {%- elif v >= 27.5 -%}m3-kp-progress-fill--w30
  {%- elif v >= 22.5 -%}m3-kp-progress-fill--w25
  {%- elif v >= 17.5 -%}m3-kp-progress-fill--w20
  {%- elif v >= 12.5 -%}m3-kp-progress-fill--w15
  {%- elif v >= 7.5 -%}m3-kp-progress-fill--w10
  {%- elif v >= 2.5 -%}m3-kp-progress-fill--w5
  {%- else -%}m3-kp-progress-fill--w0
  {%- endif -%}
{%- endmacro %}

{# 将英文样本中的父级编码映射成中文名称，避免显示 1.03/2.01 等内部编码 #}
{% macro parent_display_for_item(item, level, l2_items, l3_items, fallback_domain) -%}
  {%- if level == "L2" -%}
    {{ fallback_domain }}
  {%- elif level == "L3" -%}
    {%- set raw = item.parent_name | default(item.parent_l2_name, true) -%}
    {%- set ns = namespace(text='') -%}
    {%- for p in l2_items -%}
      {%- if raw and p.code is defined and p.code == raw -%}{%- set ns.text = p.name_cn | default(raw, true) -%}{%- endif -%}
    {%- endfor -%}
    {%- if ns.text -%}{{ ns.text }}{%- else -%}{{ display_domain_or_text(raw | default(fallback_domain, true)) }}{%- endif -%}
  {%- elif level == "L4" -%}
    {%- set raw = item.parent_name | default(item.parent_l3_name, true) -%}
    {%- set ns = namespace(text='') -%}
    {%- for p in l3_items -%}
      {%- if raw and p.code is defined and p.code == raw -%}{%- set ns.text = p.name_cn | default(raw, true) -%}{%- endif -%}
    {%- endfor -%}
    {%- if ns.text -%}{{ ns.text }}{%- else -%}{{ display_domain_or_text(raw | default(fallback_domain, true)) }}{%- endif -%}
  {%- else -%}
    {{ fallback_domain }}
  {%- endif -%}
{%- endmacro %}

{# P10 新版：单条知识诊断行 #}
{% macro render_diagnosis_row(row, d_name, l2_items, l3_items, display_index=1) %}
  {%- set it = row.item -%}
  {%- set level_code = row.level_code | default("L3", true) -%}
  {%- set acc = it.accuracy if it.accuracy is defined else none -%}
  {%- set delta = it.delta_vs_target if it.delta_vs_target is defined else it.gap_to_target | default(none) -%}
  {%- set achieved = it.is_achieved if it.is_achieved is defined else (delta is not none and delta >= 0) -%}
  {%- set status = "achieved" if achieved else ("danger" if acc is not none and acc < 60 else "attention") -%}
  {%- set parent_text = parent_display_for_item(it, level_code, l2_items, l3_items, d_name) -%}
  <div class="m3-kp-diagnosis-row m3-kp-diagnosis-row--{{ status }}">
    <div class="m3-kp-diagnosis-row__marker">{% if achieved %}&#10003;{% else %}{{ display_index }}{% endif %}</div>
    <div class="m3-kp-diagnosis-row__main">
      <div class="m3-kp-diagnosis-row__name">
        {{ safe_text(it.name_cn) }}
        <span class="m3-kp-diagnosis-row__type">{{ level_label(level_code) }}</span>
      </div>
      <div class="m3-kp-diagnosis-row__path">
        {{ d_name }}{% if level_code != "L2" and parent_text %} · {{ parent_text }}{% endif %}
      </div>
    </div>
    <div class="m3-kp-diagnosis-row__metric">
      <strong>{{ format_percent_value(acc) }}</strong>
      <span>当前正确率</span>
    </div>
    <div class="m3-kp-diagnosis-row__progress">
      <div class="m3-kp-progress-track"><div class="m3-kp-progress-fill {{ progress_width_class(acc) }}"></div></div>
      <span class="m3-kp-diagnosis-row__gap">{{ render_gap_text(delta) }}</span>
    </div>
    <div class="m3-kp-diagnosis-row__count">
      <strong>{{ safe_text(it.count) }}题</strong>
      <span>已做题量</span>
    </div>
  </div>
{% endmacro %}

{# 将 L1 编码（如 1.00）转成当前学科的领域名；其它编码/文本原样展示 #}
{% macro display_domain_or_text(value) %}
  {%- if value is not none and value != "" -%}
    {%- set text = value | string -%}
    {%- set key = text.split('.')[0] -%}
    {%- if knowledge_code_names is defined and text in knowledge_code_names -%}
      {{- knowledge_code_names[text] -}}
    {%- elif key in domain_names and (text == key or text == key ~ '.00') -%}
      {{- domain_names[key] -}}
    {%- else -%}
      {{- text -}}
    {%- endif -%}
  {%- else -%}
    --
  {%- endif -%}
{% endmacro %}

{# -----------------------------------------------------------------------------
 # 主模板开始
 # ----------------------------------------------------------------------------- #}

{# meta 变量定义 - 确保兼容性 #}
{% set meta = meta | default({}) %}

{# 获取模块数据，支持多种数据路径 #}
{% set data = section_3_kp_drill | default(kp_drill, true) | default({}, true) %}

{# 提取各部分数据 #}
{% set header = data.header | default({}, true) %}
{% set module_title = data.module_title | default("知识点掌握情况", true) %}
{% set intro_text = data.intro_text | default("从六大领域逐层下钻，定位具体薄弱环节：", true) %}
{% set level_guide = data.level_guide | default([], true) %}
{% set tables = data.tables | default([], true) %}
{% set path_example = data.path_example | default({}, true) %}
{% set path_nodes = path_example.nodes | default([], true) %}
{% set guide_column_count = (1 if intro_text else 0) + (1 if path_nodes | length > 0 else 0) %}
{% set drill_path_names = [] %}
{% set drill_focus = namespace(l3='', l4='', max_gap='') %}
{% for node in path_nodes %}
  {% if node.name_cn %}{% set _ = drill_path_names.append(node.name_cn) %}{% endif %}
  {% if node.level == 'L3' %}{% set drill_focus.l3 = node.name_cn | default('', true) %}{% endif %}
  {% if node.level == 'L4' %}{% set drill_focus.l4 = node.name_cn | default('', true) %}{% endif %}
  {% set node_delta = node.delta_vs_target if node.delta_vs_target is defined else node.gap_to_target | default(none) %}
  {% if node_delta is not none %}{% set drill_focus.max_gap = (node_delta | abs) ~ '%' %}{% endif %}
{% endfor %}

{# [v2.0] 六大领域数据：英文报告优先使用英文领域，避免旧样本中的数学兜底名泄漏 #}
{% set subject_code = meta.subject | default('', true) | lower %}
{% set subject_name = meta.subject_name | default('', true) %}
{% set is_english_subject = subject_code == 'english' or '英语' in subject_name %}
{% set default_domain_names = {
  "1": "词汇与词法",
  "2": "语法",
  "3": "句法与句型",
  "4": "阅读理解",
  "5": "写作能力",
  "6": "语言运用"
} if is_english_subject else {
  "1": "方程与不等式",
  "2": "函数",
  "3": "数与代数",
  "4": "统计与概率",
  "5": "应用",
  "6": "几何"
} %}
{% set domain_names = {} %}
{% for key, name in default_domain_names.items() %}
  {% set _ = domain_names.update({key: name}) %}
{% endfor %}
{% if not is_english_subject %}
  {% for key, name in (data.domain_names | default({}, true)).items() %}
    {% set _ = domain_names.update({key: name}) %}
  {% endfor %}
{% endif %}
{% if domains is defined and domains.domain_items is defined %}
  {% for item in domains.domain_items | default([], true) %}
    {% set raw_code = item.code | default(item.domain_code | default('', true), true) | string %}
    {% set key = raw_code.split('.')[0] %}
    {% set name = item.name_cn | default(item.name | default('', true), true) %}
    {% if key and name %}{% set _ = domain_names.update({key: name}) %}{% endif %}
  {% endfor %}
{% endif %}
{% set domain_panels = data.domain_panels | default({}, true) %}
{% set knowledge_code_names = {} %}
{% for _dk, _panel in domain_panels.items() %}
  {% for _lvl_items in [_panel.l2_items | default([], true), _panel.l3_items | default([], true), _panel.l4_items | default([], true)] %}
    {% for _it in _lvl_items %}
      {% if _it.code is defined and _it.code and _it.name_cn %}{% set _ = knowledge_code_names.update({_it.code: _it.name_cn}) %}{% endif %}
    {% endfor %}
  {% endfor %}
{% endfor %}

{# [v2.0] 固定的六大领域编号列表（确保始终生成6个panel） #}
{% set domain_keys = ["1", "2", "3", "4", "5", "6"] %}

{# [v2.0] has_data 判定：优先用适配层提供的，否则根据 domain_panels 或 tables 计算 #}
{% set has_data = data.has_data | default((domain_panels | length) > 0 or (tables | length) > 0, true) %}
{% set drill_nodata_names = [] %}
{% for dk in domain_keys %}
  {% set panel = domain_panels[dk] | default({}, true) %}
  {% set l2_items = panel.l2_items | default([], true) %}
  {% set l3_items = panel.l3_items | default([], true) %}
  {% set l4_items = panel.l4_items | default([], true) %}
  {% set any_items = (l2_items | length > 0) or (l3_items | length > 0) or (l4_items | length > 0) %}
  {% set panel_has_data = panel.has_data | default(false, true) %}
  {% if not any_items and not panel_has_data %}
    {% set d_name = domain_names[dk] | default(panel.domain_name | default("领域" ~ dk, true), true) %}
    {% set _ = drill_nodata_names.append(d_name) %}
  {% endif %}
{% endfor %}

<section class="m3-kp-drill">
  <div class="m3-kp-drill__container">

    <h2 class="m3-kp-drill__title">{{ lb_icon('tree', 'frame-title-icon') }}四、{{ module_title }}</h2>

    <section class="m3-kp-core-summary">
      <div class="m3-kp-core-summary__label">{{ lb_icon('tree', 'frame-conclusion-icon') }}本页核心结论</div>
      <div class="m3-kp-core-summary__text">
        {% if drill_focus.l3 or drill_focus.l4 %}
          本页按「领域→模块→知识点」梳理掌握情况，优先关注{% if drill_focus.l3 %}「{{ drill_focus.l3 }}」{% endif %}{% if drill_focus.l4 %}及「{{ drill_focus.l4 }}」{% endif %}{% if drill_focus.max_gap %}，最大提升空间约 {{ drill_focus.max_gap }}{% endif %}；
        {% else %}
          本页用于展示从领域到知识点细节的掌握情况；
        {% endif %}
        {% if drill_nodata_names | length > 0 %}另有 {{ drill_nodata_names | length }} 个领域样本不足，需补充答题记录后再做细颗粒诊断。{% else %}下方按领域展示未达标与已达标明细，颜色区分状态，便于安排专项补强。{% endif %}
      </div>
    </section>

    <div class="module-content-card m3-kp-guide-card" data-guide-columns="{{ 'single' if guide_column_count <= 1 else 'double' }}">

    {# =========================================================================
     # 区块3：介绍面板 + 层级步骤条
     # ========================================================================= #}
    {% if intro_text %}
    <div class="m3-kp-guide-column">
      <div class="m3-kp-drill__section-title m3-kp-drill__section-title--guide">{{ lb_icon('tree', 'frame-inline-icon') }} 一、层级说明</div>
      <div class="m3-kp-drill__intro-panel">
        {# 说明文字：与右侧提示条使用同一卡片样式 #}
        <div class="m3-kp-path__note m3-kp-guide-note">{{ intro_text }}</div>

        {# 层级步骤条 L1 → L2 → L3 → L4 #}
        {% if level_guide | length > 0 %}
        <div class="m3-kp-steps">
          {% for step in level_guide %}
            <div class="m3-kp-step m3-kp-step--{{ step.theme | default('l1', true) }}">
              <div class="m3-kp-step__lvl">{{ step.level | default("L?", true) }}</div>
              <div class="m3-kp-step__meta">
                <div class="m3-kp-step__name">{{ lb_icon('tree' if step.level == 'L1' else ('module' if step.level == 'L2' else ('target' if step.level == 'L3' else 'feature')), 'frame-inline-icon') }} {{ step.name | default("--", true) }}</div>
                <div class="m3-kp-step__desc">{{ step.desc | default("", true) }}</div>
              </div>
            </div>
            {% if not loop.last %}
              <div class="m3-kp-step-arrow"></div>
            {% endif %}
          {% endfor %}
        </div>
        {% else %}
        {# 层级数据为空时的兜底显示 #}
        <div class="m3-kp-steps">
          <div class="m3-kp-step m3-kp-step--l1">
            <div class="m3-kp-step__lvl">L1</div>
            <div class="m3-kp-step__meta">
              <div class="m3-kp-step__name">{{ lb_icon('tree', 'frame-inline-icon') }} 领域</div>
              <div class="m3-kp-step__desc">(6项)</div>
            </div>
          </div>
          <div class="m3-kp-step-arrow"></div>
          <div class="m3-kp-step m3-kp-step--l2">
            <div class="m3-kp-step__lvl">L2</div>
            <div class="m3-kp-step__meta">
              <div class="m3-kp-step__name">{{ lb_icon('module', 'frame-inline-icon') }} 模块</div>
              <div class="m3-kp-step__desc">(粗粒度)</div>
            </div>
          </div>
          <div class="m3-kp-step-arrow"></div>
          <div class="m3-kp-step m3-kp-step--l3">
            <div class="m3-kp-step__lvl">L3</div>
            <div class="m3-kp-step__meta">
              <div class="m3-kp-step__name">{{ lb_icon('target', 'frame-inline-icon') }} 知识点</div>
              <div class="m3-kp-step__desc">(中粒度)</div>
            </div>
          </div>
          {% if l4_items is defined and l4_items | length > 0 %}
          <div class="m3-kp-step-arrow"></div>
          <div class="m3-kp-step m3-kp-step--l4">
            <div class="m3-kp-step__lvl">L4</div>
            <div class="m3-kp-step__meta">
              <div class="m3-kp-step__name">{{ lb_icon('feature', 'frame-inline-icon') }} 技能点</div>
              <div class="m3-kp-step__desc">(细粒度)</div>
            </div>
          </div>
          {% endif %}
        </div>
        {% endif %}
      </div>
    </div>
    {% endif %}

    {# =========================================================================
     # 区块4：钻取路径示例（可选）
     # ========================================================================= #}
    {% if path_example and (path_example.nodes is defined and path_example.nodes | length > 0) %}
    <div class="m3-kp-guide-column">
      <div class="m3-kp-drill__section-title">{{ lb_icon('map', 'frame-inline-icon') }} 二、{{ path_example.title | default("钻取路径示例", true) }}</div>
      <div class="m3-kp-path">
        {# 说明条：置顶展示 #}
        {% if path_example.note_text %}
        <div class="m3-kp-path__note">* {{ path_example.note_text }}（示例，不代表本次诊断结果）</div>
        {% endif %}

        {# 路径节点 #}
        <div class="m3-kp-path__nodes">
          {% for n in path_example.nodes %}
            <div class="m3-kp-path-node m3-kp-path-node--{{ n.theme | default('l1', true) }}">
              <div class="m3-kp-path-node__lvl">{{ n.level | default("L?", true) }}</div>
              <div class="m3-kp-path-node__name">{{ display_domain_or_text(n.name_cn | default("--", true)) }}</div>
              <div class="m3-kp-path-node__delta">
                {# [v1.1] 支持 gap_to_target 回退 #}
                {% set node_delta = n.delta_vs_target if n.delta_vs_target is defined else n.gap_to_target | default(none) %}
                {% if node_delta is not none %}
                  {{ node_delta }}%
                {% else %}
                  --
                {% endif %}
              </div>
            </div>
            {% if not loop.last %}
              <div class="m3-kp-path-arrow">></div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
    {% endif %}
    </div><!-- /.module-content-card -->

    {# =========================================================================
     # 区块5：钻取表格区域 - v2.0 六大领域分组版
     # 强制创建6个 <div class="m3-kp-drill__panel">，每个对应一个L1领域
     # 每个 panel 内部包含该领域的 L2/L3/L4 三个层级表格
     # ========================================================================= #}
    {% if has_data %}

      {# -----------------------------------------------------------------------
       # 遍历六大领域（固定6个panel，即使某领域无数据也会创建空panel）
       # domain_keys = ["1", "2", "3", "4", "5", "6"]
       # ----------------------------------------------------------------------- #}
      {# 收集无数据领域名称，同时确定需要渲染的领域；四个有效领域时走 2x2 等高卡片布局 #}
      {% set nodata_names = [] %}
      {% set render_domain_keys = [] %}
      {% for dk in domain_keys %}
        {% set panel = domain_panels[dk] | default({}, true) %}
        {% set l2_items = panel.l2_items | default([], true) %}
        {% set l3_items = panel.l3_items | default([], true) %}
        {% set l4_items = panel.l4_items | default([], true) %}
        {% set any_items = (l2_items | length > 0) or (l3_items | length > 0) or (l4_items | length > 0) %}
        {% set panel_has_data = panel.has_data | default(false, true) %}
        {% set should_render_panel = any_items or panel_has_data or (panel.all_achieved | default(false)) %}
        {% if should_render_panel %}
          {% set _ = render_domain_keys.append(dk) %}
        {% else %}
          {% set d_name = domain_names[dk] | default(panel.domain_name | default("领域" ~ dk, true), true) %}
          {% set _ = nodata_names.append(d_name) %}
        {% endif %}
      {% endfor %}

      {% macro render_domain_panel(dk) %}
        {# 获取当前领域的数据（如果存在） #}
        {% set panel = domain_panels[dk] | default({}, true) %}
        {% set d_name = domain_names[dk] | default(panel.domain_name | default("领域" ~ dk, true), true) %}
        {% set d_code = panel.domain_code | default(dk, true) %}
        {% set panel_has_data = panel.has_data | default(false, true) %}

        {# 获取各层级数据 #}
        {% set l2_items = panel.l2_items | default([], true) %}
        {% set l3_items = panel.l3_items | default([], true) %}
        {% set l4_items = panel.l4_items | default([], true) %}
        {% set any_items = (l2_items | length > 0) or (l3_items | length > 0) or (l4_items | length > 0) %}

        {# 跳过无数据领域 — 统一在末尾合并展示 #}
        {% if not any_items and not panel_has_data and not (panel.all_achieved | default(false)) %}
          {# 跳过，不在循环中渲染空 panel #}
        {% else %}

        {# P10 新版：从“内部层级表格”改为“领域诊断卡片”。
           展示策略：未达标优先，其次补充已达标；最多展示 5 条，避免信息密度过高。 #}
        {% set row_ns = namespace(items=[], unmet=0, achieved=0, danger=0, attention=0) %}

        {# 1) 未达标知识点 #}
        {% for it in l3_items %}
          {% set delta = it.delta_vs_target if it.delta_vs_target is defined else it.gap_to_target | default(none) %}
          {% set achieved = it.is_achieved if it.is_achieved is defined else (delta is not none and delta >= 0) %}
          {% if not achieved and row_ns.items | length < 5 %}
            {% set _ = row_ns.items.append({'item': it, 'level_code': 'L3'}) %}
            {% set row_ns.unmet = row_ns.unmet + 1 %}
            {% if it.accuracy is defined and it.accuracy is not none and (it.accuracy | float) < 60 %}{% set row_ns.danger = row_ns.danger + 1 %}{% else %}{% set row_ns.attention = row_ns.attention + 1 %}{% endif %}
          {% endif %}
        {% endfor %}

        {# 2) 未达标模块（直接用“模块”中文标签，不再暴露 L2） #}
        {% for it in l2_items %}
          {% set delta = it.delta_vs_target if it.delta_vs_target is defined else it.gap_to_target | default(none) %}
          {% set achieved = it.is_achieved if it.is_achieved is defined else (delta is not none and delta >= 0) %}
          {% if not achieved and row_ns.items | length < 5 %}
            {% set _ = row_ns.items.append({'item': it, 'level_code': 'L2'}) %}
            {% set row_ns.unmet = row_ns.unmet + 1 %}
            {% if it.accuracy is defined and it.accuracy is not none and (it.accuracy | float) < 60 %}{% set row_ns.danger = row_ns.danger + 1 %}{% else %}{% set row_ns.attention = row_ns.attention + 1 %}{% endif %}
          {% endif %}
        {% endfor %}

        {# 3) 未达标技能点 #}
        {% for it in l4_items %}
          {% set delta = it.delta_vs_target if it.delta_vs_target is defined else it.gap_to_target | default(none) %}
          {% set achieved = it.is_achieved if it.is_achieved is defined else (delta is not none and delta >= 0) %}
          {% if not achieved and row_ns.items | length < 5 %}
            {% set _ = row_ns.items.append({'item': it, 'level_code': 'L4'}) %}
            {% set row_ns.unmet = row_ns.unmet + 1 %}
            {% if it.accuracy is defined and it.accuracy is not none and (it.accuracy | float) < 60 %}{% set row_ns.danger = row_ns.danger + 1 %}{% else %}{% set row_ns.attention = row_ns.attention + 1 %}{% endif %}
          {% endif %}
        {% endfor %}

        {# 4) 已达标知识点/模块/技能点补足卡片明细 #}
        {% for it in l3_items %}
          {% set delta = it.delta_vs_target if it.delta_vs_target is defined else it.gap_to_target | default(none) %}
          {% set achieved = it.is_achieved if it.is_achieved is defined else (delta is not none and delta >= 0) %}
          {% if achieved and row_ns.items | length < 5 %}
            {% set _ = row_ns.items.append({'item': it, 'level_code': 'L3'}) %}
            {% set row_ns.achieved = row_ns.achieved + 1 %}
          {% endif %}
        {% endfor %}
        {% for it in l2_items %}
          {% set delta = it.delta_vs_target if it.delta_vs_target is defined else it.gap_to_target | default(none) %}
          {% set achieved = it.is_achieved if it.is_achieved is defined else (delta is not none and delta >= 0) %}
          {% if achieved and row_ns.items | length < 5 %}
            {% set _ = row_ns.items.append({'item': it, 'level_code': 'L2'}) %}
            {% set row_ns.achieved = row_ns.achieved + 1 %}
          {% endif %}
        {% endfor %}
        {% for it in l4_items %}
          {% set delta = it.delta_vs_target if it.delta_vs_target is defined else it.gap_to_target | default(none) %}
          {% set achieved = it.is_achieved if it.is_achieved is defined else (delta is not none and delta >= 0) %}
          {% if achieved and row_ns.items | length < 5 %}
            {% set _ = row_ns.items.append({'item': it, 'level_code': 'L4'}) %}
            {% set row_ns.achieved = row_ns.achieved + 1 %}
          {% endif %}
        {% endfor %}

        {% set domain_status = 'achieved' if row_ns.unmet == 0 else ('danger' if row_ns.danger > 0 else 'attention') %}
        {% set domain_status_text = '✓ 全部达标' if domain_status == 'achieved' else ('△ 需重点突破' if domain_status == 'danger' else '△ 有提升空间') %}

        <div class="m3-kp-drill__panel m3-kp-diagnostic-card m3-kp-diagnostic-card--{{ domain_status }}" data-domain-code="{{ d_code }}" data-domain-name="{{ d_name }}">
          <div class="m3-kp-diagnostic-card__header">
            <div class="m3-kp-diagnostic-card__avatar">{{ d_name[0] if d_name else '域' }}</div>
            <div class="m3-kp-diagnostic-card__heading">
              <div class="m3-kp-diagnostic-card__title">{{ d_name }}</div>
              <div class="m3-kp-diagnostic-card__meta">领域 · 共 {{ row_ns.items | length }} 个知识点已测评</div>
            </div>
            <div class="m3-kp-diagnostic-card__status m3-kp-diagnostic-card__status--{{ domain_status }}">{{ domain_status_text }}</div>
          </div>

          {% if row_ns.items | length == 0 %}
          <div class="m3-kp-diagnostic-card__empty">该领域暂无可展示的知识点明细</div>
          {% else %}
            {% if row_ns.unmet > 0 %}
            <div class="m3-kp-diagnosis-group">
              <div class="m3-kp-diagnosis-group__title m3-kp-diagnosis-group__title--unmet">⬇ 未达标（按优先级排列）</div>
              {% set group = namespace(i=0) %}
              {% for row in row_ns.items %}
                {% set it = row.item %}
                {% set delta = it.delta_vs_target if it.delta_vs_target is defined else it.gap_to_target | default(none) %}
                {% set achieved = it.is_achieved if it.is_achieved is defined else (delta is not none and delta >= 0) %}
                {% if not achieved %}
                  {% set group.i = group.i + 1 %}
                  {{ render_diagnosis_row(row, d_name, l2_items, l3_items, group.i) }}
                {% endif %}
              {% endfor %}
            </div>
            {% endif %}

            {% if row_ns.achieved > 0 %}
            <div class="m3-kp-diagnosis-group">
              <div class="m3-kp-diagnosis-group__title m3-kp-diagnosis-group__title--achieved">✓ 已达标</div>
              {% for row in row_ns.items %}
                {% set it = row.item %}
                {% set delta = it.delta_vs_target if it.delta_vs_target is defined else it.gap_to_target | default(none) %}
                {% set achieved = it.is_achieved if it.is_achieved is defined else (delta is not none and delta >= 0) %}
                {% if achieved %}
                  {{ render_diagnosis_row(row, d_name, l2_items, l3_items, loop.index) }}
                {% endif %}
              {% endfor %}
            </div>
            {% endif %}
          {% endif %}
        </div>
        {% endif %}
      {% endmacro %}

      {% if render_domain_keys | length > 0 %}
      {% set focus_ns = namespace(names=[]) %}
      {% for dk in render_domain_keys %}
        {% set panel = domain_panels[dk] | default({}, true) %}
        {% for it in panel.l3_items | default([], true) %}
          {% set delta = it.delta_vs_target if it.delta_vs_target is defined else it.gap_to_target | default(none) %}
          {% if delta is not none and delta < 0 and focus_ns.names | length < 2 and it.name_cn not in focus_ns.names %}
            {% set _ = focus_ns.names.append(it.name_cn) %}
          {% endif %}
        {% endfor %}
        {% for it in panel.l2_items | default([], true) %}
          {% set delta = it.delta_vs_target if it.delta_vs_target is defined else it.gap_to_target | default(none) %}
          {% if delta is not none and delta < 0 and focus_ns.names | length < 2 and it.name_cn not in focus_ns.names %}
            {% set _ = focus_ns.names.append(it.name_cn) %}
          {% endif %}
        {% endfor %}
      {% endfor %}
      <div class="m3-kp-drill__grid">
        <div class="m3-kp-diagnosis-header">
          <div class="m3-kp-diagnosis-header__subtitle">
            基于答题数据，按「领域→模块→知识点」三层定位掌握情况，目标线为 75%。
            {% if focus_ns.names | length > 0 %}建议优先突破 <strong>{{ focus_ns.names | join('、') }}</strong>。{% else %}当前展示领域整体掌握稳定，建议继续保持。{% endif %}
          </div>
          <div class="m3-kp-status-legend">
            <span class="m3-kp-status-legend__label">正确率状态：</span>
            <span class="m3-kp-status-legend__item"><i class="m3-kp-status-dot m3-kp-status-dot--danger"></i>差距较大（&lt;60%）</span>
            <span class="m3-kp-status-legend__item"><i class="m3-kp-status-dot m3-kp-status-dot--attention"></i>有待提升（60-75%）</span>
            <span class="m3-kp-status-legend__item"><i class="m3-kp-status-dot m3-kp-status-dot--achieved"></i>已达标（≥75%）</span>
          </div>
        </div>
        <div class="m3-kp-drill__panel-card">
          <div class="m3-kp-drill__panels{% if render_domain_keys | length == 4 %} m3-kp-drill__panels--grid-2x2{% endif %}">
            {% for dk in render_domain_keys %}
              {{ render_domain_panel(dk) }}
            {% endfor %}
          </div>
        </div>

        {# --- 无数据领域合并汇总块 --- #}
        {% if nodata_names | length > 0 %}
        <div class="m3-kp-drill__nodata-merge">
          <span class="m3-kp-drill__nodata-merge__label">数据不充分的领域：</span>
          {% for name in nodata_names %}
          <span class="m3-kp-drill__nodata-merge__name">{{ name }}</span>
          {%- if not loop.last %}、{% endif %}
          {% endfor %}
          <span class="m3-kp-drill__nodata-merge__text">
            — 以上 {{ nodata_names | length }} 个领域答题数据不足，暂未识别到具体的知识点薄弱点。建议补充相关领域的答题记录后再次诊断。
          </span>
        </div>
        {% endif %}
      </div><!-- /.m3-kp-drill__grid -->
      {% endif %}

    {% else %}
    {# 整体无数据时的兜底显示 #}
    <div class="m3-kp-drill__grid">
      <div class="m3-kp-drill__panel">
        <div class="m3-kp-drill__empty-state">
          暂无短板数据，无法进行知识点钻取分析
        </div>
      </div>
    </div><!-- /.m3-kp-drill__grid -->
    {% endif %}

  </div><!-- /.m3-kp-drill__container -->
</section>

{# =============================================================================
 # END OF TEMPLATE
 # ============================================================================= #}
