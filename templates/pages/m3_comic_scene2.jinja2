{# ==============================================================================
   m3_comic_scene2.jinja2 — 第 3 页: 场景2漫画 (学习成长→成绩突破)
   标题带与图片分离, 避免 PDF 中标题覆盖漫画
   ============================================================================== #}

{% set comic_image_path = comic_scene2_path | default('') %}

<div class="comic-page comic-page--scene2">
  <div class="comic-caption">
    <div class="comic-caption__eyebrow">学习情景</div>
    <div class="comic-caption__title">第三页 · 学习成长与成绩突破</div>
  </div>
  {% if comic_image_path %}
  <img
    src="{{ comic_image_path }}"
    alt="场景2漫画"
    class="comic-image"
  />
  {% else %}
  <div class="comic-placeholder">
    <div class="placeholder-icon">SCENE 2</div>
    <div class="placeholder-text">漫画图片加载失败</div>
  </div>
  {% endif %}
</div>
