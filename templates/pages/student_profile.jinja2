{# ==============================================================================
   student_profile.jinja2 — 第 4 页: 学生画像分析
   双区结构：整体情况 / 整体分析
   ============================================================================== #}

{% from 'macros/learning_blueprint_icons.jinja2' import lb_icon %}
{% set acc = summary.current_accuracy | default(0) | float %}
{% set target_acc = summary.target_accuracy | default(85) | float %}
{% set delta = summary.current_delta | default(0) | float %}
{% set trend = summary.current_trend | default('stable') %}
{% set student_name = meta.student_display_name | default('同学') %}
{% set subject = meta.subject_name | default('') %}
{% set subject_code = meta.subject | default('', true) | lower %}
{% set subject_label = subject | default('', true) %}
{% if not subject_label and subject_code in ['math', 'mathematics', '数学'] %}
  {% set subject_label = '数学' %}
{% elif not subject_label and subject_code in ['english', 'eng', '英语'] %}
  {% set subject_label = '英语' %}
{% endif %}
{% set title_subject = '' if subject_label and student_name.endswith(subject_label) else subject_label %}
{% if subject_label in ['数学', '英语'] or subject_code in ['math', 'mathematics', '数学', 'english', 'eng', '英语'] %}
  {% set profile_title = (subject_label | default('学生', true)) ~ '画像分析' %}
{% elif subject_label and student_name.endswith(subject_label) %}
  {% set profile_title = student_name ~ '画像分析' %}
{% else %}
  {% set profile_title = student_name ~ title_subject ~ '画像分析' %}
{% endif %}
{% set cover_meta = cover.cover_meta | default({}) %}
{% set student_grade = cover_meta.grade | default('--') %}
{% set student_city = meta.city_name | default(cover_meta.city_name | default(cover_meta.city | default('--'))) %}
{% set trend_map = {'up': '上升', 'down': '下降', 'stable': '稳定'} %}
{% set trend_label = trend_map[trend] if trend in trend_map else '稳定' %}

{# --- 数据完整性判断 / 目标达成判断 --- #}
{% set has_real_data = acc > 0 %}
{% set target_reached = has_real_data and target_acc > 0 and acc >= target_acc %}

{# --- 三档分类：如果已达到本次目标线，优先按“已达标/优秀”处理，避免出现“当前高于目标仍待追赶”的表述 --- #}
{% if target_reached or acc >= 85 %}
  {% set tier = 'excellent' %}
  {% set tier_label = '表现优秀' %}
{% elif acc < 60 %}
  {% set tier = 'need_major' %}
  {% set tier_label = '需大幅提升' %}
{% else %}
  {% set tier = 'room_grow' %}
  {% set tier_label = '有提升空间' %}
{% endif %}

{# --- 整体分析进度条：与 M6 当前学习阶段判定保持同一套标记/标签对齐逻辑 --- #}
{% set sp_current_rate = acc if has_real_data else 0 %}
{% set sp_clamped_rate = ([100, [0, sp_current_rate] | max] | min) | round(1) %}
{% set sp_clamped_target_rate = ([100, [0, target_acc] | max] | min) | round(1) %}
{% set sp_progress_css = (sp_clamped_rate | round(0) | int) if sp_clamped_rate == (sp_clamped_rate | round(0)) else sp_clamped_rate %}
{% set sp_target_progress_css = (sp_clamped_target_rate | round(0) | int) if sp_clamped_target_rate == (sp_clamped_target_rate | round(0)) else sp_clamped_target_rate %}
{% set sp_progress_gap = sp_clamped_rate - sp_clamped_target_rate if sp_clamped_rate >= sp_clamped_target_rate else sp_clamped_target_rate - sp_clamped_rate %}
{% set sp_markers_overlap = sp_progress_gap <= 10 or (target_reached and sp_progress_gap <= 15) %}
{% set sp_progress_edge_class = 'sp-progress-label--edge-start' if sp_clamped_rate <= 8 else ('sp-progress-label--edge-end' if sp_clamped_rate >= 92 else '') %}
{% set sp_target_edge_class = 'sp-progress-label--edge-start' if sp_clamped_target_rate <= 8 else ('sp-progress-label--edge-end' if sp_clamped_target_rate >= 92 else '') %}

{# --- 提取薄弱领域 --- #}
{% set weak_domains = [] %}
{% if domains is defined and domains.domain_items is defined %}
  {% for item in domains.domain_items %}
    {% if item.status | default('') in ['需加强', '需关注'] and item.has_data | default(true) %}
      {% set _ = weak_domains.append(item) %}
    {% endif %}
  {% endfor %}
{% endif %}

{% set weak_count = weak_domains | length %}
{% if weak_count >= 4 %}
  {% set sp_density = 'dense' %}
{% elif not has_real_data or weak_count <= 1 %}
  {% set sp_density = 'sparse' %}
{% else %}
  {% set sp_density = 'standard' %}
{% endif %}

{# --- 判断空数据原因 --- #}
{% set domain_count = domains.domain_items | default([]) | length %}
{% if not has_real_data and domain_count == 0 %}
  {% set empty_reason = 'no_data' %}
  {% set empty_message = '当前未采集到有效的答题数据，暂时无法生成稳定的学生画像。可能原因：尚未完成测评、答题记录未同步、或数据仍在处理中。' %}
  {% set empty_action = '建议先完成至少一套完整测评，确保有效答题记录达到一定数量后，再回到本页查看综合诊断。' %}
{% elif not has_real_data and domain_count > 0 %}
  {% set empty_reason = 'insufficient' %}
  {% set empty_message = '当前已有部分领域数据，但样本量仍不足以支撑完整的正确率分析和稳定结论。' %}
  {% set empty_action = '建议补充更多有效答题记录（建议每领域至少 5 题），再进行综合分析。' %}
{% else %}
  {% set empty_reason = 'ok' %}
{% endif %}

{% set gap_to_target = ((target_acc - acc) | abs) | round(0) | int %}
{% if target_reached %}
  {% set target_chip_text = '已达目标线' if gap_to_target == 0 else '已超目标 ' ~ gap_to_target ~ '%' %}
{% else %}
  {% set target_chip_text = '距目标 ' ~ gap_to_target ~ '%' %}
{% endif %}
{% set lead_focus = weak_domains[0].name_cn | default('核心领域') if weak_domains | length > 0 else '整体稳定性' %}
{% set secondary_focus = weak_domains[1].name_cn | default('次重点领域') if weak_domains | length > 1 else lead_focus %}
{% set focus_names = [] %}
{% for item in weak_domains %}
  {% if loop.index <= 3 %}
    {% set _ = focus_names.append(item.name_cn | default('领域' ~ loop.index)) %}
  {% endif %}
{% endfor %}
{% set focus_path = focus_names | join(' → ') if focus_names | length > 0 else '整体稳定性' %}
{% if weak_domains | length > 1 %}
  {% set focus_summary = lead_focus ~ '、' ~ secondary_focus %}
{% else %}
  {% set focus_summary = lead_focus %}
{% endif %}

{% if not has_real_data %}
  {% set hero_title = '当前还不能输出稳定的学生画像' %}
  {% set hero_text = empty_message %}
  {% set status_text = '数据待补充' %}
  {% set analysis_level_text = '样本不足，暂不能稳定判断整体水平。' %}
  {% set analysis_state_text = '已有记录，但状态结论仍不够可靠。' %}
  {% set analysis_gap_text = '数据补足前，不建议直接对照目标做差距判断。' %}
  {% set analysis_breakthrough_text = '先补足数据，再进入专项分析与提分动作。' %}
{% elif tier == 'need_major' %}
  {% set hero_title = '先补基础，再做结构性提升' %}
  {% set hero_text = summary.banner_text | default('当前多个关键模块仍低于目标线，建议先补最影响得分的基础环节。', true) %}
  {% set status_text = tier_label %}
  {% set analysis_level_text = '整体正确率离目标较远，当前应先打牢基础盘。' %}
  {% set analysis_state_text = '达标率偏低，多个模块尚未形成稳定得分。' %}
  {% set analysis_gap_text = '与目标仍有明显差距，先抓影响总分最大的短板。' %}
  {% set analysis_breakthrough_text = '优先从 ' ~ lead_focus ~ ' 入手，把最弱项先拉回基础线。' %}
{% elif tier == 'room_grow' %}
  {% set hero_title = '不是整体薄弱，而是少数模块在拉低结果' %}
  {% set hero_text = summary.banner_text | default('当前基础盘已经具备提分条件，下一步关键在于把最弱的几个领域补齐。', true) %}
  {% set status_text = tier_label %}
  {% set analysis_level_text = '当前已具备继续提分的基础，不需要从头重学。' %}
  {% set analysis_state_text = '整体在向上，但稳定性仍会被个别领域拖住。' %}
  {% set analysis_gap_text = '离目标还有 ' ~ gap_to_target ~ '% 差距，可通过专项补齐追赶。' %}
  {% set analysis_breakthrough_text = '优先处理 ' ~ focus_summary ~ '，提分效率会高于平均用力。' %}
{% else %}
  {% if target_reached %}
    {% set hero_title = '整体已达标，下一步是稳住优势并继续冲高' %}
    {% set hero_text = summary.banner_text | default('当前结果已经达到目标线，后续更适合保持强项并验证高难度题的稳定性。', true) %}
    {% set analysis_gap_text = '已达到目标线，后续关注高分稳定性。' if gap_to_target == 0 else '已超过目标线 ' ~ gap_to_target ~ '%，后续关注高分稳定性。' %}
  {% else %}
    {% set hero_title = '整体水平较稳，下一步补齐高分段差距' %}
    {% set hero_text = summary.banner_text | default('当前基础盘较稳，后续关键在于减少高分段失误并补齐少数薄弱点。', true) %}
    {% set analysis_gap_text = '离目标还有 ' ~ gap_to_target ~ '% 差距，重点处理高分段失误。' %}
  {% endif %}
  {% set status_text = tier_label %}
  {% set analysis_level_text = '当前整体已接近或达到目标线，基础盘较稳。' %}
  {% set analysis_state_text = '当前状态较好，重点在于减少偶发失误。' %}
  {% set analysis_breakthrough_text = '突破口在高难题验证、细节控制和优势巩固。' %}
{% endif %}

<div class="sp-page sp-page--{{ sp_density }}">
  <h1 class="sp-title">{{ lb_icon('profile', 'frame-title-icon') }}{{ profile_title }}</h1>

  <div class="module-content-card">

    {# ===================== 一、整体情况：速览 + 结论 + 读数重点 ===================== #}
    <div class="sp-group-head sp-group-head--overview">
      <h2 class="sp-group-title sp-group-title--overview">{{ lb_icon('profile', 'frame-section-icon') }}一、整体情况</h2>
    </div>
    <div class="sp-hero-unified">
      <h2 class="sp-hero-unified__title">{{ hero_title }}</h2>
      <p class="sp-hero-unified__text">{{ hero_text }}</p>
      <div class="sp-hero-unified__chips">
        {% if has_real_data %}
        <span class="sp-chip sp-chip--tier sp-chip--{{ tier }}">{{ status_text }}</span>
        <span class="sp-chip sp-chip--soft">{{ acc | int }}% 正确率</span>
        <span class="sp-chip sp-chip--soft">{{ target_chip_text }}</span>
        <span class="sp-chip sp-chip--soft">先抓 {{ lead_focus }}</span>
        {% else %}
        <span class="sp-chip sp-chip--soft">{{ status_text }}</span>
        <span class="sp-chip sp-chip--soft">已采集 {{ domain_count }} 个领域</span>
        {% endif %}
      </div>
    </div>

  <div class="sp-section-divider"></div>

  <section class="sp-section sp-section--analysis">
    <div class="sp-group-head">
      <h2 class="sp-group-title">{{ lb_icon('gauge', 'frame-section-icon') }}二、整体分析</h2>
    </div>

    <div class="sp-progress-panel" style="--sp-progress-current: {{ sp_progress_css }}%; --sp-progress-target: {{ sp_target_progress_css }}%;">
      <div class="sp-progress-panel__meta">
        <div class="sp-progress-panel__eyebrow">{{ lb_icon('gauge', 'frame-inline-icon') }}学习情况分析</div>
        {% if has_real_data %}
        {% if target_reached %}
        <div class="sp-progress-panel__title">当前 {{ acc | int }}%，已达成 {{ target_acc | int }}% 目标线，继续冲高</div>
        <p class="sp-progress-panel__text">目标线仅作达标参考，后续重点看高分稳定性与薄弱领域。</p>
        {% else %}
        <div class="sp-progress-panel__title">当前 {{ acc | int }}%，目标 {{ target_acc | int }}%，先抓 {{ lead_focus }}</div>
        <p class="sp-progress-panel__text">先看位置，再看后面的分析重点。</p>
        {% endif %}
        {% else %}
        <div class="sp-progress-panel__title">当前数据还不足以判断稳定位置</div>
        <p class="sp-progress-panel__text">先补足样本，再判断位置与差距。</p>
        {% endif %}
      </div>

      <div class="sp-progress sp-progress--panel{% if sp_markers_overlap %} sp-progress--split-labels{% endif %}">
        <div class="sp-progress-track">
          <div class="sp-progress-fill"></div>
          <div class="sp-progress-target sp-progress-target--current" title="当前节点"></div>
          <div class="sp-progress-target sp-progress-target--target{% if sp_markers_overlap %} sp-progress-target--overlap{% endif %}" title="目标节点"></div>
        </div>
        <div class="sp-progress-labels{% if sp_markers_overlap %} sp-progress-labels--stacked{% endif %}">
          <span class="sp-progress-label sp-progress-label--start">0%</span>
          <span class="sp-progress-label sp-progress-label--current{% if sp_progress_edge_class %} {{ sp_progress_edge_class }}{% endif %}{% if sp_markers_overlap %} sp-progress-label--stack-top{% endif %}"><span class="sp-progress-label__name">当前</span><span class="sp-progress-label__value">{% if has_real_data %}{{ sp_clamped_rate | round(0) | int }}%{% else %}暂无数据{% endif %}</span></span>
          <span class="sp-progress-label sp-progress-label--target{% if sp_target_edge_class %} {{ sp_target_edge_class }}{% endif %}{% if sp_markers_overlap %} sp-progress-label--stack-bottom{% endif %}"><span class="sp-progress-label__name">{% if target_reached %}目标线{% else %}目标{% endif %}</span><span class="sp-progress-label__value">{{ sp_clamped_target_rate | round(0) | int }}%</span></span>
          <span class="sp-progress-label sp-progress-label--end">100%</span>
        </div>
      </div>
    </div>

    <div class="sp-metric-grid">
      <div class="sp-metric-card">
        <div class="sp-metric-card__tag">{{ lb_icon('gauge', 'frame-metric-icon') }}当前水平</div>
        <div class="sp-metric-card__value sp-metric-card__value--current">{{ acc | int }}%</div>
        <div class="sp-metric-card__label">整体正确率</div>
        <div class="sp-metric-card__hint">{% if target_reached %}目标线 {{ target_acc | int }}%（已达成）{% else %}目标 {{ target_acc | int }}%{% endif %}</div>
        <p class="sp-metric-card__insight">{{ analysis_level_text }}</p>
      </div>
      <div class="sp-metric-card">
        <div class="sp-metric-card__tag">{{ lb_icon('shield', 'frame-metric-icon') }}当前状态</div>
        <div class="sp-metric-card__value">{{ summary.pass_rate_text | default('--') }}</div>
        <div class="sp-metric-card__label">达标率</div>
        <div class="sp-metric-card__hint">趋势 {{ trend_label }}</div>
        <p class="sp-metric-card__insight">{{ analysis_state_text }}</p>
      </div>
      <div class="sp-metric-card">
        <div class="sp-metric-card__tag">{{ lb_icon('gap', 'frame-metric-icon frame-metric-icon--warning') }}{% if target_reached %}目标达成{% else %}目标差距{% endif %}</div>
        <div class="sp-metric-card__value {{ 'sp-metric-card__value--pos' if target_reached else ('sp-metric-card__value--neg' if delta < 0 else 'sp-metric-card__value--pos') }}">{{ gap_to_target }}%</div>
        <div class="sp-metric-card__label">{% if target_reached %}{% if gap_to_target == 0 %}已达目标线{% else %}超目标线{% endif %}{% else %}距目标线{% endif %}</div>
        <div class="sp-metric-card__hint">{% if target_reached %}继续冲高{% else %}先看 {{ lead_focus }}{% endif %}</div>
        <p class="sp-metric-card__insight">{{ analysis_gap_text }}</p>
      </div>
      <div class="sp-metric-card">
        <div class="sp-metric-card__tag">{{ lb_icon('target', 'frame-metric-icon') }}突破口</div>
        <div class="sp-metric-card__value">{{ weak_count if has_real_data else domain_count }}</div>
        <div class="sp-metric-card__label">{{ '待突破领域' if has_real_data else '已采集领域' }}</div>
        <div class="sp-metric-card__hint">{{ '先补最弱项' if has_real_data else '继续补样本' }}</div>
        <p class="sp-metric-card__insight">{{ analysis_breakthrough_text }}</p>
      </div>
    </div>

    <div class="sp-analysis-grid">
      <div class="sp-analysis-card sp-analysis-card--weakness">
        <div class="sp-section-title">{{ lb_icon('warning', 'frame-inline-icon frame-inline-icon--warning') }}薄弱环节分析</div>

        {% if not has_real_data %}
        <div class="sp-empty-card">
          <div class="sp-empty-card__title">{{ '答题数据不足' if empty_reason == 'insufficient' else '暂无有效数据' }}</div>
          <p class="sp-empty-card__text">{{ empty_message }}</p>
          <div class="sp-empty-card__action">{{ empty_action }}</div>
        </div>
        {% elif weak_domains | length == 0 %}
        <div class="sp-empty-card sp-empty-card--good">
          <div class="sp-empty-card__title">未识别到明显薄弱领域</div>
          <p class="sp-empty-card__text">当前各领域表现均在目标线附近或以上，暂未检测到突出的薄弱环节，整体较为均衡。</p>
          <div class="sp-empty-card__action">可继续关注 M4 中的“需关注”项目，作为下一步巩固方向。</div>
        </div>
        {% else %}
        <div class="sp-weak-list">
          {% for item in weak_domains %}
          <div class="sp-weak-item">
            <div class="sp-weak-item__indicator {{ 'sp-weak-item__indicator--danger' if item.status == '需加强' else '' }}"></div>
            <div class="sp-weak-item__body">
              <div class="sp-weak-item__name">{{ item.name_cn | default('领域' ~ loop.index) }}</div>
              <div class="sp-weak-item__detail">
                <div class="sp-weak-item__meta">
                  <span class="sp-weak-item__acc">{{ item.accuracy_text | default('--') }}</span>
                  <span class="sp-weak-item__delta">{{ item.delta_text | default('') }}</span>
                </div>
                <span class="sp-weak-item__status-text {{ 'sp-weak-item__status-text--danger' if item.status == '需加强' else 'sp-weak-item__status-text--attention' }}">{{ item.status }}</span>
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>

    </div>
  </section>

  <div class="sp-section-divider"></div>

  </div><!-- /.module-content-card -->

</div>
