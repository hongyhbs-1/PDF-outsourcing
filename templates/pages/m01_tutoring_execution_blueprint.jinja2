{# ---------------------------------------------------------------------------
  Page 2: Tutoring Execution and Tracking Blueprint
  Required context key: execution_blueprint
--------------------------------------------------------------------------- #}
{% from 'macros/learning_blueprint_icons.jinja2' import lb_icon %}
{% set bp = execution_blueprint %}
<section class="m0-module-page learning-blueprint-page execution-blueprint-page">
  <div class="edge-tabs-mask"></div>
  <header class="lb-header compact">
    <h1>{{ bp.headline.title }}</h1>
    <div class="lb-subtitle"><span></span>{{ bp.headline.subtitle }}<span></span></div>
    <div class="lb-banner">{{ bp.headline.slogan }}</div>
  </header>

  <main class="execution-grid">
    <section class="lb-panel exec-panel drill-structure-panel">
      <h2><b>07</b> {{ lb_icon('tree', 'lb-title-icon') }}知识点钻取结构 <small>能力树</small></h2>
      <p class="panel-lead">从领域到考点逐层定位，精准找到需要补强的知识点。</p>
      <div class="drill-head wide"><span>{{ bp.meta.l1_label }}</span><i></i><span>L2（知识模块）</span><i></i><span>L3（知识点）</span><i></i><span>L4（考点细节）</span></div>
      <div class="focus-paths">
        {% for row in bp.focus_paths %}
        {% set domain_icon = '' %}
        {% if '几何' in row.domain %}{% set domain_icon = 'domain-geometry' %}
        {% elif '代数' in row.domain or '方程' in row.domain or '不等式' in row.domain %}{% set domain_icon = 'domain-algebra' %}
        {% elif '函数' in row.domain %}{% set domain_icon = 'domain-function' %}
        {% elif '统计' in row.domain or '概率' in row.domain %}{% set domain_icon = 'domain-statistics' %}
        {% elif '数论' in row.domain or '数与' in row.domain %}{% set domain_icon = 'domain-number' %}
        {% elif '应用' in row.domain %}{% set domain_icon = 'domain-application' %}{% endif %}
        <div class="focus-row state-{{ row.state }}">
          <span class="drill-domain">{% if domain_icon %}{{ lb_icon(domain_icon, 'drill-row-icon drill-domain-icon') }}{% endif %}{{ row.domain }}</span><i></i>
          <span>{{ row.l2 }}</span><i></i>
          <span>{{ row.l3 }}</span><i></i>
          <span class="last">{{ row.l4 }}</span>
        </div>
        {% endfor %}
      </div>
      <div class="state-legend compact-legend">
        <span class="dot achieved">已达标</span><span class="dot attention">需关注</span><span class="dot improve">需加强</span><span class="dot nodata">数据不足</span>
      </div>
    </section>

    <section class="lb-panel exec-panel improvement-path-panel">
      <h2><b>08</b> {{ lb_icon('target', 'lb-title-icon lb-title-icon--success') }}提分路径图 <small>{{ bp.stage_plan.current_text }} → {{ bp.stage_plan.target_text }}</small></h2>
      <p class="panel-lead">分阶段提升，稳步达成目标。</p>
      <div class="stage-flow">
        {% for stage in bp.stage_plan.stages %}
        <div class="exec-stage stage-{{ stage.state }}">
          <div class="stage-icon stage-icon--{{ stage.state }}">
            {% if stage.state == 'foundation' %}{{ lb_icon('flag', 'stage-flow-icon') }}{% elif stage.state == 'improve' %}{{ lb_icon('growth', 'stage-flow-icon') }}{% else %}{{ lb_icon('trophy', 'stage-flow-icon') }}{% endif %}
          </div>
          <strong>{{ stage.range }}</strong>
          <em>{{ stage.title }}</em>
          <span>{{ stage.target_text }}</span>
        </div>
        {% if not loop.last %}<div class="stage-flow-arrow"></div>{% endif %}
        {% endfor %}
      </div>
      <div class="stage-details">
        {% for stage in bp.stage_plan.stages %}
        <div class="stage-detail stage-{{ stage.state }}">
          <h3>{% if stage.state == 'foundation' %}{{ lb_icon('flag', 'stage-detail-icon') }}{% elif stage.state == 'improve' %}{{ lb_icon('growth', 'stage-detail-icon') }}{% else %}{{ lb_icon('trophy', 'stage-detail-icon stage-detail-icon--sprint') }}{% endif %}{{ stage.no }}</h3>
          <ul>{% for text in stage["items"] %}<li>{{ text }}</li>{% endfor %}</ul>
        </div>
        {% endfor %}
      </div>
      <div class="path-note">{{ lb_icon('bulb', 'note-icon') }}根据学习进度与检测结果动态调整路径，确保每一步都有明确目标。</div>
    </section>

    <section class="lb-panel exec-panel data-engine-panel">
      <h2><b>09</b> {{ lb_icon('shield', 'lb-title-icon') }}数据来源说明</h2>
      <p class="panel-lead">基于真实试卷数据生成，结论可信赖。</p>
      <div class="data-quality-card">
        <h3>{{ lb_icon('shield', 'data-card-icon data-card-icon--success') }} 数据质量说明</h3>
        <p>本报告基于 <strong>{{ bp.data_engine.paper_count }} 套试卷</strong>、<strong>{{ bp.data_engine.valid_questions }} 道有效大题</strong>、<strong>{{ bp.data_engine.domain_modules }} 个领域模块</strong>生成，数据可信度评估为 <strong>{{ bp.data_engine.reliability_level }}</strong>{% if bp.data_engine.stars %}（{% for i in range(bp.data_engine.stars) %}★{% endfor %}）{% endif %}。</p>
      </div>
      <div class="pipeline-flow">
        {% for step in bp.data_engine.pipeline %}
        <span>{% if loop.index == 1 %}{{ lb_icon('collect', 'pipeline-icon') }}{% elif loop.index == 2 %}{{ lb_icon('clean', 'pipeline-icon') }}{% elif loop.index == 3 %}{{ lb_icon('feature', 'pipeline-icon') }}{% elif loop.index == 4 %}{{ lb_icon('ai', 'pipeline-icon') }}{% else %}{{ lb_icon('output', 'pipeline-icon') }}{% endif %}{{ step }}</span>{% if not loop.last %}<i></i>{% endif %}
        {% endfor %}
      </div>
      <div class="engine-source">{{ lb_icon('data', 'note-icon') }}{{ bp.data_engine.source_text }}</div>
    </section>

    <section class="lb-panel exec-panel support-system-panel">
      <h2><b>10</b> {{ lb_icon('support', 'lb-title-icon') }}家长配合要点</h2>
      <p class="panel-lead">帮助孩子提升，家长可以这样做。</p>
      <div class="support-triangle">
        <svg viewBox="0 0 440 300" role="img" aria-label="老师家长学生三方协同">
          <defs>
            <marker id="arrowHead" markerWidth="8" markerHeight="8" refX="5" refY="3" orient="auto">
              <path d="M0,0 L0,6 L6,3 z" />
            </marker>
          </defs>
          <line x1="220" y1="68" x2="92" y2="230" />
          <line x1="220" y1="68" x2="348" y2="230" />
          <line x1="92" y1="230" x2="348" y2="230" />
          <g class="role-node teacher" transform="translate(220,62)"><circle class="role-shell" r="43"/><g class="role-glyph"><circle class="glyph-head" cx="0" cy="-12" r="7"/><path class="glyph-body" d="M-14 10c3-12 11-17 14-17s11 5 14 17"/><path class="glyph-extra" d="M14 -10h12v16H14"/></g><text y="28">老师</text></g>
          <g class="role-node parent" transform="translate(92,230)"><circle class="role-shell" r="43"/><g class="role-glyph"><circle class="glyph-head" cx="-7" cy="-12" r="6"/><circle class="glyph-head" cx="8" cy="-10" r="5"/><path class="glyph-body" d="M-20 10c3-11 10-16 18-16s14 5 17 16"/></g><text y="28">家长</text></g>
          <g class="role-node student" transform="translate(348,230)"><circle class="role-shell" r="43"/><g class="role-glyph"><path class="glyph-cap" d="M-20 -12 0 -22l20 10L0 -2-20-12Z"/><path class="glyph-extra" d="M-12 -5v11c7 5 17 5 24 0V-5"/></g><text y="28">学生</text></g>
          <g class="center-node" transform="translate(220,178)"><circle r="34"/><text y="5">共同成长</text></g>
        </svg>
        <div class="support-notes teacher-notes"><ul>{% for item in bp.support_system.teacher_items %}<li>{{ item }}</li>{% endfor %}</ul></div>
        <div class="support-notes parent-notes"><ul>{% for item in bp.support_system.parent_items %}<li>{{ item }}</li>{% endfor %}</ul></div>
        <div class="support-notes student-notes"><ul>{% for item in bp.support_system.student_items %}<li>{{ item }}</li>{% endfor %}</ul></div>
      </div>
      <div class="support-summary">{{ lb_icon('support', 'note-icon') }}{{ bp.support_system.summary }}</div>
    </section>

    <section class="execution-axis-panel">
      <h2><b>11</b> {{ lb_icon('track', 'lb-title-icon') }}每周练习建议</h2>
      <div class="axis-flow">
        {% for stage in bp.axis.stages %}
        <div class="axis-stage {% if stage.name == bp.axis.active_stage %}active{% endif %}">
          <div class="axis-icon icon-{{ stage.icon }}">{{ lb_icon(stage.icon, 'axis-stage-icon') }}</div>
          <strong>{{ stage.name }}</strong>
          <span>{{ stage.desc }}</span>
        </div>
        {% if not loop.last %}<i class="axis-arrow"></i>{% endif %}
        {% endfor %}
      </div>
      <div class="axis-note">{{ lb_icon('track', 'note-icon') }}每天练习15-30分钟，持续巩固薄弱知识点。</div>
      <div class="axis-check-strip">
        <span>{{ lb_icon('track', 'axis-check-icon') }}每日练习</span>
        <span>{{ lb_icon('evidence', 'axis-check-icon') }}错题整理</span>
        <span>{{ lb_icon('target', 'axis-check-icon') }}定期自测</span>
        <span>{{ lb_icon('support', 'axis-check-icon') }}家长督促</span>
      </div>
    </section>
  </main>

</section>
