{# ==============================================================================
   m2_comic_scene1.jinja2 — 第 2 页: 场景1漫画 (学习困境→寻求帮助)
   标题带与图片分离, 避免 PDF 中标题覆盖漫画
   ============================================================================== #}

{% set comic_image_path = comic_scene1_path | default('') %}

<div class="comic-page comic-page--scene1">
  <div class="comic-caption">
    <div class="comic-caption__eyebrow">学习情景</div>
    <div class="comic-caption__title">第二页 · 学习困境与寻求帮助</div>
  </div>
  {% if comic_image_path %}
  <img
    src="{{ comic_image_path }}"
    alt="场景1漫画"
    class="comic-image"
  />
  {% else %}
  <div class="comic-placeholder">
    <div class="placeholder-icon">SCENE 1</div>
    <div class="placeholder-text">漫画图片加载失败</div>
  </div>
  {% endif %}
</div>
