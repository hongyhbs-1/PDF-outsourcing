         }
       ]
     },
     "papers": {
       "items": [
         { "index": 1, "paper_name": "2024年浦东新区一模卷", "question_count": 25, "source_file": "浦东一模.pdf" },
         { "index": 2, "paper_name": "2024年徐汇区一模卷", "question_count": 25, "source_file": "徐汇一模.pdf" }
       ],
