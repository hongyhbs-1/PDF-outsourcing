       { "name": "置信度", "desc": "基于题量判定：≥20题[高]、10-19题[中]、<10题[低]" },
       { "name": "优先级", "desc": "P0(紧急)/P1(重点)/P2(适时)，综合差距与考频" },
       { "name": "城市排名", "desc": "基于历年真题统计的知识点重要性排序" },
       { "name": "年份覆盖率", "desc": "该知识点出现的年份数/统计总年份数" }
     ]
   }
   ----------------------------------------------------------------------------- #}

{% from 'macros/learning_blueprint_icons.jinja2' import lb_icon %}

{# -----------------------------------------------------------------------------
   辅助宏定义 (Helper Macros)
   ----------------------------------------------------------------------------- #}

{# 空值防护：返回值或默认占位符 #}
{% macro safe_value(val, default='--') %}
  {{- val if val is not none and val != '' else default -}}
{% endmacro %}

{# 状态类名映射：根据难度级别返回对应CSS类 #}
{% macro status_class(level) %}
  {%- if level == 'easy' -%}m8-appendix-status--good
  {%- elif level == 'medium' -%}m8-appendix-status--ok
  {%- elif level == 'hard' -%}m8-appendix-status--need
  {%- else -%}m8-appendix-status--nodata
  {%- endif -%}
{% endmacro %}

{# 进度条填充类名映射 #}
{% macro bar_fill_class(level) %}
  {%- if level == 'easy' -%}m8-appendix-bar-fill--easy
  {%- elif level == 'medium' -%}m8-appendix-bar-fill--medium
  {%- elif level == 'hard' -%}m8-appendix-bar-fill--hard
  {%- else -%}
  {%- endif -%}
{% endmacro %}

{# 安全百分比：限制在0-100范围内 #}
{% macro safe_ratio(ratio) %}
  {%- if ratio is not none -%}
    {{- [0, [ratio, 100] | min] | max -}}
  {%- else -%}
    0
  {%- endif -%}
{% endmacro %}


{# =============================================================================
   模板主体开始
   ============================================================================= #}

{# meta 变量定义 - 确保兼容性 #}
{% set meta = meta | default({}) %}
{% set raw_analysis_rows = analysis_scope.rows if analysis_scope and analysis_scope.rows else [] %}
{% if raw_analysis_rows is mapping %}
  {% set analysis_label_map = {
    'report_id': '报告编号',
    'generated_date': '生成日期',
    'question_count_text': '分析题量',
    'data_source_desc': '数据来源',
    'knowledge_system': '知识点体系'
  } %}
  {% set analysis_rows = [] %}
  {% for key, value in raw_analysis_rows.items() %}
    {% set _ = analysis_rows.append({
      'label': analysis_label_map.get(key, key),
      'value': value
    }) %}
  {% endfor %}
{% else %}
  {% set analysis_rows = raw_analysis_rows %}
{% endif %}
{% set paper_items = papers.get('items', []) if papers else [] %}
{% set metric_count = metric_definitions | length if metric_definitions else 0 %}
{% if paper_items | length <= 1 and metric_count <= 2 %}
  {% set m8_density = 'sparse' %}
{% elif paper_items | length >= 2 or metric_count >= 6 %}
  {% set m8_density = 'dense' %}
{% else %}
  {% set m8_density = 'standard' %}
{% endif %}

<div class="m8-appendix-page m8-appendix-page--{{ m8_density }}">

  {# ---------------------------------------------------------------------------
     页面主体 (页眉已由 running header/footer 统一, T14-Phase4 删除内置页眉)
     --------------------------------------------------------------------------- #}
  <div class="m8-appendix-body">

    {# -------------------------------------------------------------------------
       3.1 页面标题
       ------------------------------------------------------------------------- #}
    <div class="m8-appendix-title">
      <h1 class="m8-appendix-title__text">
        {{ lb_icon('paper', 'frame-title-icon') }}附录：试卷难度分布与分析依据
      </h1>
      <div class="m8-appendix-title__underline"></div>
    </div>

    <div class="module-content-card">

    {# -------------------------------------------------------------------------
       3.3 模块二：难度分布统计
       ------------------------------------------------------------------------- #}
    {% if difficulty and difficulty.get('items', []) | length > 0 %}
    <section class="m8-appendix-panel">
      <div class="m8-appendix-panel__titlebar">{{ lb_icon('module', 'frame-inline-icon') }} 难度分布统计</div>

      {# 3.3.1 统计表格 #}
      <table class="m8-appendix-table m8-appendix-difficulty-table">
        <thead>
          <tr>
            <th>难度</th>
            <th>题量</th>
            <th>占比</th>
            <th>正确率</th>
            <th>状态</th>
          </tr>
        </thead>
        <tbody>
          {% for item in difficulty.get('items', []) %}
          <tr>
            <td>{{ safe_value(item.name_cn) }}</td>
            <td>{{ safe_value(item.count) }}{% if item.count is not none %}题{% endif %}</td>
            <td>{{ safe_value(item.ratio) }}{% if item.ratio is not none %}%{% endif %}</td>
            <td>{{ safe_value(item.accuracy) }}{% if item.accuracy is not none %}%{% endif %}</td>
            <td>
              <span class="m8-appendix-status {{ status_class(item.level) }}">
                {{ safe_value(item.status_text) }}
              </span>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>

      {# 3.3.2 占比条形进度条 #}
      <div class="m8-appendix-bar-list">
        {% for item in difficulty.get('items', []) %}
        <div class="m8-appendix-bar-row">
          <div class="m8-appendix-bar-label">{{ safe_value(item.name_cn) }}</div>
          <div class="m8-appendix-bar-track">
            <div class="m8-appendix-bar-fill {{ bar_fill_class(item.level) }}"
                 style="width: {{ safe_ratio(item.ratio) }}%;"></div>
          </div>
          <div class="m8-appendix-bar-value">
            {% if item.ratio is not none %}{{ item.ratio }}%{% else %}--{% endif %}
          </div>
        </div>
        {% endfor %}
      </div>
    </section>
    {% else %}
    {# 难度分布无数据时的占位（可选择隐藏或显示提示） #}
    {#
    <section class="m8-appendix-panel">
      <div class="m8-appendix-panel__titlebar">难度分布统计</div>
      <div class="m8-appendix-empty">暂无难度分布数据</div>
    </section>
    #}
    {% endif %}

    {# -------------------------------------------------------------------------
       3.5 模块四：指标释义 (双栏紧凑布局)
       ------------------------------------------------------------------------- #}
    {% if metric_definitions and metric_definitions | length > 0 %}
    <section class="m8-appendix-panel">
      <div class="m8-appendix-panel__titlebar">{{ lb_icon('data', 'frame-inline-icon') }} 指标释义</div>

      <div class="m8-metrics-grid">
        {% for metric in metric_definitions %}
        <div class="m8-metric-item">
          <div class="m8-metric-item__name">{{ safe_value(metric.name) }}</div>
          <div class="m8-metric-item__desc">{{ safe_value(metric.desc) }}</div>
        </div>
        {% endfor %}
      </div>
    </section>
    {% else %}
    {# 指标释义无数据时可选择隐藏 #}
    {% endif %}

    {# -------------------------------------------------------------------------
       3.2 模块一：分析范围
       ------------------------------------------------------------------------- #}
    <section class="m8-appendix-panel">
      <div class="m8-appendix-panel__titlebar">{{ lb_icon('map', 'frame-inline-icon') }} 分析范围</div>
      
      {% if analysis_rows | length > 0 %}
      <table class="m8-appendix-table m8-appendix-kv-table">
        <tbody>
          {% for row in analysis_rows %}
          <tr>
            <th>{{ safe_value(row.label) }}</th>
            <td>{{ safe_value(row.value) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      {# 空数据兜底 #}
      <div class="m8-appendix-empty">暂无分析范围数据</div>
      {% endif %}
    </section>

    {# -------------------------------------------------------------------------
       3.4 模块三：试卷/批次清单
       ------------------------------------------------------------------------- #}
    <section class="m8-appendix-panel">
      <div class="m8-appendix-panel__section-title">{{ lb_icon('paper', 'frame-inline-icon') }} 试卷/批次清单</div>
      
      {% if papers and papers.get('items', []) | length > 0 %}
      <table class="m8-appendix-table m8-appendix-papers-table">
        <thead>
          <tr>
            <th>序号</th>
            <th>试卷名称</th>
            <th>题量</th>
            <th>来源文件</th>
          </tr>
        </thead>
        <tbody>
          {% for paper in papers.get('items', []) %}
          <tr>
            <td>{{ safe_value(paper.index, loop.index) }}</td>
            <td>{{ safe_value(paper.paper_name) }}</td>
            <td>{{ safe_value(paper.question_count) }}{% if paper.question_count is not none %}题{% endif %}</td>
            <td>{{ safe_value(paper.source_file) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      
      {# 合计行 #}
      <div class="m8-appendix-table-summary">
        合计：{{ safe_value(papers.total_questions, 0) }}题 / {{ safe_value(papers.total_papers, 0) }}份试卷
      </div>

      {# 说明注释 #}
      {# V3-3: 脚注左竖线 + 序号对齐 (与 m_overview 一致) #}
      <div class="m8-appendix-table-notes" style="margin-top: 8px; font-size: 12px; color: #888; line-height: 1.6; border-left: 3px solid #D9D9D9; padding-left: 10px;">
        <p style="margin: 2px 0;">注：1. 学生未解答的题目不计入分析数据，实际分析题量以合计数为准；</p>
        <p style="margin: 2px 0; padding-left: 2.5em;">2. 试卷名称缺失时，相关题目统一归入"用户上传试卷"中。</p>
      </div>
      {% else %}
      {# 空数据兜底 #}
      <div class="m8-appendix-empty">暂无试卷数据</div>
      {% endif %}
    </section>

    {% if m8_density != 'dense' %}
    <div class="m8-appendix-usage">
      <div class="m8-appendix-usage__title">{{ lb_icon('support', 'frame-inline-icon') }} 附录使用说明</div>
      <div class="m8-appendix-usage__text">
        本附录用于说明分析范围、样本来源和指标口径。阅读正文时，可结合试卷清单确认样本覆盖，再结合指标释义理解各模块中的正确率、目标线和优先级等结论。
      </div>
    </div>
    {% endif %}

  </div>{# end .m8-appendix-body #}

    </div><!-- /.module-content-card -->
</div>{# end .m8-appendix-page #}

{# =============================================================================
   模板主体结束
   ============================================================================= #}
