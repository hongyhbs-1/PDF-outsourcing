{% from 'macros/learning_blueprint_icons.jinja2' import lb_icon %}

{# ========================================================================
   宏定义: Macro Definitions
   ======================================================================== #}

{#- 安全获取嵌套值 -#}
{% macro safe_get(obj, key, default='') %}
  {{- obj[key] if obj and key in obj and obj[key] is not none else default -}}
{% endmacro %}

{#- 概览卡片图标 SVG -#}
{% macro icon_questions() %}
<svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect x="6" y="8" width="32" height="28" rx="3" stroke="currentColor" stroke-width="2"/>
  <path d="M12 16H32M12 22H28M12 28H24" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
</svg>
{% endmacro %}

{% macro icon_knowledge() %}
<svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
  <circle cx="22" cy="10" r="4" stroke="currentColor" stroke-width="2"/>
  <circle cx="10" cy="28" r="4" stroke="currentColor" stroke-width="2"/>
  <circle cx="22" cy="28" r="4" stroke="currentColor" stroke-width="2"/>
  <circle cx="34" cy="28" r="4" stroke="currentColor" stroke-width="2"/>
  <path d="M22 14V24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
  <path d="M22 24L10 24M22 24L34 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
</svg>
{% endmacro %}

{% macro icon_coverage() %}
<svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
  <circle cx="22" cy="22" r="16" stroke="currentColor" stroke-width="2"/>
  <path d="M22 10V22L30 30" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  <circle cx="22" cy="22" r="3" fill="currentColor"/>
</svg>
{% endmacro %}

{#- 告警图标 SVG -#}
{% macro icon_warning() %}
<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M10 2L18 17H2L10 2Z" stroke="currentColor" stroke-width="1.5" fill="none"/>
  <path d="M10 8V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
  <circle cx="10" cy="14" r="1" fill="currentColor"/>
</svg>
{% endmacro %}

{% macro icon_info() %}
<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
  <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5"/>
  <path d="M10 9V14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
  <circle cx="10" cy="6" r="1" fill="currentColor"/>
</svg>
{% endmacro %}

{% macro icon_check() %}
<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
  <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5"/>
  <path d="M6 10L9 13L14 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
{% endmacro %}

{#- 根据告警类型获取图标 -#}
{% macro get_warning_icon(icon_type) -%}
  {%- if icon_type == 'warning' -%}
    {{- icon_warning() -}}
  {%- elif icon_type == 'check' -%}
    {{- icon_check() -}}
  {%- else -%}
    {{- icon_info() -}}
  {%- endif -%}
{%- endmacro %}

{# ========================================================================
   主模板开始
   ======================================================================== #}

{#- 获取section数据 -#}
{# 根据schema，数据路径为: data_reliability.section_4_coverage #}
{# meta 变量定义 - 确保兼容性 #}
{% set meta = meta | default({}) %}
{% set section = data_reliability.section_4_coverage if data_reliability and data_reliability.section_4_coverage else {} %}
{% set stats = section.stats if section.stats else {} %}
{% set coverage_table = section.coverage_table if section.coverage_table else {} %}
{% set data_insufficient = section.data_insufficient if section.data_insufficient else {} %}
{% set quality_assessment = section.quality_assessment if section.quality_assessment else {} %}
{% set warnings_detail = section.warnings_detail if section.warnings_detail else {} %}
{% set low_sample = data_insufficient.low_sample if data_insufficient.low_sample else {} %}
{% set low_sample_items = low_sample['items'] if low_sample and 'items' in low_sample else [] %}
{% set uncovered_core = data_insufficient.uncovered_core if data_insufficient.uncovered_core else {} %}
{% set uncovered_items = uncovered_core['items'] if uncovered_core and 'items' in uncovered_core else [] %}
{% set coverage_rows = coverage_table.rows | default([], true) %}
{% set coverage_count = coverage_rows | length %}
{% set quality_metrics = quality_assessment.metrics | default([], true) %}
{% set data_coverage_rate = quality_metrics[0].value_pct if quality_metrics | length > 0 else 90 %}
{% set high_confidence_rate = quality_metrics[1].value_pct if quality_metrics | length > 1 else 75 %}
{% set freshness_rate = quality_metrics[2].value_pct if quality_metrics | length > 2 else 100 %}
{% set _subject_code_m7 = meta.subject | default('', true) | lower %}
{% set _subject_name_m7 = meta.subject_name | default('', true) %}
{% set _subject_text_m7 = (_subject_code_m7 ~ ' ' ~ _subject_name_m7) | lower %}
{% set _is_english_m7 = 'english' in _subject_text_m7 or '英语' in _subject_text_m7 %}
{% set representative_l2_count = coverage_count %}
{# T019-A: dense / compact 触发逻辑已移除 — 数据不足与未覆盖明细已迁移到 M8 附录，
   M7 只保留汇总句。coverage_rows 完整渲染（不再 hidden）。 #}
{% set data_supplement_summary = data_supplement_summary | default({
  'low_sample_count': low_sample_items | length,
  'uncovered_count': uncovered_items | length,
  'has_supplement': (low_sample_items | length > 0) or (uncovered_items | length > 0)
}, true) %}

<div class="m7-data-reliability">

  {# ====================================================================
     Title: 页面主标题
     ==================================================================== #}
  <h1 class="report-page-title m7-data-reliability__title">
    {% set _m7_chapter_no = '八' if _has_m9_detail | default(false) else '七' %}
    {{ lb_icon('shield', 'frame-title-icon') }}{{ _m7_chapter_no }}、{{ section.title | default('数据可信度说明', true) }}
  </h1>

  <section class="m7-core-conclusion">
    <div class="m7-core-conclusion__label">{{ lb_icon('shield', 'frame-conclusion-icon') }}本页核心结论</div>
    <div class="m7-core-conclusion__text">
      {% if _is_english_m7 %}
      原始输入已识别为{{ stats.total_questions | default('--', true) }}题，并归因覆盖 {{ stats.l2_covered | default('--', true) }} / {{ stats.l2_total | default('--', true) }} 个 L2 模块（本页统计 {{ representative_l2_count }} 个代表模块），说明试卷识别与知识点解析可追溯；批改归因通过题量、置信度和分布条逐项校验；报告结论由覆盖率共同支撑；最终结果同时标出{{ low_sample_items | length }}个样本不足项和{{ uncovered_items | length }}个未覆盖核心考点，补齐后可复评，形成可信背书。
      {% else %}
      原始输入已识别为{{ stats.total_questions | default('--', true) }}题，并归因覆盖 {{ stats.l2_covered | default('--', true) }}/{{ stats.l2_total | default('--', true) }} 个 L2 模块（本页统计 {{ representative_l2_count }} 个代表模块），说明试卷识别与知识点解析可追溯；批改归因通过题量、置信度和分布条逐项校验；报告结论由{{ data_coverage_rate }}% 数据覆盖率、{{ high_confidence_rate }}% 高置信度占比、{{ freshness_rate }}% 数据时效性共同支撑；最终结果同时标出{{ low_sample_items | length }}个样本不足项和{{ uncovered_items | length }}个未覆盖核心考点，补齐后可复评，形成可信背书。
      {% endif %}
    </div>
  </section>

  <div class="module-content-card">

  {# ====================================================================
     Section 1: 数据概览
     ==================================================================== #}
  <section class="m7-report-box">
    <div class="m7-report-box__inner">
      <h2 class="m7-section-title">{{ lb_icon('data', 'frame-section-icon') }} 一、原始输入识别与数据概览</h2>

      <div class="m7-overview-cards">
        {# --- 卡片1: 分析题量 --- #}
        <div class="m7-overview-card">
          <div class="m7-overview-card__icon">
            {{ icon_questions() }}
          </div>
          <div class="m7-overview-card__title">分析题量</div>
          <div class="m7-overview-card__value">
            <span class="m7-overview-card__num">
              {{ stats.total_questions | default('--', true) }}
            </span>
            <span class="m7-overview-card__unit">题</span>
          </div>
          {% if stats.question_tag_text %}
          <span class="m7-tag m7-tag--{{ stats.question_tag_class | default('warning') }}">
            <span>{{ stats.question_tag_text }}</span>
            {% if stats.question_tag_class == 'sufficient' %}
            <span class="m7-tag__check">✓</span>
            {% endif %}
          </span>
          {% endif %}
        </div>

        {# --- 卡片2: 知识点数量 --- #}
        <div class="m7-overview-card m7-overview-card--kp-count">
          <div class="m7-overview-card__icon">
            {{ icon_knowledge() }}
          </div>
          <div class="m7-overview-card__title">知识点数量</div>
          <div class="m7-overview-card__kp-levels">
            {# L1: 固定6个领域 #}
            <div class="m7-kp-level-row">
              <span class="m7-kp-level-badge m7-kp-level-badge--l1">L1</span>
              <span class="m7-kp-level-label">领域</span>
              <span class="m7-kp-level-num">6</span>
              <span class="m7-kp-level-unit">个</span>
            </div>
            {# L2: 使用 stats.l2_total #}
            <div class="m7-kp-level-row">
              <span class="m7-kp-level-badge m7-kp-level-badge--l2">L2</span>
              <span class="m7-kp-level-label">模块</span>
              {% if stats.l2_total %}
              <span class="m7-kp-level-num">{{ stats.l2_total }}</span>
              {% else %}
              <span class="m7-kp-level-num m7-no-data">--</span>
              {% endif %}
              <span class="m7-kp-level-unit">个</span>
            </div>
            {# L3: 使用 stats.l3_total #}
            <div class="m7-kp-level-row">
              <span class="m7-kp-level-badge m7-kp-level-badge--l3">L3</span>
              <span class="m7-kp-level-label">知识点</span>
              {% if stats.l3_total %}
              <span class="m7-kp-level-num">{{ stats.l3_total }}</span>
              {% else %}
              <span class="m7-kp-level-num m7-no-data">--</span>
              {% endif %}
              <span class="m7-kp-level-unit">个</span>
            </div>
            {# L4: 使用 stats.l4_total #}
            <div class="m7-kp-level-row">
              <span class="m7-kp-level-badge m7-kp-level-badge--l4">L4</span>
              <span class="m7-kp-level-label">技能点</span>
              {% if stats.l4_total %}
              <span class="m7-kp-level-num">{{ stats.l4_total }}</span>
              {% else %}
              <span class="m7-kp-level-num m7-no-data">--</span>
              {% endif %}
              <span class="m7-kp-level-unit">个</span>
            </div>
          </div>
        </div>

        {# --- 卡片3: L2知识点覆盖 --- #}
        <div class="m7-overview-card">
          <div class="m7-overview-card__icon">
            {{ icon_coverage() }}
          </div>
          <div class="m7-overview-card__title">L3知识点覆盖</div>
          <div class="m7-overview-card__value">
            {% if stats.l3_covered is not none and stats.l3_total %}
            <span class="m7-overview-card__num">{{ stats.l3_covered }}/{{ stats.l3_total }}</span>
            {% else %}
            <span class="m7-overview-card__num m7-no-data">--</span>
            {% endif %}
          </div>
          {% if stats.l3_covered is not none and stats.l3_total %}
            {% set coverage_rate = (stats.l3_covered / stats.l3_total * 100) | round(1) %}
            <div class="m7-overview-card__sub">
              覆盖率 {{ coverage_rate }}%
            </div>
            {% if coverage_rate >= 80 %}
            <span class="m7-tag m7-tag--sufficient">
              <span>知识点覆盖良好</span>
              <span class="m7-tag__check">✓</span>
            </span>
            {% else %}
            <span class="m7-tag m7-tag--error">
              <span>知识点偏少</span>
            </span>
            {% endif %}
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  {# ====================================================================
     Section 2: 知识点覆盖详情表格
     ==================================================================== #}
  {% if coverage_rows and coverage_rows | length > 0 %}
  <section class="m7-report-box m7-report-box--purple">
    <div class="m7-report-box__inner">
      <h2 class="m7-section-title">{{ lb_icon('tree', 'frame-section-icon') }} 二、批改归因与L2模块覆盖详情</h2>
      <p class="m7-coverage-note">按知识点统计并归因到L2模块，1题可覆盖多个知识点；题量、置信度和分布条共同用于校验批改归因是否稳定。</p>

      <table class="m7-coverage-table">
        <thead>
          <tr>
            <th>L2模块</th>
            <th>题量</th>
            <th>置信度</th>
            <th>题量分布</th>
          </tr>
        </thead>
        <tbody>
          {% for row in coverage_rows %}
          <tr>
            <td>{{ row.name_cn | default('--', true) }}</td>
            <td>{{ row.count_text | default(row.count ~ '题' if row.count else '--', true) }}</td>
            <td>
              {% if row.confidence %}
              <span class="m7-confidence-badge m7-confidence-badge--{{ row.confidence_badge_class | default('gray', true) }}">
                {{ row.confidence_text | default(row.confidence, true) }}
              </span>
              {% else %}
              <span class="m7-no-data">--</span>
              {% endif %}
            </td>
            <td>
              {% if row.bar %}
              <div class="m7-progress" 
                   role="progressbar" 
                   aria-valuemin="0" 
                   aria-valuemax="100" 
                   aria-valuenow="{{ row.bar.width_pct | default(0) }}"
                   aria-label="题量分布：{{ row.bar.width_pct | default(0) }}%">
                <div class="m7-progress__fill m7-progress__fill--{{ row.bar.class | default('gray', true) }}"
                     style="width: {{ row.bar.style_width | default('0%', true) }};"></div>
              </div>
              {% else %}
              <div class="m7-progress">
                <div class="m7-progress__fill m7-progress__fill--gray" style="width: 0%;"></div>
              </div>
              {% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>

      <div class="m7-note">
        <strong>置信度说明：</strong>
          可信度说明：题量越多，结论越稳定。
          高：题量充足，结论更可靠
          中：题量一般，建议继续积累
          低：题量偏少，暂作参考
      </div>
    </div>
  </section>
  {% endif %}

  {# ====================================================================
     Section 3: 综合说明盒子
     ==================================================================== #}
  <section class="m7-quality-box">
    
    {# --- 区块1: 整体数据质量评估 (蓝底) --- #}
    <div class="m7-quality-block m7-quality-block--blue">
      <h2 class="m7-block-title">
        <span class="m7-block-title__bullet"></span>
        {{ lb_icon('shield', 'frame-inline-icon') }}
        <span>三、报告结论可信度评估</span>
      </h2>
      
      <p class="m7-block-desc">
        {{ section.summary_text | default('本次诊断数据综合评估如下，请参考各指标了解数据可信程度。', true) }}
      </p>

      {% if quality_assessment.metrics and quality_assessment.metrics | length > 0 %}
      <div class="m7-metric-card">
        {% for metric in quality_assessment.metrics %}
        <div class="m7-metric-item">
          <div class="m7-metric-item__head">
            <div class="m7-metric-item__label">{{ metric.label | default('指标', true) }}</div>
            <div class="m7-metric-item__value">{{ metric.value_pct | default(0) }}%</div>
          </div>
          <div class="m7-progress" 
               role="progressbar"
               aria-valuemin="0" 
               aria-valuemax="100" 
               aria-valuenow="{{ metric.value_pct | default(0) }}">
            <div class="m7-progress__fill m7-progress__fill--green"
                 style="width: {{ metric.value_pct | default(0) }}%;"></div>
          </div>
          {% if metric.subtext %}
          <div class="m7-metric-item__sub">{{ metric.subtext }}</div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% else %}
      {# 默认指标卡片 #}
      <div class="m7-metric-card">
        <div class="m7-metric-item">
          <div class="m7-metric-item__head">
            <div class="m7-metric-item__label">数据充分度</div>
            <div class="m7-metric-item__value">
              {% if stats.total_questions and stats.total_questions >= 100 %}85%
              {% elif stats.total_questions and stats.total_questions >= 50 %}60%
              {% else %}--{% endif %}
            </div>
          </div>
          <div class="m7-progress">
            <div class="m7-progress__fill m7-progress__fill--green"
                 style="width: {% if stats.total_questions and stats.total_questions >= 100 %}85%{% elif stats.total_questions and stats.total_questions >= 50 %}60%{% else %}0%{% endif %};"></div>
          </div>
          <div class="m7-metric-item__sub">
            {% if stats.total_questions %}
            共{{ stats.total_questions }}题，
            {% if stats.total_questions >= 100 %}数据充足，诊断结论可信度高
            {% elif stats.total_questions >= 50 %}数据基本充足
            {% else %}数据较少，建议补充更多题目{% endif %}
            {% else %}暂无数据{% endif %}
          </div>
        </div>
        
        {% if stats.l2_covered is not none and stats.l2_total %}
        <div class="m7-metric-item">
          <div class="m7-metric-item__head">
            <div class="m7-metric-item__label">知识点覆盖率</div>
            <div class="m7-metric-item__value">{{ (stats.l2_covered / stats.l2_total * 100) | round(1) }}%</div>
          </div>
          <div class="m7-progress">
            <div class="m7-progress__fill m7-progress__fill--green"
                 style="width: {{ (stats.l2_covered / stats.l2_total * 100) | round(1) }}%;"></div>
          </div>
          <div class="m7-metric-item__sub">
            覆盖{{ stats.l2_covered }}个L2知识点，占全部{{ stats.l2_total }}个的{{ (stats.l2_covered / stats.l2_total * 100) | round(1) }}%
          </div>
        </div>
        {% endif %}
      </div>
      {% endif %}
    </div>

    {# --- 区块2: 数据不足提示 (黄底) --- #}
    <div class="m7-quality-block m7-quality-block--yellow">
      <h2 class="m7-block-title">
        <span class="m7-block-title__bullet"></span>
        {{ lb_icon('warning', 'frame-inline-icon frame-inline-icon--warning') }}
        <span>四、{{ low_sample.title | default('数据不足提示', true) }}</span>
      </h2>

      {% if data_supplement_summary and data_supplement_summary.low_sample_count > 0 %}
      <p class="m7-block-desc">
        本次诊断共发现 <strong>{{ data_supplement_summary.low_sample_count }}</strong> 个样本不足知识点，诊断结论置信度较低，建议补充相关练习后重新评估。<a class="m7-supplement-link">详见附录补充说明</a>
      </p>
      {% else %}
      <p class="m7-block-desc">
        所有知识点数据均已充足，无需额外补充。
      </p>
      {% endif %}
    </div>

    {# --- 区块3: 未覆盖的核心考点 (紫底) --- #}
    <div class="m7-quality-block m7-quality-block--purple">
      <h2 class="m7-block-title">
        <span class="m7-block-title__bullet"></span>
        {{ lb_icon('target', 'frame-inline-icon') }}
        <span>五、{{ uncovered_core.title | default('未覆盖的核心考点', true) }}</span>
      </h2>

      {% if data_supplement_summary and data_supplement_summary.uncovered_count > 0 %}
      <p class="m7-block-desc">
        本次诊断有 <strong>{{ data_supplement_summary.uncovered_count }}</strong> 个核心考点未涉及，暂无法形成评估结论，建议针对性补充相关练习。<a class="m7-supplement-link">详见附录补充说明</a>
      </p>
      {% else %}
      <p class="m7-block-desc">
        ✓ 所有核心考点均已覆盖
      </p>
      {% endif %}
    </div>

  </section>


</div>
  </div><!-- /.module-content-card -->

