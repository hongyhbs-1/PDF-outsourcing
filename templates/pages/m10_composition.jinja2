{# ==============================================================================
   m10_composition.jinja2 — M10 作文精讲 (英语专属)
   条件: page_visibility.m10_composition == true
   ============================================================================== #}

{% from 'macros/learning_blueprint_icons.jinja2' import lb_icon %}
{% set comp = composition_deep | default({}, true) %}
{% if comp.enabled | default(false) %}
{% set so = comp.score_overview | default({}, true) %}
{% set priority_fixes = comp.priority_fixes | default([], true) %}
{% set fix_summary = namespace(values=[]) %}
{% for fix in priority_fixes %}
  {% if fix is mapping %}
    {% set _fix_text = fix.description | default(fix.text | default(fix.content | default('', true), true), true) %}
  {% else %}
    {% set _fix_text = fix %}
  {% endif %}
  {% if _fix_text %}
    {% set fix_summary.values = fix_summary.values + [_fix_text] %}
  {% endif %}
{% endfor %}
{% set weekly_focus = comp.weekly_focus | default('范文精读、过渡词积累和限时作文', true) %}
<div class="m10-page">
  <section class="m10-title-section">
    <h1 class="m10-title">{{ lb_icon('paper', 'frame-title-icon') }}十、作文精讲</h1>
    <div class="m10-title__underline"></div>
  </section>

  <section class="m10-core-conclusion">
    <div class="m10-core-conclusion__label">{{ lb_icon('target', 'frame-conclusion-icon') }}本页核心结论</div>
    <div class="m10-core-conclusion__text">
      本次作文得分 {{ so.total_score | default('--', true) }}/{{ so.full_score | default('20', true) }}，内容 {{ so.content_score | default('--', true) }}/{{ so.content_full | default('8', true) }}、语言 {{ so.language_score | default('--', true) }}/{{ so.language_full | default('8', true) }}、组织 {{ so.organization_score | default('--', true) }}/{{ so.organization_full | default('4', true) }}；{% if fix_summary.values | length > 0 %}优先修正{{ fix_summary.values | join('、') }}，{% endif %}本周围绕{{ weekly_focus }}完成闭环训练。
    </div>
  </section>

  <div class="module-content-card m10-content-card">
  <div class="m10-body">
  {# 1. 成绩概览 #}
  <div class="m10-score-overview">
    <div class="m10-section-title">{{ lb_icon('gauge', 'frame-section-icon') }}成绩概览</div>
    <div class="m10-score-row">
      <div>
        <span class="m10-score-total">{{ so.total_score | default('--', true) }}</span>
        <span class="m10-score-full">/{{ so.full_score | default('20', true) }}</span>
        <span class="m10-score-label">总分</span>
      </div>
      <div class="m10-score-dim">内容 <strong>{{ so.content_score | default('--', true) }}</strong>/{{ so.content_full | default('8', true) }}</div>
      <div class="m10-score-dim">语言 <strong>{{ so.language_score | default('--', true) }}</strong>/{{ so.language_full | default('8', true) }}</div>
      <div class="m10-score-dim">组织 <strong>{{ so.organization_score | default('--', true) }}</strong>/{{ so.organization_full | default('4', true) }}</div>
    </div>
  </div>

  {# 2. 最该先改的两点 #}
  {% if priority_fixes | length > 0 %}
  <div class="m10-section">
    <div class="m10-section-title">{{ lb_icon('warning', 'frame-section-icon frame-section-icon--warning') }}本次最该先改的两点</div>
    {% for fix in priority_fixes %}
    <div class="m10-tip-card m10-tip-card--warning">
      {% if fix is mapping %}
        {% set fix_label = fix.area | default('改进点' ~ loop.index, true) %}
        {% set fix_desc = fix.description | default(fix.text | default(fix.content | default('', true), true), true) %}
        <strong>{{ fix_label }}：</strong>{{ fix_desc }}
      {% else %}
        <strong>改进点{{ loop.index }}：</strong>{{ fix }}
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {# 3. 题目分析 #}
  {% if comp.topic_analysis | default('', true) %}
  <div class="m10-section">
    <div class="m10-section-title">{{ lb_icon('paper', 'frame-section-icon') }}题目分析</div>
    <p class="m10-analysis">{{ comp.topic_analysis }}</p>
  </div>
  {% endif %}

  {# 4. 内容分析 #}
  {% if comp.content_analysis | default('', true) %}
  <div class="m10-section">
    <div class="m10-section-title">{{ lb_icon('data', 'frame-section-icon') }}内容分析 ({{ so.content_score | default('?', true) }}/{{ so.content_full | default('8', true) }})</div>
    <p class="m10-analysis">{{ comp.content_analysis }}</p>
  </div>
  {% endif %}

  {# 5. 语言问题分析 #}
  {% if comp.language_analysis | default('', true) %}
  <div class="m10-section">
    <div class="m10-section-title">{{ lb_icon('warning', 'frame-section-icon frame-section-icon--warning') }}语言问题分析 ({{ so.language_score | default('?', true) }}/{{ so.language_full | default('8', true) }})</div>
    <p class="m10-analysis">{{ comp.language_analysis }}</p>
  </div>
  {% endif %}

  {# 6. 结构与行文分析 #}
  {% if comp.organization_analysis | default('', true) %}
  <div class="m10-section">
    <div class="m10-section-title">{{ lb_icon('module', 'frame-section-icon') }}结构与行文分析 ({{ so.organization_score | default('?', true) }}/{{ so.organization_full | default('4', true) }})</div>
    <p class="m10-analysis">{{ comp.organization_analysis }}</p>
  </div>
  {% endif %}

  {# 7. 本周提升建议 #}
  {% if comp.weekly_suggestion | default('', true) %}
  <div class="m10-section">
    <div class="m10-tip-card m10-tip-card--success">
      <div class="m10-section-title">{{ lb_icon('support', 'frame-section-icon') }}本周提升建议</div>
      <p class="m10-analysis">{{ comp.weekly_suggestion }}</p>
    </div>
  </div>
  {% endif %}

  {# 8. 范文参考 #}
  {% if comp.reference_essay | default('', true) %}
  <div class="m10-section">
    <div class="m10-section-title">{{ lb_icon('paper', 'frame-section-icon') }}范文参考</div>
    <div class="m10-reference">{{ comp.reference_essay }}</div>
  </div>
  {% endif %}

  {# 9. 问题与亮点一览 #}
  {% if comp.highlights_and_issues | default([], true) | length > 0 %}
  <div class="m10-section m10-section--table">
    <div class="m10-section-title">{{ lb_icon('data', 'frame-section-icon') }}问题与亮点一览</div>
    <table class="m10-table">
      <thead>
        <tr>
          <th class="m10-table__col-index">#</th>
          <th class="m10-table__col-type">类型</th>
          <th>内容</th>
        </tr>
      </thead>
      <tbody>
        {% for item in comp.highlights_and_issues %}
        <tr>
          <td>{{ loop.index }}</td>
          <td>
            {% if item.type | default('', true) == 'highlight' %}
              <span class="m10-tag--highlight">亮点</span>
            {% else %}
              <span class="m10-tag--issue">问题</span>
            {% endif %}
          </td>
          <td>{{ item.content | default(item.text | default('', true), true) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
  </div>
  </div><!-- /.module-content-card -->
</div>
{% endif %}
