  }
}
================================================================================
#}

{% from 'macros/learning_blueprint_icons.jinja2' import lb_icon %}

{# ============================================================
   宏定义：条件样式类映射
   ============================================================ #}

{#- 排名徽章颜色类 -#}
{% macro get_rank_badge_class(rank) -%}
  {%- if rank is none -%}
    blue
  {%- elif rank <= 3 -%}
    red
  {%- elif rank <= 7 -%}
    orange
  {%- else -%}
    blue
  {%- endif -%}
{%- endmacro %}

{#- 距目标线颜色类 -#}
{% macro get_gap_class(gap) -%}
  {%- if gap is none -%}
    nodata
  {%- elif gap >= 0 -%}
    success
  {%- elif gap > -15 -%}
    warning
  {%- else -%}
    danger
  {%- endif -%}
{%- endmacro %}

{#- 年份覆盖率颜色类
    [v1.1] 支持 0-1 和 0-100 两种输入格式
-#}
{% macro get_coverage_class(rate) -%}
  {%- if rate is none -%}
    nodata
  {%- else -%}
    {#- 自动检测并转换：若 <= 1 视为比例，转为百分数 -#}
    {%- set rate_pct = rate * 100 if rate <= 1 else rate -%}
    {%- if rate_pct >= 80 -%}
      normal
    {%- else -%}
      warning
    {%- endif -%}
  {%- endif -%}
{%- endmacro %}

{#- 安全显示数值（空值防护） -#}
{% macro safe_value(val, suffix='', default='--') -%}
  {%- if val is none or val == '' -%}
    {{ default }}
  {%- else -%}
    {{ val }}{{ suffix }}
  {%- endif -%}
{%- endmacro %}

{#- 安全显示带符号的数值 -#}
{% macro safe_signed_value(val, suffix='%', default='--') -%}
  {%- if val is none or val == '' -%}
    {{ default }}
  {%- elif val > 0 -%}
    +{{ val }}{{ suffix }}
  {%- else -%}
    {{ val }}{{ suffix }}
  {%- endif -%}
{%- endmacro %}

{#- [v1.1] 年份覆盖率显示（自动单位转换）
    输入可能是 0-1（比例）或 0-100（百分数）
    输出始终为整数百分数
-#}
{% macro safe_coverage_rate(rate, suffix='%', default='--') -%}
  {%- if rate is none or rate == '' -%}
    {{ default }}
  {%- elif rate <= 1 -%}
    {#- 0-1 比例转百分数 -#}
    {{ (rate * 100) | round | int }}{{ suffix }}
  {%- else -%}
    {#- 已是 0-100 百分数 -#}
    {{ rate | round | int }}{{ suffix }}
  {%- endif -%}
{%- endmacro %}


{# ============================================================
   [v1.2 B1修复] 入口对象兼容处理
   支持三种注入方式：
   1. 直接传入 data 对象
   2. 通过 sections.city_compare 注入
   3. 通过 city_compare 直接注入
   ============================================================ #}
{% set data = data if data is defined and data
  else (city_compare if city_compare is defined and city_compare
  else (sections.city_compare if sections is defined and sections.city_compare is defined
  else {})) %}


{# ============================================================
   主模板开始
   ============================================================ #}

{#- 数据引用简化 -#}
{% set meta = meta | default({}) %}
{% set banner = data.banner | default({}) %}
{% set summary = data.overlap_summary | default({}) %}
{% set items = data.overlap_items | default([]) %}
{% set advice_list = data.advice | default([]) %}
{% set footnote = data.footnote | default({}) %}
{% set long_item_threshold = 15 %}
{# NEW 2026-06-09: 城市 Top15 重点 + 学生逐点正确率 #}
{% set city_top_items = data.city_top_items | default([]) %}
{% set has_city_top = city_top_items | length > 0 %}
{% set city_name = meta.city_name | default('本') %}

{#- [v1.2 B2优化] 数据有效性检查
    has_data 语义从"有交集"改为"有短板数据"
    这样即使没有交集，只要有短板数据就不会进入空态
-#}
{% set student_core_weak_total = summary.student_core_weak_total | default(0) %}
{% set has_data = summary.has_data | default(student_core_weak_total > 0) %}
{% set overlap_count = summary.overlap_count | default(0) %}
{% set city_top_n = summary.city_top_n | default(10) %}
{% set overlap_ratio = summary.overlap_ratio | default(none) %}
{% if overlap_ratio is none %}
  {% set overlap_pct = ((overlap_count / student_core_weak_total) * 100) | round | int if student_core_weak_total else 0 %}
{% elif overlap_ratio <= 1 %}
  {% set overlap_pct = (overlap_ratio * 100) | round | int %}
{% else %}
  {% set overlap_pct = overlap_ratio | round | int %}
{% endif %}

{# Defensive narrowing: old payloads may include mastered city-high-frequency items in
   overlap_items. The visible overlap list must follow overlap_count's contract:
   student weak points intersecting city TopN only. #}
{% set overlap_display_items = [] %}
{% for item in items %}
  {% set item_gap = item.delta_vs_target if item.delta_vs_target is defined else item.gap_to_target | default(none) %}
  {% if item_gap is not none and item_gap < 0 and (overlap_count <= 0 or overlap_display_items | length < overlap_count) %}
    {% set _ = overlap_display_items.append(item) %}
  {% endif %}
{% endfor %}
{% set has_overlap_items = overlap_display_items | length > 0 %}
{% set overlap_names = [] %}
{% for item in overlap_display_items[:3] %}
  {% if item.kp_name %}{% set _ = overlap_names.append(item.kp_name) %}{% endif %}
{% endfor %}

<style>
  .m5-city-compare__acc-list { margin-top: 14px; padding-top: 12px; border-top: 1px dashed #d8dee8; }
  .m5-city-compare__acc-list-title { font-size: 13px; font-weight: 600; color: #2c3e50; margin-bottom: 10px; }
  .m5-city-compare__acc-row { display: flex; align-items: center; gap: 8px; padding: 4px 0; }
  .m5-city-compare__acc-rank { flex: 0 0 auto; min-width: 26px; text-align: center; }
  .m5-city-compare__acc-name { flex: 0 0 168px; font-size: 12px; color: #34404e; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .m5-city-compare__acc-bar { flex: 1 1 auto; height: 12px; background: #eef1f5; border-radius: 6px; overflow: hidden; }
  .m5-city-compare__acc-bar-fill { display: block; height: 100%; background: #4a90d9; border-radius: 6px; }
  .m5-city-compare__acc-bar-fill--weak { background: #e0584a; }
  .m5-city-compare__acc-val { flex: 0 0 52px; text-align: right; font-size: 12px; font-weight: 600; color: #34404e; }
  .m5-city-compare__acc-row--weak .m5-city-compare__acc-name,
  .m5-city-compare__acc-row--weak .m5-city-compare__acc-val { color: #c0392b; }
  .m5-city-compare__acc-untested { color: #9aa3ad; font-weight: 400; }
  .m5-city-compare__acc-note { font-size: 11px; color: #8893a0; margin-top: 8px; }
</style>
<div class="m5-city-compare{% if overlap_display_items | length >= long_item_threshold %} m5-city-compare--long{% endif %}">

  {# ============================================================
     PART 1: 标题 + 一句话概述 (在卡片外)
     ============================================================ #}
  <section class="m5-city-compare__part m5-city-compare__part--header">
    <h1 class="m5-city-compare__title">
      {{ lb_icon('city', 'frame-title-icon') }}五、{{ data.module_title | default('城市考情对照') }}
    </h1>
    <section class="m5-core-conclusion">
      <div class="m5-core-conclusion__label">{{ lb_icon('city', 'frame-conclusion-icon') }}本页核心结论</div>
      <div class="m5-core-conclusion__text">
        {%- set city_name = meta.city_name | default('本') -%}
        {%- if has_data and overlap_count > 0 -%}
          本页先列出你的{{ overlap_count }}个薄弱知识点{% if overlap_names | length > 0 %}（{{ overlap_names | join('、') }}）{% endif %}，再看它们与{{ city_name }}市高频考点的重合度{{ overlap_pct }}%；这些知识点同时具备个人短板与城市高频属性。
        {%- elif has_data -%}
          当前薄弱知识点暂未命中{{ city_name }}市高频考点，说明本次短板与城市高频交集有限。
        {%- else -%}
          你的薄弱知识点与{{ city_name }}市历年中考高频考点暂无重合。
        {%- endif -%}
      </div>
    </section>
  </section>

  <div class="module-content-card">

  {# ============================================================
     PART 2: 重合知识点清单 → 高频重合度概览
     ============================================================ #}
  {% if has_data %}
  <section class="m5-city-compare__part m5-city-compare__part--data">

  {# ----------------------
     表格：重合知识点清单（先看具体知识点）
     ---------------------- #}
  {% if has_city_top %}
  <section class="m5-city-compare__table-section">
    <div class="m5-city-compare__table-title">{{ lb_icon('paper', 'frame-inline-icon') }} 一、{{ city_name }}市高频 Top{{ city_top_items | length }} 重点</div>

    <table class="m5-city-compare__table">
      <thead>
        <tr>
          <th class="m5-city-compare__table th--center" style="width: 70px;">城市排名</th>
          <th style="width: auto;">知识点</th>
          <th class="m5-city-compare__table th--center" style="width: 90px;">重要度</th>
          <th class="m5-city-compare__table th--center" style="width: 150px;">高频标签</th>
        </tr>
      </thead>
      <tbody>
        {% for item in city_top_items %}
        <tr>
          <td class="m5-city-compare__table td--center">
            <span class="m5-city-compare__rank-badge m5-city-compare__rank-badge--{{ item.rank_badge_class | default('blue') }}">
              {{ item.city_rank | default('--') }}
            </span>
          </td>
          <td>
            <div class="m5-city-compare__kp-name">{{ item.kp_name | default('--') }}</div>
          </td>
          <td class="m5-city-compare__table td--center">
            <span class="m5-city-compare__weight-badge m5-city-compare__weight-badge--{{ item.score_weight_class | default('mid') }}">
              {{ item.score_weight | default('中') }}
            </span>
          </td>
          <td class="m5-city-compare__table td--center">
            {% if item.tags and item.tags | length > 0 %}
              {% for tag in item.tags %}
              <span class="m5-city-compare__tag m5-city-compare__tag--highlight">{{ tag }}</span>
              {% endfor %}
            {% else %}
              <span class="m5-city-compare__tag">—</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <div class="m5-city-compare__table-note">
      重要度：综合历年真题出题频率、分值占比、难度评定；本表为{{ city_name }}市历年高频考点 Top{{ city_top_items | length }}（城市维度，与个人作答无关）
    </div>
  </section>
  {% endif %}

  {# ----------------------
     高频重合度概览（置于清单之后，宽度与清单一致）
     ---------------------- #}
  <section class="m5-city-compare__card m5-city-compare__card--overlap m5-city-compare__card--overlap-wide">
    <div class="m5-city-compare__card-title">{{ lb_icon('target', 'frame-card-icon') }} 二、高频重合度</div>

    <div class="m5-city-compare__overlap-layout">
      <div>
        <div class="m5-city-compare__overlap-main">
          <span class="m5-city-compare__overlap-num">{{ overlap_pct }}%</span>
        </div>
        <div class="m5-city-compare__overlap-subtitle">
          当前短板与城市 top{{ city_top_n }} 的重合率
        </div>
      </div>

      <div class="m5-city-compare__overlap-body">
        <div class="m5-city-compare__progress">
          <div class="m5-city-compare__progress-track">
            <div class="m5-city-compare__progress-fill" style="width: {{ overlap_pct }}%;"></div>
          </div>
        </div>

        <div class="m5-city-compare__overlap-stats">
          <div class="m5-city-compare__overlap-stat">
            <span class="m5-city-compare__overlap-stat-label">重合知识点</span>
            <span class="m5-city-compare__overlap-stat-value">{{ overlap_count }}</span>
          </div>
          <div class="m5-city-compare__overlap-stat">
            <span class="m5-city-compare__overlap-stat-label">核心短板总数</span>
            <span class="m5-city-compare__overlap-stat-value">{{ student_core_weak_total }}</span>
          </div>
          <div class="m5-city-compare__overlap-stat">
            <span class="m5-city-compare__overlap-stat-label">城市参考范围</span>
            <span class="m5-city-compare__overlap-stat-value">Top{{ city_top_n }}</span>
          </div>
        </div>

        <div class="m5-city-compare__overlap-ratio">
          {% if overlap_count > 0 %}
          已识别 {{ overlap_count }}/{{ student_core_weak_total }} 个优先突破的考试高频短板。
          {% else %}
          当前未命中城市高频交集，但仍可依据上方清单安排专项补练。
          {% endif %}
        </div>
      </div>
    </div>

    {# NEW 2026-06-09: 学生在城市 Top15 高频考点上的逐点正确率 #}
    {% if has_city_top %}
    <div class="m5-city-compare__acc-list">
      <div class="m5-city-compare__acc-list-title">
        你在{{ city_name }}市高频 Top{{ city_top_items | length }} 考点上的正确率{% if summary.city_top_avg_accuracy is not none %}（已测点平均 {{ summary.city_top_avg_accuracy }}%）{% endif %}
      </div>
      {% for item in city_top_items %}
      <div class="m5-city-compare__acc-row{% if item.is_weak %} m5-city-compare__acc-row--weak{% endif %}">
        <span class="m5-city-compare__rank-badge m5-city-compare__rank-badge--{{ item.rank_badge_class | default('blue') }} m5-city-compare__acc-rank">{{ item.city_rank | default('--') }}</span>
        <span class="m5-city-compare__acc-name">{{ item.kp_name | default('--') }}</span>
        <span class="m5-city-compare__acc-bar">
          {% if item.tested %}
          <span class="m5-city-compare__acc-bar-fill{% if item.is_weak %} m5-city-compare__acc-bar-fill--weak{% endif %}" style="width: {{ item.student_accuracy }}%;"></span>
          {% endif %}
        </span>
        <span class="m5-city-compare__acc-val">{% if item.tested %}{{ item.student_accuracy }}%{% else %}<span class="m5-city-compare__acc-untested">未测</span>{% endif %}</span>
      </div>
      {% endfor %}
      <div class="m5-city-compare__acc-note">红色 = 低于目标线的薄弱高频点（优先攻克）；“未测” = 本次未覆盖该考点。</div>
    </div>
    {% endif %}
  </section>
  </section><!-- /.m5-city-compare__part--data -->
  {% endif %}

  {% if not has_data %}
  <section class="m5-city-compare__empty">
    <div class="m5-city-compare__empty-text">暂无城市考情对照数据</div>
  </section>
  {% endif %}

  {# ============================================================
     Footer: 数据说明
     ============================================================ #}
  {% if footnote.title or footnote.text or footnote.source or footnote.note %}
  <footer class="m5-city-compare__footnote">
    {% if footnote.text %}
    <div class="m5-city-compare__footnote-text">
      {{ lb_icon('data', 'frame-inline-icon') }} {{ footnote.text }}
    </div>
    {% endif %}
    {% if footnote.note %}
    <span class="m5-city-compare__footnote-line">{{ footnote.note }}</span>
    {% endif %}
  </footer>
  {% endif %}

  </div><!-- /.module-content-card -->
</div>
