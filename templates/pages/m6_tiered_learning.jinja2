================================================================================
字段说明
================================================================================

page_header.report_name      - 报告名称(string)
page_header.report_date      - 报告日期(string, 格式: YYYY.MM.DD)

module.title                 - 模块标题(string)

--- Card 1: 阶段判定 ---
stage_judgement.title        - 卡片标题(string)
stage_judgement.bullet_color - 标题bullet颜色(enum: blue/red/orange)
stage_judgement.stages[]     - 阶段定义数组
  .key                       - 阶段标识(enum: basic/improve/sprint)
  .name                      - 阶段名称(string)
  .desc                      - 阶段描述/阈值(string)
stage_judgement.current      - 当前状态对象
  .pass_rate                 - 达标率数值(number, 0-100, nullable)
  .pass_rate_text            - 达标率文案(string)
  .position_hint             - 位置提示文案(string)- 基于gap_to_target生成
  .stage_key                 - 当前阶段key(enum: basic/improve/sprint)
  .has_data                  - 是否有有效数据(boolean)
stage_judgement.note         - 说明框对象
  .title                     - 说明标题(string)
  .text                      - 说明正文(string)

--- Card 2: 学生建议 (NEW) ---
student_suggestion.title     - 卡片标题(string)
student_suggestion.summary   - 总体建议摘要(string)- 映射自 for_student.summary
student_suggestion.sections[]- 建议分组
  .no                        - 序号(string, "01"/"02")
  .title                     - 分组标题(string)- 如"近期重点"/"中期规划"
  .items[]                   - 建议条目(array of string)

--- Card 3: 家长建议 (NEW) ---
parent_guidance.title        - 卡片标题(string)
parent_guidance.summary      - 总体建议(string)- 映射自 for_parent.summary
parent_guidance.checklist[]  - 行动清单(array of string)- 映射自 for_parent.action_items

--- Card 4: 老师建议 ---
teacher_guidance.title           - 卡片标题(string)
teacher_guidance.summary         - 总体建议(string)- 映射自 for_teacher.summary
teacher_guidance.paragraph_parts - 段落组成部分(array of string|object)
  - string: 普通文本
  - object { "em": "强调文字" }: 红色强调
teacher_guidance.checklist[]     - 教学关注点(array of string)- 映射自 for_teacher.teaching_focus

================================================================================
数据来源映射(report_output_from_llm_v5.1 → 本模板)
================================================================================

【重要】v5.1 schema 规定 study_suggestions 位于 standard_texts 下,不是顶层!

report_output.meta.report_date                                     → page_header.report_date
report_output.core_data.benchmark_summary.pass_rate                → stage_judgement.current.pass_rate
report_output.core_data.benchmark_summary.gap_to_target            → stage_judgement.current.position_hint (需格式化)
report_output.core_data.top_risks[]                                → stage_judgement.note.text (个性化)
report_output.standard_texts.study_suggestions.for_student.summary → student_suggestion.summary
report_output.standard_texts.study_suggestions.for_student.short_term[]  → student_suggestion.sections[0].items
report_output.standard_texts.study_suggestions.for_student.mid_term[]    → student_suggestion.sections[1].items
report_output.standard_texts.study_suggestions.for_parent.summary        → parent_guidance.summary
report_output.standard_texts.study_suggestions.for_parent.action_items[] → parent_guidance.checklist
report_output.standard_texts.study_suggestions.for_teacher.summary       → teacher_guidance.summary
report_output.standard_texts.study_suggestions.for_teacher.teaching_focus[] → teacher_guidance.checklist

================================================================================
#}

{% from 'macros/learning_blueprint_icons.jinja2' import lb_icon %}

{# ============================================================================
   宏定义 (Macros)
   ============================================================================ #}

{#- 安全获取嵌套属性,带默认值 -#}
{% macro safe_get(obj, key, default='') %}
  {{- obj[key] if obj and key in obj and obj[key] is not none else default -}}
{% endmacro %}

{#- 安全获取数值,带默认值和边界处理 -#}
{% macro safe_number(value, default=0, min_val=0, max_val=100) %}
  {%- if value is not none and value is number -%}
    {{- [max_val, [min_val, value] | max] | min -}}
  {%- else -%}
    {{- default -}}
  {%- endif -%}
{% endmacro %}

{#- SVG勾选图标 -#}
{% macro check_svg(color_class='blue') %}
<svg class="m6-check-icon--svg m6-check-icon--{{ color_class }}" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
  <circle cx="11" cy="11" r="9" stroke-width="2"/>
  <path d="M6 11 L10 15 L16 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
{% endmacro %}

{#- 角色图标 -#}
{% macro role_icon(icon_type) %}
{% if icon_type == 'student' %}
<svg class="m6-role-icon m6-role-icon--student" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
  <circle cx="12" cy="8" r="4" fill="currentColor"/>
  <path d="M4 20c0-4 4-6 8-6s8 2 8 6" fill="currentColor"/>
</svg>
{% elif icon_type == 'parent' %}
<svg class="m6-role-icon m6-role-icon--parent" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
  <circle cx="9" cy="7" r="3" fill="currentColor"/>
  <circle cx="15" cy="7" r="3" fill="currentColor"/>
  <path d="M3 19c0-3 3-5 6-5s6 2 6 5M9 19c0-3 3-5 6-5s6 2 6 5" fill="currentColor"/>
</svg>
{% elif icon_type == 'teacher' %}
<svg class="m6-role-icon m6-role-icon--teacher" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
  <rect x="3" y="4" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"/>
  <path d="M8 21h8M12 18v3" stroke="currentColor" stroke-width="2"/>
  <circle cx="12" cy="11" r="3" fill="currentColor"/>
</svg>
{% endif %}
{% endmacro %}


{# ============================================================================
   模板主体 (Template Body)
   ============================================================================ #}

{# meta 变量定义 - 确保兼容性 #}
{% set meta = meta | default({}) %}

{# 变量提取: 兼容 tiered_learning.xxx 嵌套和直接 xxx 传入两种模式 #}
{% set _tl = tiered_learning | default({}) %}
{% set page_header = page_header | default(_tl.page_header | default({})) %}
{% set module = module | default(_tl.module | default({})) %}
{% set stage_card = module.cards.stage_judgement | default({}) %}
{% set current = stage_card.current | default({}) %}
{% set current_stage = namespace(name=current.position_hint | default('当前阶段待确认', true)) %}
{% for stage in stage_card.stages | default([]) %}
  {% if stage.key == current.stage_key %}{% set current_stage.name = stage.name | default(current_stage.name, true) %}{% endif %}
{% endfor %}
{% set weak_items = [] %}
{% if domains is defined and domains.domain_items is defined %}
  {% for item in domains.domain_items %}
    {% if item.status | default('') in ['需加强', '需关注'] and item.has_data | default(true) %}
      {% set _ = weak_items.append(item) %}
    {% endif %}
  {% endfor %}
{% endif %}
{% set weak_domain_names = [] %}
{% for item in weak_items[:3] %}{% set _ = weak_domain_names.append(item.name_cn | default('领域' ~ loop.index, true)) %}{% endfor %}
{% set core_items = core_weakness['items'] | default([], true) if core_weakness is defined and 'items' in core_weakness else [] %}
{% set core_weak_names = [] %}
{% for item in core_items[:3] %}{% if item.name %}{% set _ = core_weak_names.append(item.name) %}{% endif %}{% endfor %}
{% set drill_nodes = kp_drill.path_example.nodes | default([], true) if kp_drill is defined and kp_drill.path_example is defined else [] %}
{% set drill_focus = namespace(l3='', l4='') %}
{% for node in drill_nodes %}
  {% if node.level == 'L3' and node.name_cn %}{% set drill_focus.l3 = node.name_cn %}{% endif %}
  {% if node.level == 'L4' and node.name_cn %}{% set drill_focus.l4 = node.name_cn %}{% endif %}
{% endfor %}
{% set city_items = city_compare.overlap_items | default([], true) if city_compare is defined else [] %}
{% set city_overlap_names = [] %}
{% for item in city_items[:3] %}{% if item.kp_name %}{% set _ = city_overlap_names.append(item.kp_name) %}{% endif %}{% endfor %}
{% set city_advice_list = city_compare.advice | default([], true) if city_compare is defined else [] %}
{% set city_label = meta.city_name | default('本市', true) %}
{% set thirty_day_targets = core_weak_names[:2] if core_weak_names | length > 0 else (city_overlap_names[:2] if city_overlap_names | length > 0 else []) %}
{% set sixty_day_targets = [] %}
{% if core_weak_names | length > 2 %}{% set _ = sixty_day_targets.append(core_weak_names[2]) %}{% endif %}
{% if sixty_day_targets | length == 0 and city_overlap_names | length > 2 %}{% set _ = sixty_day_targets.append(city_overlap_names[2]) %}{% endif %}

<div class="m6-page">

  {# --------------------------------------------------------------------------
     模块标题 (Module Title)
     -------------------------------------------------------------------------- #}
  <div class="m6-module-title">
    <h1 class="m6-module-title__text">
      {{ lb_icon('support', 'frame-title-icon') }}六、{{ module.title | default('分层与学习建议', true) }}
    </h1>
    <div class="m6-module-title__underline"></div>
  </div>

  <section class="m6-core-conclusion">
    <div class="m6-core-conclusion__label">{{ lb_icon('support', 'frame-conclusion-icon') }}本页核心结论</div>
    <div class="m6-core-conclusion__text">
      当前处于「{{ current_stage.name }}」，建议按 30/60 天推进：P9 领域上{% if weak_domain_names | length > 0 %}{{ weak_domain_names | join('、') }}低于目标线{% else %}薄弱领域待确认{% endif %}；P10 优先处理{% if core_weak_names | length > 0 %}{{ core_weak_names | join('、') }}{% else %}核心短板{% endif %}；P11 重点钻取{% if drill_focus.l3 %}{{ drill_focus.l3 }}{% else %}L3薄弱环节{% endif %}{% if drill_focus.l4 %}/{{ drill_focus.l4 }}{% endif %}；P12 显示{% if city_overlap_names | length > 0 %}{{ city_overlap_names | join('、') }}与{{ city_label }}市高频考点重合{% else %}高频重合项待确认{% endif %}。30 天内先掌握{{ thirty_day_targets | join('、') if thirty_day_targets | length > 0 else '核心短板' }}，60 天内巩固{{ sixty_day_targets | join('、') if sixty_day_targets | length > 0 else '重点知识点' }}并完成复测。
    </div>
  </section>

  <div class="module-content-card">

  {# ==========================================================================
     卡片1:当前学习阶段判定 (Stage Judgement Card)
     ========================================================================== #}
  {% set stage_card = module.cards.stage_judgement | default({}) %}
  {% set current = stage_card.current | default({}) %}
  {% set has_data = current.has_data | default(true) %}
  {% set pass_rate = current.pass_rate | default(0) if has_data else 0 %}
  {% set clamped_rate = ([100, [0, pass_rate] | max] | min) | round(1) %}
  {% set summary_data = summary | default({}, true) %}
  {% set stage_target_rate = summary_data.target_accuracy | default(meta.target_accuracy | default(85, true), true) %}
  {% if stage_card.target_accuracy is defined and stage_card.target_accuracy not in [none, ''] %}
    {% set stage_target_rate = stage_card.target_accuracy %}
  {% endif %}
  {% if current.target_accuracy is defined and current.target_accuracy not in [none, ''] %}
    {% set stage_target_rate = current.target_accuracy %}
  {% elif current.target_rate is defined and current.target_rate not in [none, ''] %}
    {% set stage_target_rate = current.target_rate %}
  {% endif %}
  {% set clamped_target_rate = ([100, [0, stage_target_rate | float] | max] | min) | round(1) %}
  {% set stage_progress_css = (clamped_rate | round(0) | int) if clamped_rate == (clamped_rate | round(0)) else clamped_rate %}
  {% set stage_target_progress_css = (clamped_target_rate | round(0) | int) if clamped_target_rate == (clamped_target_rate | round(0)) else clamped_target_rate %}
  {% set stage_progress_gap = clamped_rate - clamped_target_rate if clamped_rate >= clamped_target_rate else clamped_target_rate - clamped_rate %}
  {% set stage_markers_overlap = stage_progress_gap <= 5 %}
  {% set stage_progress_edge_class = 'sp-progress-label--edge-start' if clamped_rate <= 8 else ('sp-progress-label--edge-end' if clamped_rate >= 92 else '') %}
  {% set stage_target_edge_class = 'sp-progress-label--edge-start' if clamped_target_rate <= 8 else ('sp-progress-label--edge-end' if clamped_target_rate >= 92 else '') %}
  {% set above_target = current.above_target | default(false) %}

  <section class="m6-card m6-card--strong-border {{ 'm6-status--nodata' if not has_data else ('m6-status--above-target' if above_target else 'm6-status--below-target') }}"
           style="--stage-progress: {{ stage_progress_css }}%; --stage-target-progress: {{ stage_target_progress_css }}%;">

    {# 卡片标题 #}
    <div class="m6-card-header">
      <span class="m6-bullet m6-bullet--{{ stage_card.bullet_color | default('blue', true) }}"></span>
      <h2 class="m6-card-header__title">
        {{ lb_icon('gauge', 'frame-card-icon') }} 一、{{ stage_card.title | default('当前学习阶段判定', true) }}
      </h2>
    </div>

    {# 三阶段标签 #}
    <div class="m6-stage-labels">
      {% for stage in stage_card.stages | default([]) %}
      <div class="m6-stage-label {{ 'm6-stage-label--active' if stage.key == current.stage_key else '' }}">
        <div class="m6-stage-label__name">{{ stage.name | default('--', true) }}</div>
        {#<div class="m6-stage-label__desc">({{ stage.desc | default('--', true) }})</div>#}
      </div>
      {% else %}
      {# 默认阶段标签(无数据时) #}
      <div class="m6-stage-label">
        <div class="m6-stage-label__name">基础巩固期</div>
        <div class="m6-stage-label__desc">(达标率 &lt; 60%)</div>
      </div>
      <div class="m6-stage-label">
        <div class="m6-stage-label__name">能力提升期</div>
        <div class="m6-stage-label__desc">(达标率60-80%)</div>
      </div>
      <div class="m6-stage-label">
        <div class="m6-stage-label__name">冲刺突破期</div>
        <div class="m6-stage-label__desc">(达标率大于80%)</div>
      </div>
      {% endfor %}
    </div>

    {# 进度条：与“数学画像分析 / 二、整体分析”的 sp-progress 组件保持一致 #}
    <div class="m6-stage-progress-panel sp-progress-panel">
      <div class="sp-progress-panel__meta">
        <div class="sp-progress-panel__eyebrow">{{ lb_icon('gauge', 'frame-inline-icon') }}阶段位置</div>
        {% if has_data %}
        <div class="sp-progress-panel__title">当前 {{ clamped_rate | round(0) | int }}%，目标 {{ clamped_target_rate | round(0) | int }}%，{{ current_stage.name }}</div>
        <p class="sp-progress-panel__text">{{ current.position_hint | default('先看位置，再看后面的学习建议。', true) }}</p>
        {% else %}
        <div class="sp-progress-panel__title">当前数据还不足以判断稳定阶段</div>
        <p class="sp-progress-panel__text">先补足样本，再判断位置与阶段。</p>
        {% endif %}
      </div>

      <div class="sp-progress sp-progress--panel">
        <div class="sp-progress-track">
          <div class="sp-progress-fill"></div>
          <div class="sp-progress-target sp-progress-target--current" title="当前节点"></div>
          <div class="sp-progress-target sp-progress-target--target{% if stage_markers_overlap %} sp-progress-target--overlap{% endif %}" title="目标节点"></div>
        </div>
        <div class="sp-progress-labels{% if stage_markers_overlap %} sp-progress-labels--stacked{% endif %}">
          <span class="sp-progress-label sp-progress-label--start">0%</span>
          <span class="sp-progress-label sp-progress-label--current{% if stage_progress_edge_class %} {{ stage_progress_edge_class }}{% endif %}{% if stage_markers_overlap %} sp-progress-label--stack-top{% endif %}">{% if has_data %}当前 {{ clamped_rate | round(0) | int }}%{% else %}当前 暂无数据{% endif %}</span>
          <span class="sp-progress-label sp-progress-label--target{% if stage_target_edge_class %} {{ stage_target_edge_class }}{% endif %}{% if stage_markers_overlap %} sp-progress-label--stack-bottom{% endif %}">目标 {{ clamped_target_rate | round(0) | int }}%</span>
          <span class="sp-progress-label sp-progress-label--end">100%</span>
        </div>
      </div>
    </div>

    {# 当前阶段特点说明框 #}
    {% set note = stage_card.note | default({}) %}
    <div class="m6-note-box">
      <div class="m6-note-box__title">
        {{ note.title | default('当前阶段特点:', true) }}
      </div>
      <div class="m6-note-box__text">
        {% if has_data and note.text %}
          {{ note.text }}
        {% else %}
          <span class="m6-empty-text">数据不足，暂无法给出阶段特点分析。</span>
        {% endif %}
      </div>
    </div>

  </section>

  {# ==========================================================================
     综合训练与角色建议模块：训练重点 + 学生/家长/老师建议
     ========================================================================== #}
  <section class="m6-card m6-card--strong-border m6-recommendation-module">
  {% if weak_items | length > 0 %}
  <div class="m6-training-focus">
    <div class="m6-training-focus__title">{{ lb_icon('target', 'frame-section-icon') }} 二、训练重点速览</div>
    <div class="m6-training-focus__grid">
      {% for item in weak_items[:6] %}
      <div class="m6-training-focus__item">
        <span class="m6-training-focus__name">{{ item.name_cn | default('领域' ~ loop.index) }}</span>
        <span class="m6-training-focus__acc">{{ item.accuracy_text | default('--') }}</span>
        <span class="m6-training-focus__delta {{ 'm6-training-focus__delta--neg' if (item.delta_vs_target | default(0)) < 0 }}">{{ item.delta_text | default('') }}</span>
      </div>
      {% endfor %}
    </div>
    <div class="m6-training-focus__note">以上为当前低于目标线的领域，建议结合当前学习阶段安排专项突破。{% if city_advice_list | length > 0 %}<span class="m6-city-advice-inline"><strong>城市考情备考建议：</strong>{% set first_advice = city_advice_list[0] %}{% if first_advice is mapping %}{{ first_advice.content | default(first_advice.text, true) }}{% else %}{{ first_advice }}{% endif %}</span>{% endif %}</div>
  </div>
  {% endif %}

  {# ==========================================================================
     角色建议区：给学生 / 给家长 / 给老师
     ========================================================================== #}
  {% set student_card = module.cards.student_suggestion | default({}) %}
  {% set parent_card = module.cards.parent_guidance | default({}) %}
  {% set teacher_card = module.cards.teacher_guidance | default({}) %}

  <div class="m6-role-stack">
  <section class="m6-role-panel m6-role-panel--student">

    {# 卡片标题 #}
    <div class="m6-card-header m6-card-header--with-icon">
      <span class="m6-bullet m6-bullet--{{ student_card.bullet_color | default('blue', true) }}"></span>
      {{ role_icon(student_card.icon | default('student')) }}
      <h2 class="m6-card-header__title">
        1、{{ student_card.title | default('给学生的学习建议', true) }}
      </h2>
    </div>

    {# 总体建议摘要 #}
    {% if student_card.summary %}
    <div class="m6-summary-box m6-summary-box--student">
      <p class="m6-summary-box__text">{{ student_card.summary }}</p>
    </div>
    {% endif %}

    {# 分组建议列表 #}
    {% set student_section_no_cn = ['一', '二', '三', '四', '五', '六'] %}
    <div class="m6-suggestion-sections">
      {% for section in student_card.sections | default([]) %}
      {% set display_no = student_section_no_cn[loop.index0] if loop.index0 < (student_section_no_cn | length) else (section.no | default(loop.index, true)) %}
      <div class="m6-suggestion-section">
        <div class="m6-suggestion-section__header">
          <span class="m6-suggestion-section__no">{{ display_no }}</span>
          <span class="m6-suggestion-section__title">{{ section.title | default('--', true) }}</span>
        </div>
        <ul class="m6-suggestion-section__list">
          {% for item in section['items'] | default([]) %}
          <li class="m6-suggestion-section__item">{{ item }}</li>
          {% else %}
          <li class="m6-suggestion-section__item m6-empty-text">暂无具体建议</li>
          {% endfor %}
        </ul>
      </div>
      {% else %}
      {# 无建议时的占位 #}
      <div class="m6-suggestion-section">
        <p class="m6-empty-text">数据不足，请完成更多练习后再次生成报告。</p>
      </div>
      {% endfor %}
    </div>

  </section>

  {# ==========================================================================
     卡片3:给家长的配合建议 (Parent Guidance Card) - NEW
     ========================================================================== #}
  <section class="m6-role-panel m6-role-panel--parent">

    {# 卡片标题 #}
    <div class="m6-card-header m6-card-header--with-icon">
      <span class="m6-bullet m6-bullet--{{ parent_card.bullet_color | default('orange', true) }}"></span>
      {{ role_icon(parent_card.icon | default('parent')) }}
      <h2 class="m6-card-header__title">
        2、{{ parent_card.title | default('给家长的配合建议', true) }}
      </h2>
    </div>

    {# 总体建议摘要 #}
    {% if parent_card.summary %}
    <div class="m6-summary-box m6-summary-box--parent">
      <p class="m6-summary-box__text">{{ parent_card.summary }}</p>
    </div>
    {% endif %}

    {# 行动清单 #}
    {% if parent_card.checklist | default([]) | length > 0 %}
    <div class="m6-checklist m6-checklist--parent">
      {% for item in parent_card.checklist %}
      <div class="m6-check-item">
        <span class="m6-check-icon">{{ check_svg('orange') }}</span>
        <span class="m6-check-item__text">{{ item | default('--', true) }}</span>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="m6-checklist">
      <p class="m6-empty-text">暂无具体行动建议。</p>
    </div>
    {% endif %}

  </section>

  {# ==========================================================================
     卡片4:给老师的教学建议 (Teacher Guidance Card)
     ========================================================================== #}
  <section class="m6-role-panel m6-role-panel--teacher">

    {# 卡片标题 #}
    <div class="m6-card-header m6-card-header--with-icon">
      <span class="m6-bullet m6-bullet--{{ teacher_card.bullet_color | default('red', true) }}"></span>
      {{ role_icon(teacher_card.icon | default('teacher')) }}
      <h2 class="m6-card-header__title">
        3、{{ teacher_card.title | default('给老师的教学建议', true) }}
      </h2>
    </div>

    {# 总体建议摘要 #}
    {% if teacher_card.summary %}
    <div class="m6-summary-box m6-summary-box--teacher">
      <p class="m6-summary-box__text">{{ teacher_card.summary }}</p>
    </div>
    {% endif %}

    {# 段落内容(支持红色强调) #}
    {% if teacher_card.paragraph_parts | default([]) | length > 0 %}
    <p class="m6-guidance-paragraph">
      {% for part in teacher_card.paragraph_parts %}
        {% if part is mapping and part.em %}
          <span class="m6-em-red">{{ part.em }}</span>
        {% elif part is string %}
          {{ part }}
        {% endif %}
      {% endfor %}
    </p>
    {% endif %}

    {# 教学关注点清单 #}
    {% if teacher_card.checklist | default([]) | length > 0 %}
    <div class="m6-checklist m6-checklist--teacher">
      {% for item in teacher_card.checklist %}
      <div class="m6-check-item">
        <span class="m6-check-icon">{{ check_svg('red') }}</span>
        <span class="m6-check-item__text">{{ item | default('--', true) }}</span>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="m6-checklist">
      <p class="m6-empty-text">暂无具体教学建议。</p>
    </div>
    {% endif %}

  </section>
  </div><!-- /.m6-role-stack -->
  </section><!-- /.m6-recommendation-module -->

  </div><!-- /.module-content-card -->

</div>
