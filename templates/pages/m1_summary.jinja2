    "target_accuracy": 75,
    "target_accuracy_text": "正确率 ≥ 75%",
    "current_accuracy": 77,
    "current_accuracy_text": "77%",
    "current_delta": 2,
    "current_delta_text": "+2.0%",
    "current_trend": "up",
    "pass_rate": 66.7,
    "pass_rate_text": "66.7%",
    "pass_segments": [
      {"name": "未达标", "value": 6, "display_text": "6题", "color_hex": "#E0F3F7", "icon": "minus"},
      {"name": "已达标", "value": 12, "display_text": "12题", "color_hex": "#23ACCC", "icon": "check"}
    ]
  },
  "key_findings": [
    "代数与函数板块稳定，基础题正确率较高，可冲刺更高分段。",
    "几何板块薄弱，三角形与圆是拉分关键，需重点突破。",
    "应用题与统计题需加强审题与建模，避免低级失分。"
  ],
  "breakthrough": {
    "title": "优先突破项（P0级）",
    "target_line_pct": 75,
    "target_line_text": "目标线75%",
    "items": [
      {
        "name_cn": "相似三角形",
        "priority_level": "P0",
        "accuracy": 58,
        "accuracy_text": "58%",
        "gap_to_target": -17,
        "gap_to_target_text": "距目标线 -17%",
        "city_tag_left": "城市top1",
        "city_tag_right": "每年必考"
      }
    ]
  },
