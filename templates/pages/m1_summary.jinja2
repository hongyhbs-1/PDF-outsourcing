    "pass_rate": 66.7,
    "pass_rate_text": "66.7%",
    "pass_segments": [
      {"name": "未达标", "value": 6, "display_text": "6题", "color_hex": "#E0F3F7", "icon": "minus"},
      {"name": "已达标", "value": 12, "display_text": "12题", "color_hex": "#23ACCC", "icon": "check"}
    ]
  },
