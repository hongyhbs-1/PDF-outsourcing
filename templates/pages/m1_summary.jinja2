    "text": "建议：优先攻克以上2个短板，配合针对性训练提升得分稳定性。"
  }
}
--------------------------------------------------------------------------------
#}

{# ============================================================================
   兼容层：支持两种传参方式
   方式1: template.render(**render_payload.module_1_summary)  -- 顶层变量直传
   方式2: template.render(module_1_summary=...)              -- 包一层传入
   ============================================================================ #}

{% from 'macros/learning_blueprint_icons.jinja2' import lb_icon %}
{% set _data = module_1_summary | default({}) %}
{% set meta = _data.meta | default(meta | default({})) %}
{% set summary = _data.summary | default(summary | default({})) %}
{% set key_findings = _data.key_findings | default(key_findings | default([])) %}
{% set breakthrough = _data.breakthrough | default(breakthrough | default({})) %}
{% set suggestion = _data.suggestion | default(suggestion | default({})) %}
{% set bt_items = breakthrough['items'] | default([]) %}
{% set pass_stats = namespace(total=0, achieved=0, pending=0) %}
{% for seg in summary.pass_segments | default([]) %}
  {% set seg_value = seg.value | default(0) | int %}
  {% set pass_stats.total = pass_stats.total + seg_value %}
  {% if '未' in (seg.name | default('')) or seg.icon | default('') == 'minus' %}
    {% set pass_stats.pending = pass_stats.pending + seg_value %}
  {% else %}
    {% set pass_stats.achieved = pass_stats.achieved + seg_value %}
  {% endif %}
{% endfor %}
{% if bt_items | length >= 6 %}
  {% set m1_density = 'dense' %}
{% else %}
  {% set m1_density = 'standard' %}
{% endif %}


{# ============================================================================
   宏定义区域 (Macros)
   ============================================================================ #}

{#- 空值安全输出宏 -#}
{% macro safe(value, default='--') -%}
  {{ value if value is defined and value is not none and value != '' else default }}
{%- endmacro %}

{#- 数值安全输出宏（保证返回数值用于计算） -#}
{% macro safe_num(value, default=0) -%}
  {{ value if value is defined and value is not none else default }}
{%- endmacro %}

{#- 百分比安全输出宏 -#}
{% macro safe_pct(value, default='0%') -%}
  {{ value if value is defined and value is not none and value != '' else default }}
{%- endmacro %}

{#- 趋势箭头宏 -#}
{% macro trend_arrow(trend) -%}
  {% if trend == 'up' %}
    <span class="m1-kpi-arrow m1-kpi-arrow--up">↑</span>
  {% elif trend == 'down' %}
    <span class="m1-kpi-arrow m1-kpi-arrow--down">↓</span>
  {% elif trend == 'stable' %}
    <span class="m1-kpi-arrow m1-kpi-arrow--stable">→</span>
  {% endif %}
{%- endmacro %}

{#- 获取状态类宏（基于数值比较，要求传入 number 类型） -#}
{% macro get_status_class(accuracy, target) -%}
  {% if accuracy is not defined or accuracy is none %}
    m1-status--nodata
  {% elif accuracy >= target %}
    m1-status--achieved
  {% elif accuracy >= target - 10 %}
    m1-status--attention
  {% else %}
    m1-status--improve
  {% endif %}
{%- endmacro %}

{#- 圆环图SVG宏（pass_rate 必须为 number 0-100） -#}
{% macro donut_chart(pass_rate, size=158, stroke_width=24) %}
  {#
    CSS uses a 24px donut stroke. Leave inner viewBox padding so Chromium PDF
    does not clip the outer stroke at the four cardinal edges.
  #}
  {% set donut_viewbox_padding = 3 %}
  {% set radius = (size - stroke_width) / 2 - donut_viewbox_padding %}
  {% set circumference = 2 * 3.14159 * radius %}
  {% set safe_rate = pass_rate if pass_rate is defined and pass_rate is not none else 0 %}
  {% set dash_length = (safe_rate / 100) * circumference %}
  {% set dash_gap = circumference - dash_length %}
  
  <div class="m1-donut-container" style="width: {{ size }}px; height: {{ size }}px;">
    <svg class="m1-donut-svg" viewBox="0 0 {{ size }} {{ size }}">
      {# 背景轨道 #}
      <circle 
        class="m1-donut-track"
        cx="{{ size / 2 }}"
        cy="{{ size / 2 }}"
        r="{{ radius }}"
      />
      {# 进度弧 #}
      <circle 
        class="m1-donut-progress"
        cx="{{ size / 2 }}"
        cy="{{ size / 2 }}"
        r="{{ radius }}"
        stroke-dasharray="{{ dash_length }} {{ dash_gap }}"
      />
    </svg>
    <div class="m1-donut-center">{{ safe_rate | round(1) }}%</div>
  </div>
{% endmacro %}


{# ============================================================================
   HTML 主体结构
   ============================================================================ #}

<div class="m1-report-page{% if m1_density == 'dense' %} m1-report-page--dense{% endif %}">
  
  {# --------------------------------------------------------------------------
     章节标题 (Section Title)
     -------------------------------------------------------------------------- #}
  <section class="m1-section-title">
    <h1 class="m1-section-title__text">{{ lb_icon('data', 'frame-title-icon') }}一、诊断摘要</h1>
    <div class="m1-section-title__underline"></div>
  </section>

  <section class="m1-core-conclusion">
    <div class="m1-core-conclusion__label">{{ lb_icon('target', 'frame-conclusion-icon') }}本页核心结论</div>
    <div class="m1-core-conclusion__text">
      三级知识点（L3）达标率 {{ safe_pct(summary.pass_rate_text, '0%') }}（= 达标的知识点/总知识点）：{% if pass_stats.total > 0 %}在已分析的{{ pass_stats.total }}个知识点中，{{ pass_stats.achieved }}个已达到{{ safe(summary.target_accuracy_text, '目标线') }}，{{ pass_stats.pending }}个需重点补齐；{% endif %}优先补齐当前未达标知识点，比平均用力更容易缩小目标差距。
    </div>
  </section>

  <div class="module-content-card">

  {# --------------------------------------------------------------------------
     整体学情总结（原摘要主卡片 + 原关键发现合并）
     -------------------------------------------------------------------------- #}
  <div class="m1-section-bar">{{ lb_icon('gauge', 'frame-section-icon') }} 一、整体学情总结</div>

  <div class="m1-summary-card">

    {# 摘要内容区 #}
    <div class="m1-summary-content">
      
      {# 左侧: 圆环图 + 说明 + 图例 #}
      <div class="m1-summary-left">
        {# 圆环图 - pass_rate 必须为 number #}
        {% if summary.pass_rate is defined and summary.pass_rate is not none %}
          {{ donut_chart(summary.pass_rate) }}
        {% else %}
          <div class="m1-data-unavailable">达标率数据暂无</div>
        {% endif %}

        {# 圆环图说明 #}
        <div class="m1-donut-caption">三级知识点（L3）达标率（= 达标的知识点/总知识点）</div>

        {# 图例 #}
        {% if summary.pass_segments is defined and summary.pass_segments %}
          <div class="m1-donut-legend">
            {% for seg in summary.pass_segments %}
              <div class="m1-legend-item">
                <div class="m1-legend-icon {% if seg.icon == 'check' %}m1-legend-icon--pass{% else %}m1-legend-icon--fail{% endif %}"
                     {% if seg.color_hex is defined %}style="background: {{ seg.color_hex }};"{% endif %}>
                  {% if seg.icon == 'check' %}✓{% else %}—{% endif %}
                </div>
                <span class="m1-legend-text">
                  {{ safe_num(seg.value, 0) }}个知识点
                </span>
              </div>
            {% endfor %}
          </div>
        {% else %}
          {# 默认图例 #}
          <div class="m1-donut-legend">
            <div class="m1-legend-item">
              <div class="m1-legend-icon m1-legend-icon--fail">—</div>
              <span class="m1-legend-text">未达标</span>
            </div>
            <div class="m1-legend-item">
              <div class="m1-legend-icon m1-legend-icon--pass">✓</div>
              <span class="m1-legend-text">已达标</span>
            </div>
          </div>
        {% endif %}
      </div>

      {# 右侧: 目标与当前表现（分数目标 / 达标线 / 当前表现） #}
      {% set _current_acc_raw = summary.current_accuracy if summary.current_accuracy is defined and summary.current_accuracy is not none and summary.current_accuracy != '' else none %}
      {% set _target_acc_raw = summary.target_accuracy if summary.target_accuracy is defined and summary.target_accuracy is not none and summary.target_accuracy != '' else none %}
      {% set _current_acc = _current_acc_raw | float if _current_acc_raw is not none else none %}
      {% set _target_acc = _target_acc_raw | float if _target_acc_raw is not none else none %}
      {% set _has_goal_gap = _current_acc is not none and _target_acc is not none %}
      {% set _delta_num = (summary.current_delta | float) if summary.current_delta is defined and summary.current_delta is not none and summary.current_delta != '' else ((_current_acc - _target_acc) if _has_goal_gap else none) %}
      {% set _delta_text_clean = safe(summary.current_delta_text, ((_delta_num | round(0) | int) ~ '%') if _delta_num is not none else '--') | replace('-', '') | replace('+', '') %}
      <div class="m1-summary-right">
        <div class="m1-goal-metrics">
          <div class="m1-goal-metric-card m1-goal-metric-card--score">
            <div class="m1-goal-metric-label">{{ lb_icon('target', 'frame-metric-icon') }}<span>目标分数</span></div>
            <div class="m1-goal-metric-value">{{ safe(summary.target_score_text, '--') }}</div>
            <div class="m1-goal-metric-desc">最终分数目标</div>
          </div>

          <div class="m1-goal-metric-card m1-goal-metric-card--line">
            <div class="m1-goal-metric-label">{{ lb_icon('flag', 'frame-metric-icon') }}<span>目标线</span></div>
            <div class="m1-goal-metric-value">{{ safe(summary.target_accuracy_text, '--') }}</div>
            <div class="m1-goal-metric-desc">答题正确率达标线</div>
          </div>

          <div class="m1-goal-metric-card m1-goal-metric-card--current {{ get_status_class(_current_acc, _target_acc if _target_acc is not none else 0) }}">
            <div class="m1-goal-metric-label">{{ lb_icon('gauge', 'frame-metric-icon') }}<span>当前答题正确率</span></div>
            <div class="m1-goal-metric-current">
              <span class="m1-goal-metric-value">{{ safe(summary.current_accuracy_text, '--') }}</span>
              {% if _has_goal_gap and _delta_num is not none %}
                {% if _delta_num < 0 %}
                  <span class="m1-goal-metric-gap m1-goal-metric-gap--below">低于目标线 {{ _delta_text_clean }}</span>
                {% elif _delta_num > 0 %}
                  <span class="m1-goal-metric-gap m1-goal-metric-gap--above">高于目标线 {{ _delta_text_clean }}</span>
                {% else %}
                  <span class="m1-goal-metric-gap m1-goal-metric-gap--on">已达目标线</span>
                {% endif %}
              {% endif %}
              {% if _current_acc is not none and summary.current_trend is defined and summary.current_trend %}
                {{ trend_arrow(summary.current_trend) }}
              {% endif %}
            </div>
            <div class="m1-goal-metric-desc">当前答题表现，作为后续提分起点</div>
          </div>
        </div>
      </div>
    </div>

    {# 关键发现（并入整体学情总结） #}
    {% if key_findings is defined and key_findings and key_findings|length > 0 %}
    <div class="m1-findings-inline">
      {% for finding in key_findings %}
      <div class="m1-finding-item">
        <span class="m1-bullet-square"></span>
        <span>{{ safe(finding, '暂无发现') }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {# 摘要说明放在本卡片底部，避免与“本页核心结论”重复挤在顶部 #}
    <div class="m1-summary-banner">
      整体正确率看所有答题表现；三级知识点（L3）达标率看细分知识点是否达标。{{ safe_pct(summary.pass_rate_text, '0%') }}表示三级知识点（L3）达标率（= 达标的知识点/总知识点）：{% if pass_stats.total > 0 %}已分析的{{ pass_stats.total }}个知识点中，{{ pass_stats.achieved }}个达标、{{ pass_stats.pending }}个需重点补齐。{% endif %}达标指正确率达到或超过本次设定的{{ safe(summary.target_accuracy_text, '目标线') }}。
    </div>
  </div>

  {% if summary.high_freq_kp_total is defined and summary.pass_segments is defined and summary.pass_segments | length >= 2 %}
  <p class="m1-chart-note">
    上传试卷包含L3级知识点{{ summary.high_freq_kp_total }}个，其中{{ summary.pass_segments[0].value }}个超过目标正确率，{{ summary.pass_segments[1].value }}个暂时未达到
  </p>
  {% endif %}

  {# 关键发现已合并到整体学情总结中 #}

  {# --------------------------------------------------------------------------
     优先突破项 (Breakthrough P0)
     
     ⚠️ P0修复：使用 ['items'] 取值，避免与 dict.items() 方法冲突
     -------------------------------------------------------------------------- #}
  <div class="m1-section-bar m1-section-bar--subtle">
    {{ lb_icon('target', 'frame-section-icon') }} 二、优先突破
  </div>
  
  {% if bt_items | length > 0 %}
    <div class="m1-breakthrough-grid">
      {% for item in bt_items %}
        <div class="m1-breakthrough-card">
          {# 知识点名称 #}
          <div class="m1-bt-title">{{ lb_icon('target', 'frame-inline-icon') }} {{ safe(item.name_cn, '未知知识点') }}</div>
          
          {# 单层进度条：同时标注“当前/目标”，避免用负数表达提升空间 #}
          {% set target_pct = item.target_line_pct | default(breakthrough.target_line_pct | default(75), true) | float %}
          {% set target_pct_clamped = ([100, [0, target_pct] | max] | min) | round(1) %}
          {% set current_pct = item.accuracy | default(0, true) | float %}
          {% set current_pct_clamped = ([100, [0, current_pct] | max] | min) | round(1) %}
          {% set current_pct_display = (current_pct_clamped | round(0) | int) if current_pct_clamped == (current_pct_clamped | round(0)) else current_pct_clamped %}
          {% set target_pct_display = (target_pct_clamped | round(0) | int) if target_pct_clamped == (target_pct_clamped | round(0)) else target_pct_clamped %}
          {% set gap_to_target_pct = target_pct_clamped - current_pct_clamped %}
          {% set gap_abs_pct = (gap_to_target_pct if gap_to_target_pct >= 0 else -gap_to_target_pct) | round(1) %}
          {% set gap_display = (gap_abs_pct | round(0) | int) if gap_abs_pct == (gap_abs_pct | round(0)) else gap_abs_pct %}
          {% set current_label_anchor = 'right' if current_pct_clamped >= 92 else ('left' if current_pct_clamped <= 8 else 'center') %}
          {% set target_label_anchor = 'right' if target_pct_clamped >= 92 else ('left' if target_pct_clamped <= 8 else 'center') %}
          {% set priority = item.priority_level | default('P0') %}
          <div class="m1-breakthrough-progress" style="--m1-bt-current: {{ current_pct_clamped }}%; --m1-bt-target: {{ target_pct_clamped }}%;">
            <div class="m1-bt-progress-track" aria-label="当前 {{ current_pct_display }}%，目标 {{ target_pct_display }}%">
              <div class="m1-bt-progress-fill
                {% if priority == 'P0' %}m1-bt-progress-fill--p0
                {% elif priority == 'P1' %}m1-bt-progress-fill--p1
                {% else %}m1-bt-progress-fill--p2
                {% endif %}"></div>
              <div class="m1-bt-progress-marker m1-bt-progress-marker--current" title="当前 {{ current_pct_display }}%"></div>
              <div class="m1-bt-progress-marker m1-bt-progress-marker--target" title="目标 {{ target_pct_display }}%"></div>
              <span class="m1-bt-progress-label m1-bt-progress-label--target m1-bt-progress-label--{{ target_label_anchor }}">目标 {{ target_pct_display }}%</span>
              <span class="m1-bt-progress-label m1-bt-progress-label--current m1-bt-progress-label--{{ current_label_anchor }}">当前 {{ current_pct_display }}%</span>
            </div>
          </div>

          {# 标签组：用正向表述讲清还需提升多少，再补充城市考频参考 #}
          <div class="m1-bt-tags">
            <span class="m1-bt-tag m1-bt-tag--improve">{% if gap_to_target_pct > 0 %}还需提升 {{ gap_display }}%{% elif gap_to_target_pct < 0 %}已超目标 {{ gap_display }}%{% else %}已达目标{% endif %}</span>
            {% if item.city_tag_left is defined and item.city_tag_left %}
              <span class="m1-bt-tag m1-bt-tag--evidence">城市考频参考：{{ item.city_tag_left | replace('TOP', '前') | replace('Top', '前') | replace('top', '前') }}{% if item.city_tag_right is defined and item.city_tag_right %} · {{ item.city_tag_right }}{% endif %}</span>
            {% elif item.city_tag_right is defined and item.city_tag_right %}
              <span class="m1-bt-tag m1-bt-tag--evidence">{{ item.city_tag_right }}</span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="m1-data-unavailable" style="margin: 0 var(--page-padding-x);">
      暂无突破项数据
    </div>
  {% endif %}

  {# --------------------------------------------------------------------------
     建议提示条 (Suggestion Callout)
     -------------------------------------------------------------------------- #}
  {% if suggestion.text is defined and suggestion.text %}
    <div class="m1-suggestion-callout">
      {{ lb_icon('support', 'frame-inline-icon') }} {{ suggestion.text }}
    </div>
  {% endif %}

  </div><!-- /.module-content-card -->

</div>

{# ============================================================================
   END OF TEMPLATE
   ============================================================================ #}
